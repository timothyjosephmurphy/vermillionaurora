// DRAFT for studio-tracker #311. Not used by any deploy: the file name is deliberately not wrangler.jsonc.
// Every value marked REPLACE_ME is a placeholder. Nothing here has been created in Cloudflare.
// To go live (TJ's call, later): create the D1 database and R2 bucket, put the real ids below, rename to wrangler.jsonc,
// run `wrangler d1 migrations apply`, and set the secret with `wrangler secret put BOOTH_ADMIN_PASSWORD`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tjm-photo-booth",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "REPLACE_ME_booth_db", "database_id": "REPLACE_ME_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "REPLACE_ME_booth_photos" }],
  // Expiry sweep, hourly. Reads already hide expired photos; the sweep deletes the R2 object.
  "triggers": { "crons": ["17 * * * *"] }
  // Routes are intentionally not set. Planned: tjm.art/booth/* (TODO: TJ to confirm the host).
  // Secret (not in this file): BOOTH_ADMIN_PASSWORD.
}
