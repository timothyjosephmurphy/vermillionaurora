# studio-tracker #240: the /play gallery frames run inside the /play shell, which already carries Cloudflare Web Analytics.
# no-transform stops Cloudflare auto-injecting a second beacon into the frame, so each visit counts once.
/play/g/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# studio-tracker #802. Safe on error responses (no positive cache lifetime).
# SAMEORIGIN and frame-ancestors 'self' keep /play/ → /play/g/* iframes.
# camera=(self), microphone=(self) keep Neural Dance camera and mic working.
# CSP is report-only so a missed host cannot break checkout, play, or Neural Dance.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
