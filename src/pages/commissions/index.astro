---
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProductCard from '../../components/ProductCard.astro';
import CommissionProcess from '../../components/CommissionProcess.astro';
import { byId } from '../../../catalog/catalog.mjs';
import collections from '../../../catalog/collections.json';
import { testimonials } from '../../data/testimonials.mjs';

const packages = collections.home
  .filter(entry => entry.variant === 'service')
  .map(entry => byId[entry.product])
  .filter(Boolean);
import { person, ld } from '../../data/structured-data.mjs';
// Section anchors; the old package pages 301 here (static/_redirects).
const anchors = { 'small-landscape': 'landscape', 'single-portrait': 'portrait' };
const headings = { 'small-landscape': 'Landscape commissions', 'single-portrait': 'Portrait commissions · 1–4 faces' };
const order = ['small-landscape', 'single-portrait'];
// More commissions (studio-tracker #105, TJ Oct 18 2026): pet portraits cost the same as people portraits, Bitcoin art is
// priced like a one-face portrait at each size, murals are $50 per square foot. Prices come from the portrait package.
const portraitOptions = byId['single-portrait']?.options || [];
const petOptions = portraitOptions.map(o => ({ id: `pet-portrait-${o.id}`, label: `Pet portrait ${o.label.replace(/(\d+) faces?/, (_, n) => `${n} ${n === '1' ? 'pet' : 'pets'}`)}`, size: o.size, amount: o.amount }));
const bitcoinOptions = portraitOptions.filter(o => /^1 face/.test(o.label)).map(o => ({ id: `bitcoin-art-${o.id.replace(/-1f$/, '')}`, label: `Bitcoin art ${o.size}`, size: o.size, amount: o.amount }));
const fromPrice = list => Math.min(...list.map(o => Number(o.amount))).toLocaleString('en-US');
const MURAL_RATE = 50;
packages.sort((a, b) => (order.indexOf(a.slug) + 1 || 99) - (order.indexOf(b.slug) + 1 || 99));
const service = { '@context':'https://schema.org', '@type':'Service', name:'Watercolor portrait and landscape commissions', serviceType:'Commissioned watercolor pastel artwork',
  provider:{ '@type':'Person', '@id':person['@id'], name:person.name }, areaServed:'Worldwide', url:'https://tjm.art/commissions/',
  offers: packages.flatMap(p => (p.options?.length ? p.options : [{label:'', amount:p.listing?.price?.amount}]).filter(o=>o.amount).map(o => ({ '@type':'Offer', name:`${p.title}${o.label?` — ${o.label}`:''}`, price:o.amount, priceCurrency:'USD' }))) };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script type="application/ld+json" set:html={ld(service)} />
  <title>Watercolor Portrait &amp; Landscape Commissions | Seattle Watercolor Artist TJ Murphy</title>
  <meta name="description" content={`Commission a watercolor portrait or landscape by Seattle artist TJ Murphy. Portraits from $${fromPrice(portraitOptions)}, landscapes from $${fromPrice(byId['small-landscape']?.options || [])}, 50% deposit to start, typical turnaround 2–4 weeks.`} />
  <link rel="canonical" href="https://tjm.art/commissions/" />
  <link href="/fonts/fonts.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/site-header.css" />
  <link rel="stylesheet" href="/portrait-preview.css" />
  <style is:global>
    .commission-package{scroll-margin-top:110px}
    .more-commission-price{font-weight:600;margin:12px 0}
    .commission-package-heading{font:600 1.5rem/1.2 "Cormorant Garamond",serif;margin:0 0 12px}
    .service-grid.commission-packages{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;max-width:960px;margin-inline:auto}
    @media(max-width:760px){.service-grid.commission-packages{grid-template-columns:1fr}}
    /* Compact, even rhythm for this page only (the shared .section is 110px/80px). */
    main.commissions-hub .section{padding:56px 0}
    main.commissions-hub .commissions-intro{padding:1.25rem 0 1.5rem}
    main.commissions-hub .section-heading{margin-bottom:1.5rem}
    main.commissions-hub .section-heading p{margin-bottom:0}
    main.commissions-hub .section-heading h2{margin:0 0 .5rem}
    main.commissions-hub .service-grid{gap:24px}
    main.commissions-hub .service-card{padding:1.5rem 1.35rem}
    main.commissions-hub .service-card h3{margin-bottom:.5rem}
    main.commissions-hub .service-card p{margin-bottom:.9rem}
    main.commissions-hub .service-terms{margin:.5rem 0 .75rem}
    main.commissions-hub .commission-process{margin:0;padding:0;border:0}
    main.commissions-hub .commission-process .process-intro{margin-bottom:1.25rem}
    main.commissions-hub .process-steps{gap:1.1rem}
    main.commissions-hub .commission-process .process-conversation{margin-top:1.25rem}
    main.commissions-hub .process-more{margin-top:1rem}
    main.commissions-hub .faq-list{gap:.6rem}
    main.commissions-hub .commission-testimonials-link{margin:1rem 0 0}
    main.commissions-hub .contact-copy h2{margin:0 0 .75rem}
    main.commissions-hub .contact-list{margin-top:1.25rem;gap:.6rem}
    main.commissions-hub .contact-email{display:inline-flex;align-items:center;gap:.4em;max-width:100%;overflow-wrap:anywhere}
    main.commissions-hub .contact-email-icon{flex:none;width:1em;height:1em}
    main.commissions-hub .contact-form{gap:.95rem}
    .commission-steps{margin:.4rem 0 0;padding-left:1.3rem;line-height:1.6}.commission-steps li{margin:.25rem 0}.form-reply-note{margin:0;font-size:.92rem}
    main.commissions-hub .commissions-terms-banner{margin:1rem 0 1.25rem}
    @media(max-width:760px){
      main.commissions-hub .section{padding:36px 0}
      main.commissions-hub .commissions-intro{padding:1rem 0 1.25rem}
      main.commissions-hub .section-heading{margin-bottom:1.1rem}
      main.commissions-hub .service-grid{gap:18px}
      main.commissions-hub .contact-grid{gap:24px}
      main.commissions-hub .service-card{padding:1.25rem 1rem}
    }
  </style>
</head>
<body>
  <div class="page-shell">
    <SiteHeader />
    <main id="main-content" class="commissions-hub">
      <section class="section section-light commissions-intro">
        <div class="container">
          <p class="eyebrow dark">Commissions</p>
          <h1>Let’s make something for you</h1>
          <p class="lede">A portrait of someone you love, a landscape that holds a memory, or a mural for a shared space. Choose a package below, or tell me what you have in mind—we’ll shape the details together.</p>
          <p class="commissions-terms-banner"><strong>50% deposit</strong> to start · Typical turnaround <strong>2–4 weeks</strong></p>
          <div class="hero-actions">
            <a class="button button-solid" href="#form">Start a commission</a>
            <a class="button button-ghost" href="/commissions/process/">How I create your painting</a>
          </div>
        </div>
      </section>

      <section id="packages" class="section section-contrast" aria-labelledby="packages-heading">
        <div class="container">
          <div class="section-heading narrow">
            <h2 id="packages-heading">Packages</h2>
            <p>Starting points for watercolor commissions. Each includes conversation about reference photos, size, and finish.</p>
          </div>
          <div class="service-grid commission-packages">
            {packages.map(product => <div id={anchors[product.slug] || product.slug} class="commission-package">
              <h3 class="commission-package-heading">{headings[product.slug] || product.title}</h3>
              <ProductCard product={product} variant="service" />
            </div>)}
          </div>
        </div>
      </section>

      <section id="more-commissions" class="section section-light" aria-labelledby="more-commissions-heading">
        <div class="container">
          <div class="section-heading narrow">
            <h2 id="more-commissions-heading">Pets, Bitcoin art and murals</h2>
          </div>
          <div class="service-grid commission-packages more-commissions">
            <div id="pet-portrait" class="commission-package">
              <h3 class="commission-package-heading">Pet Portraits</h3>
              <p>I'll paint your dog, cat, or any animal you love from your photos. They're priced the same as my people portraits.</p>
              <p class="more-commission-price">From ${fromPrice(petOptions)} · Same prices as portraits</p>
              <a class="button button-solid" href="?package=pet-portrait#form">Start a pet portrait</a>
            </div>
            <div id="bitcoin-art" class="commission-package">
              <h3 class="commission-package-heading">Bitcoin Art</h3>
              <p>Original paintings about Bitcoin and what it stands for, from a moment in its history to an idea you care about. Tell me what it means to you and I'll paint it.</p>
              <p class="more-commission-price">From ${fromPrice(bitcoinOptions)} · Priced like portraits</p>
              <a class="button button-solid" href="?package=bitcoin-art#form">Start a Bitcoin painting</a>
            </div>
            <div id="mural" class="commission-package">
              <h3 class="commission-package-heading">Murals</h3>
              <p>I paint murals for homes, businesses, and public walls. Send me the wall size and location, and I'll put together a design and quote.</p>
              <p class="more-commission-price">${MURAL_RATE} per square foot</p>
              <a class="button button-solid" href="?package=mural#form">Ask about a mural</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-light">
        <div class="container process-embed">
          <CommissionProcess />
          <p class="process-more"><a href="/commissions/process/">Read the full process →</a></p>
        </div>
      </section>

      <section id="faq" class="section section-plain" aria-labelledby="faq-heading">
        <div class="container faq-wrap">
          <div class="section-heading narrow">
            <h2 id="faq-heading">Commission FAQ</h2>
          </div>
          <div class="faq-list">
            <details open>
              <summary>How do deposits and payment work?</summary>
              <p>A <strong>50% deposit</strong> starts the commission. The balance is due when the painting is finished, before shipping or pickup.</p>
              <p>Pay with Bitcoin / Lightning (BTCPay) or card.</p>
            </details>
            <details>
              <summary>How long does a commission take?</summary>
              <p>Typical turnaround is <strong>2–4 weeks</strong> from when we agree on the approach and the deposit is received. Timing can vary with size, complexity, and my current schedule—I’ll share a clear estimate when we discuss your project.</p>
            </details>
            <details>
              <summary>What reference photos work best?</summary>
              <p>Clear, well-lit photos help most. For portraits, a sharp face and natural expression matter more than a perfect studio shot. For landscapes, share the mood and place you want to hold. You can upload images with the form or send them later by email.</p>
            </details>
            <details>
              <summary>Can I choose a loose or more rendered finish?</summary>
              <p>Yes. My watercolor process can stay open and textured or move closer to the reference. Tell me which direction you’re drawn to when we talk—details are on the <a href="/commissions/process/">process page</a>.</p>
            </details>
            <details>
              <summary>Do you offer revisions?</summary>
              <p>We’ll agree on the composition and approach before painting begins. If something needs a small adjustment while the work is in progress, say so early—watercolor is layered and timing matters. Major redesigns after substantial work may need a new conversation about scope.</p>
            </details>
            <details>
              <summary>How is shipping handled?</summary>
              <p>Finished works ship carefully packaged from Seattle. Checkout ships within the US and internationally. International orders are charged in USD and ship duties unpaid: import duties and taxes are paid by you on delivery. If checkout can’t quote your destination, use Request a quote (Bitcoin welcome) on the painting’s page. I reply within 2 business days with a price in US dollars. Local pickup can be arranged. See <a href="/shipping-returns/">shipping &amp; returns</a> for general guidance.</p>
            </details>
            <details>
              <summary>What about murals or custom sizes?</summary>
              <p>Murals are ${MURAL_RATE} per square foot. Send me the wall size and location with the form and I'll put together a design and quote. For larger formats or something outside these sizes, describe the idea and we'll price and schedule it separately.</p>
            </details>
          </div>
          {/* Shown only once at least one testimonial exists: hand-curated ones at build time, approved form submissions
             at request time (filled in by the script below, so the empty page is never promoted in the HTML). */}
          {testimonials.length > 0
            ? <p class="commission-testimonials-link">See what collectors say on the <a href="/testimonials/">testimonials page</a>.</p>
            : <p class="commission-testimonials-link" data-testimonials-cta hidden></p>}
          {testimonials.length === 0 && <script is:inline>fetch('/testimonials/api/approved',{cache:'no-cache',headers:{Accept:'application/json'}}).then(r=>r.ok?r.json():null).then(d=>{if(!d||!Array.isArray(d.testimonials)||!d.testimonials.length)return;const p=document.querySelector('[data-testimonials-cta]');if(!p)return;const a=document.createElement('a');a.href='/testimonials/';a.textContent='testimonials page';p.append('See what collectors say on the ',a,'.');p.hidden=false;}).catch(()=>{});</script>}
        </div>
      </section>

      <section id="form" class="section section-contact" aria-labelledby="form-heading">
        <div class="container contact-grid">
          <div class="contact-copy">
            <p class="eyebrow dark"><span data-commission-pitch>Request a commission</span><span data-quote-pitch hidden>Shipping quote</span></p>
            <h2 id="form-heading">Tell me about your idea</h2>
            <p data-commission-pitch>Share a few details and optional reference images. This is an inquiry—no payment until we agree on the approach.</p>
            <p data-quote-pitch hidden>Checkout already ships in the US and internationally, in US dollars. You pay import duties on delivery. If checkout can’t reach your country, or you’d like to pay with Bitcoin before I ship, send the details below. This is a quote — no payment until we agree.</p>
            <ul class="contact-list">
              <li>Seattle, WA</li>
              <li><a class="contact-email" href="mailto:tj@tjm.art"><svg class="contact-email-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3.5 7 8.5 6.5L20.5 7"></path></svg><span>tj@tjm.art</span></a></li>
              <li data-commission-pitch>50% deposit to start</li>
              <li data-commission-pitch>Typical turnaround 2–4 weeks</li>
              <li data-quote-pitch hidden>Pay with Bitcoin / Lightning (BTCPay) or card</li>
              <li>I reply within 2 business days</li>
            </ul>
            <h3 id="commission-steps" data-commission-pitch>From inquiry to delivery</h3>
            <ol class="commission-steps" data-commission-pitch>
              <li>Send me your idea and any reference photos with this form.</li>
              <li>I reply within 2 business days with questions and a price.</li>
              <li>Once we agree on the approach, you pay a 50% deposit to start.</li>
              <li>I paint it, usually in 2–4 weeks.</li>
              <li>When it’s finished, you pay the balance.</li>
              <li>I ship it from Seattle, or you pick it up locally.</li>
            </ol>
            <h3 data-quote-pitch hidden>How a shipping quote works</h3>
            <ol class="commission-steps" data-quote-pitch hidden>
              <li>Tell me your country, city, and whether you want the original, a print, or both.</li>
              <li>I reply within 2 business days with a price in US dollars, including shipping.</li>
              <li>You pay with Bitcoin / Lightning or card.</li>
              <li>I ship from Seattle, or the print lab ships the print. You pay import duties on delivery.</li>
            </ol>
          </div>

          <form class="contact-form" action="/api/commission" method="POST">
            <div class="purchase-summary" hidden="">
              <p class="eyebrow dark">Purchase inquiry</p>
              <h3 class="purchase-title"></h3>
              <p class="purchase-price"></p>
            </div>
            <div class="package-summary" hidden="">
              <p class="eyebrow dark">Selected package</p>
              <h3 class="package-title"></h3>
              <p class="package-price"></p>
            </div>
            <input type="hidden" name="inquiryType" value="commission">
            <input type="hidden" name="paintingSlug" value="">
            <input type="hidden" name="paintingTitle" value="">
            <input type="hidden" name="paintingPrice" value="">
            <input type="hidden" name="btcpayRef" value="">
            <div class="field-row">
              <label>
                <span>First Name</span>
                <input type="text" name="firstName" placeholder="First Name" autocomplete="given-name">
              </label>
              <label>
                <span>Last Name</span>
                <input type="text" name="lastName" placeholder="Last Name" autocomplete="family-name">
              </label>
            </div>

            <label>
              <span>Email (required)</span>
              <input type="email" name="email" placeholder="Email" autocomplete="email" required="">
            </label>

            <div class="quote-only" hidden>
              <label>
                <span>Country (required)</span>
                <input type="text" name="shipCountry" autocomplete="shipping country-name" maxlength="80" placeholder="Country">
              </label>
              <label>
                <span>City or region</span>
                <input type="text" name="shipCity" autocomplete="shipping address-level2" maxlength="80" placeholder="City">
              </label>
            </div>

            <label class="commission-only">
              <span>Package</span>
              <select name="package">
                <option value="">Choose a package (optional)</option>
                {packages.flatMap(product => product.options?.length
                  ? product.options.map(o => <option value={`${product.slug}-${o.id}`} data-size={o.size||o.label}>{product.title} {o.label} — ${Number(o.amount).toLocaleString('en-US')}</option>)
                  : [<option value={product.slug}>{product.title} — {product.listing?.price?.from ? 'from ' : ''}${Number(product.listing?.price?.amount || 0).toFixed(0)}</option>])}
                {petOptions.map(o => <option value={o.id} data-size={o.size}>{o.label} — ${Number(o.amount).toLocaleString('en-US')}</option>)}
                {bitcoinOptions.map(o => <option value={o.id} data-size={o.size}>{o.label} — ${Number(o.amount).toLocaleString('en-US')}</option>)}
                <option value="mural">Mural — ${MURAL_RATE} per square foot</option>
                <option value="custom">Custom / other</option>
              </select>
            </label>

            <!-- Size comes from the chosen package (custom sizes go in the message). -->
            <input type="hidden" name="size" value="">

            <label class="commission-only">
              <span>Reference image (optional)</span>
              <input type="file" name="referenceImage" accept="image/jpeg,image/png,image/webp,image/heic,image/heif">
            </label>

            <label class="commission-only">
              <span>Color palette / swatch (optional)</span>
              <input type="file" name="paletteImage" accept="image/jpeg,image/png,image/webp,image/heic,image/heif">
            </label>

            <label>
              <span>Message (required)</span>
              <textarea name="message" required="" rows="5" placeholder="Tell me about your vision"></textarea>
            </label>

            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot">

            <p class="form-privacy-note" data-commission-privacy>Your details and optional images are used to respond to your request and plan your commission. This does not subscribe you to marketing or authorize public use of your photos. <a href="/privacy/">Privacy &amp; image retention</a>.</p>
            <p class="form-privacy-note" data-quote-privacy hidden>Your details are used to reply with a shipping quote. This does not subscribe you to marketing or authorize public use of anything you send. <a href="/privacy/">Privacy</a>.</p>
            <p class="form-reply-note">I reply within 2 business days.</p>
            <button type="submit" class="button button-solid">Send commission request</button>
            <p class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
          </form>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
  <script is:inline src="/script.js"></script>
  <script is:inline src="/portrait-preview.js" defer></script>
</body>
</html>
<style>
  .commissions-hub .commissions-intro .lede { color: var(--muted); }
  .commissions-hub h1 {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: var(--page-title-size);
    line-height: var(--page-title-leading);
    margin: 0 0 0.65rem;
  }
  .commissions-hub .lede { max-width: 42rem; font-size: 1.1rem; line-height: 1.55; }
  .commissions-terms-banner {
    margin: 1.25rem 0 1.5rem;
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    background: var(--paper, #f4ebdf);
    border: 1px solid var(--line, #d6c9bc);
    max-width: 36rem;
  }
  .commissions-hub .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .process-embed { max-width: 860px; }
  .process-more { margin: 1rem 0 0; }
  .process-more a { text-decoration: underline; text-underline-offset: 0.2em; }
  .faq-wrap { max-width: 760px; }
  .faq-list { display: grid; gap: 0.75rem; }
  .faq-list details {
    border: 1px solid var(--line, #d6c9bc);
    border-radius: 12px;
    background: rgba(255,255,255,0.45);
    padding: 0.85rem 1.1rem;
  }
  .faq-list summary {
    cursor: pointer;
    font-weight: 600;
    line-height: 1.4;
  }
  .faq-list details p { margin: 0.75rem 0 0.25rem; line-height: 1.75; color: var(--ink); }
  .faq-list a { text-decoration: underline; text-underline-offset: 0.2em; }
  .package-summary {
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: var(--paper, #f4ebdf);
    border: 1px solid var(--line, #d6c9bc);
  }
  :global(.deposit-offer) { margin-top: 1rem; padding: 1rem 1.25rem; border: 1px solid rgba(25,19,15,.14); border-radius: 14px; background: rgba(255,255,255,.6); }
  :global(.deposit-offer p) { margin: 0 0 .75rem; }
  :global(.deposit-offer-title) { font-weight: 600; }
  .package-summary h3 { margin: 0.25rem 0; font-size: 1.25rem; }
  .package-summary p { margin: 0; }
  .service-terms {
    margin: 0.65rem 0 1rem;
    font-size: 0.82rem;
    color: var(--ink);
    line-height: 1.45;
  }
  .service-cta { display: inline-flex; margin-top: 0.25rem; text-align: center; }
  #form, #packages, #faq { scroll-margin-top: 6.5rem; }
  @media (max-width: 600px) {
    .commissions-hub .hero-actions .button { width: 100%; text-align: center; }
    #form, #packages, #faq { scroll-margin-top: 5rem; }
  }
</style>
