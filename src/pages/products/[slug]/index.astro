---
import manifest from '../../../../catalog/book-galleries.json';
import {byId,urlFor} from '../../../../catalog/catalog.mjs';
import ProductShare from '../../../components/ProductShare.astro';
import PurchaseReassurance from '../../../components/PurchaseReassurance.astro';
import ProductLayout from '../../../layouts/ProductLayout.astro';
import PaintingImage from '../../../components/PaintingImage.astro';
import ReferencePhoto from '../../../components/ReferencePhoto.astro';
import referenceMedia from '../../../../catalog/reference-media.json';
import CommissionProcess from '../../../components/CommissionProcess.astro';
import PrintPurchaseDialog from '../../../components/PrintPurchaseDialog.astro';
import EmailSignup from '../../../components/EmailSignup.astro';
import RelatedWorks from '../../../components/RelatedWorks.astro';
import {printOptions,config,papers} from '../../../../catalog/prints.mjs';
import { products, priceLabel, statusLabel, dimensionLabel } from '../../../../catalog/catalog.mjs';
export function getStaticPaths() { return products.map(product=>({params:{slug:product.slug},props:{product}})); }
const {product:source}=Astro.props;
// Book-gallery artworks whose section is not published (e.g. forewords) link back to their book instead of a missing gallery.
const publishedSections=new Set(manifest.sections.map(section=>`/book-galleries/${section.id}/`));
const sourceBook=source.bookGallery?byId[source.bookSources?.[0]?.book]:null;
const p=source.bookGallery&&!publishedSections.has(source.back?.href)&&sourceBook
  ?{...source,back:{href:urlFor(sourceBook),label:`← Back to ${sourceBook.title}`}}
  :source;
const painting=p.type==='painting';
const relatedSource=manifest.artworks.find(art=>(art.id===p.id&&art.originalProductId)||art.originalProductId===p.id);
const relatedProduct=relatedSource?byId[relatedSource.id===p.id?relatedSource.originalProductId:relatedSource.id]:null;
const relatedPrints=relatedProduct?printOptions(relatedProduct,config,papers).some(option=>option.ready&&!option.testOnly):false;
const availablePrints=painting?printOptions(p,config,papers).filter(o=>o.ready&&!o.testOnly):[];
const olderOriginals=p.olderWork&&p.olderWork.members.length>1?p.olderWork.members.filter(m=>m.originalId&&byId[m.originalId]).map(m=>({...m,product:byId[m.originalId],status:byId[m.originalId].listing.status})):[];
const printFrom=availablePrints.length?Math.min(...availablePrints.map(o=>Number(o.amount))):null;
// Search/share description for original paintings, built only from catalog facts (no invented details).
const metaDescription=(()=>{
  if(!painting||p.bookGallery)return null;
  const tj=!p.artist||p.artist==='TJ Murphy';
  const d=p.dimensions,size=d?.width&&d?.height?(p.dimensionOrder==='height-width'?`${d.height} × ${d.width} ${d.unit}`:`${d.width} × ${d.height} ${d.unit}`):'';
  const detail=[size,p.year].filter(Boolean).join(', ');
  const shownMedium=p.medium||p.mediumDisplay;
  const medium=shownMedium?`${shownMedium.toLowerCase().replace(/pastels$/,'pastel')} painting`:'painting';
  const lead=tj
    ?`${p.title}: an original ${medium}${detail?` (${detail})`:''} by Seattle artist TJ Murphy.`
    :`${p.title}: an original ${medium}${detail?` (${detail})`:''} by featured artist ${p.artist}, presented by Seattle artist TJ Murphy.`;
  const price=p.listing?.price?.amount?`$${Number(p.listing.price.amount).toLocaleString('en-US',{maximumFractionDigits:2})}`:'';
  const status=p.olderWork?'From the Older Work collection.':p.archive&&!p.archive.originalWithdrawn&&p.listing.status==='not-for-sale'?'From the Archived Paintings collection.':{available:price?`Original available for ${price}.`:'Original available.',inquiry:'Original available by inquiry.',sold:'The original has sold.','not-for-sale':'The original is not for sale.',reserved:'The original is currently reserved.'}[p.listing?.status]||'';
  const prints=printFrom?`Fine-art prints from $${Number(printFrom).toLocaleString('en-US',{minimumFractionDigits:printFrom%1?2:0,maximumFractionDigits:2})}.`:'';
  return [lead,status,prints].filter(Boolean).join(' ');
})();
const facts=painting ? [
  ...(!p.bookGallery&&!p.archive&&!p.olderWork?[{label:'Dimensions',value:dimensionLabel(p)}]:[]),
  ...((p.medium||p.mediumDisplay)?[{label:'Medium',value:p.medium||p.mediumDisplay}]:[]),
  ...(p.surface?[{label:p.artist==='Paul Murphy'?'Material':'Surface',value:p.surface}]:[]),
  ...(p.year?[{label:'Year',value:p.year}]:[]),
  ...(p.framing?[{label:'Framing',value:p.framing}]:[]),
  ...(p.facts||[]),
  ...(p.artist==='Paul Murphy'?[{label:'Artist',value:p.artist},{label:'Gallery reference',value:p.galleryReference}]:[])
] : [];
---
<ProductLayout product={p} metaDescription={metaDescription}>
{p.type==='book' ? <main class="container book-product">
  <nav class="book-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/books/">Books</a> / {p.title}</nav>
  <section class="book-intro" aria-labelledby="book-title">
    <img class="book-cover" {...p.image} fetchpriority="high" />
    <div class="book-summary"><p class="eyebrow dark">{p.eyebrow}</p><h1 id="book-title">{p.title}</h1><p class="book-author">{p.author}</p>
      {p.story.map(text=><p class="book-description">{text}</p>)}
      <div class="book-actions"><a class="button button-solid" href={p.book.purchaseUrl} target="_blank" rel="noopener noreferrer">Buy on Amazon ↗</a><a class="button button-ghost" href="#read-book">Read the book</a></div><p class="book-purchase-note">Pricing and formats on Amazon.</p>
      <ProductShare product={p}/>
    </div>
  </section>
  <section id="read-book" class="book-preview" aria-labelledby="book-preview-title"><div class="book-preview-heading"><h2 id="book-preview-title">Inside the book</h2><a href={p.book.pdfUrl} target="_blank" rel="noopener noreferrer">Open PDF ↗ <span>({p.book.pdfSize})</span></a></div><iframe src={`${p.book.pdfUrl}#view=FitH`} title={`${p.title} — full book PDF viewer`} loading="lazy"></iframe></section>
  <p class="book-back"><a href="/books/">← All books</a></p>
</main> : <main class="container product-detail" data-product-id={painting?p.id:undefined}>
  <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={p.back.href}>{p.archive?'Archived Paintings':p.olderWork?'Older Work':p.series==='strawberry-point'&&!p.back.href.startsWith('/products/')?'Strawberry Point Backpacking Trip':p.artist==='Paul Murphy'?'Paul Murphy':p.type==='commission'?'Commissions':p.back.href.startsWith('/products/')?p.back.label.replace('← Back to ',''):'Gallery'}</a><span>/</span><span aria-current="page">{p.title}</span></nav>
  {p.examples?.length>0 && <section class="commission-gallery"><div class="section-heading"><h2>Portrait gallery</h2><p>{p.galleryDescription}</p></div><div class="exhibition-grid">{p.examples.map(img=><a class="ex-photo" href={img.src}><img {...img} loading="lazy" decoding="async" /></a>)}</div></section>}
  <article class:list={['product-layout',{'product-layout-text':!painting}]}>
    {painting && <PaintingImage image={p.image} title={p.title} gallery={p.gallery} video={p.video} />}
    <div class="product-summary"><p class="eyebrow dark">{p.eyebrow}</p><h1>{p.title}</h1>{p.artist==="Paul Murphy" && <p class="product-artist-byline">by <a href="/exhibitions/paul-murphy/">Paul Murphy</a>, featured artist</p>}
  {painting && (p.listing.status==='available' || availablePrints.length>0) && <section class="product-purchase-actions" aria-label="Purchase options">
    {p.listing.status==='available' && <div data-original-purchase>
      {p.checkout?.mode==='integrated' ? <div data-cart-product>
          <div class="cart-product-actions"><button type="button" class="button button-solid" data-cart-buy>Buy now</button><button type="button" class="cart-text-link" data-cart-add>Add to cart</button><a class="button button-solid" data-purchase-inquiry href={p.inquiryHref||`/commissions/?product=${encodeURIComponent(p.slug)}#form`} hidden>Buy</a>{p.listing.price&&<p class="product-detail-price">{priceLabel(p)}</p>}</div>
          <p class="cart-product-message" data-cart-added role="status" aria-live="polite"></p>
        </div> : <><a class="button button-solid" data-purchase-inquiry href={p.inquiryHref||`/commissions/?product=${encodeURIComponent(p.slug)}#form`}>Buy</a>{p.listing.price&&<p class="product-detail-price">{priceLabel(p)}</p>}</>}
    </div>}
    {availablePrints.length>0 && <div class="product-print-action">
      <button type="button" class="button button-ghost" data-print-open aria-haspopup="dialog" aria-controls="print-purchase-dialog">Buy a print</button>
      <p class="product-print-availability">Print available from ${printFrom.toFixed(2)}</p>
    </div>}
  </section>}
      {relatedProduct&&<p class="product-print-availability"><a href={urlFor(relatedProduct)}>{p.bookGallery?'View the original painting':(relatedPrints?'View fine-art print options':'View in the book collection')} →</a></p>}
      {p.listing.price && p.listing.status!=='not-for-sale' && (!painting||p.listing.status!=='available') && <p class="product-detail-price">{priceLabel(p)}</p>}
      {painting && <p class="product-availability" data-live-status={(p.archive&&!p.archive.originalWithdrawn&&p.listing.status==='not-for-sale')||p.olderWork?undefined:''}>{p.archive&&!p.archive.originalWithdrawn&&p.listing.status==='not-for-sale'?'Archived painting':p.olderWork?(p.olderWork.members.length>1?(olderOriginals.some(o=>o.status==='available')?'Originals available':(olderOriginals.length?'Originals sold':'')):(p.listing.status==='not-for-sale'?'':statusLabel(p))):p.bookGallery?'From the book collection':statusLabel(p)}</p>}
      {olderOriginals.length>0&&<section class="older-originals-list" aria-labelledby="older-originals-heading"><h2 id="older-originals-heading">Originals</h2><ul>{olderOriginals.map(o=>{const href=urlFor(o.product),sold=o.status==='sold',avail=o.status==='available';return <li data-original-id={o.originalId} data-status={o.status}>
        <a class="older-original-thumb" href={href}><img src={`${o.display.base}-480.webp`} width={o.display.width} height={o.display.height} alt={`${o.name}, a painting by TJ Murphy`} loading="lazy" decoding="async"/></a>
        <div><a class="older-original-name" href={href}>{o.name.replace(/^TJ /,'')}</a><p>{o.dimensions?`${o.dimensions.width} × ${o.dimensions.height} in · `:''}{sold?'Sold':avail?`$${Number(o.price.amount)}`:statusLabel(o.product)}</p></div>
        {avail?<a class="button button-solid older-original-buy" href={href}>Buy</a>:<a class="older-original-view" href={href}>View</a>}</li>;})}</ul></section>}
      {painting&&!p.archive&&availablePrints.length===0&&!relatedPrints&&<p class="product-print-availability">Prints not yet available for this painting.</p>}
      {painting&&!p.bookGallery&&p.listing.status==='sold'&&<section class="sold-next-steps" aria-label="Next steps for a sold painting">
        <p>This original has found its home. I can paint something in the same spirit for you.</p>
        <a class="button button-solid" href="/commissions/">Commission something similar</a>
        {availablePrints.length===0&&!relatedPrints&&<EmailSignup id="notify-prints-email" compact heading="Notify me when prints are available" text="Join my studio notes and I’ll share when prints of this painting are released. A few emails a year; unsubscribe anytime." button="Notify me" />}
        {!(availablePrints.length===0&&!relatedPrints)&&<EmailSignup id="sold-email" compact text="Get first look at new originals. A few emails a year; unsubscribe anytime." />}
      </section>}
      {facts.length>0 && <dl class="painting-facts">{facts.map(f=><><dt>{f.label}</dt><dd>{f.href?<a href={f.href}>{f.value}</a>:f.value}</dd></>)}</dl>}
      {p.storyHeading ? <section class="painting-story" aria-labelledby="painting-story-heading"><h2 id="painting-story-heading">{p.storyHeading}</h2>{p.story.map(text=><p>{text}</p>)}</section> : p.story.map(text=><p class={!painting?'product-description':undefined}>{text}</p>)}
      {painting && referenceMedia[p.id] && <ReferencePhoto media={referenceMedia[p.id]} />}
      {painting && (p.listing.status==='available' || availablePrints.length>0) && <p class="product-pay-line">Pay with Bitcoin / Lightning (BTCPay) or card.</p>}
      {painting && (p.listing.status==='available' || availablePrints.length>0) && <PurchaseReassurance kind={p.listing.status==='available'?'original':'print'} exhibited={!p.artist||p.artist==='TJ Murphy'}/>}
      {painting && <ProductShare product={p}/>}
      {p.type==='commission' && <CommissionProcess />}
      <div class="product-inquiry">{!painting&&<a class="button button-solid" href={p.inquiryHref||`/commissions/?product=${encodeURIComponent(p.slug)}#form`}>{p.inquiry.label}</a>}{p.inquiry.note && <p>{p.inquiry.note}</p>}</div>
      {!painting && <ProductShare product={p}/>}
      <a class="product-back" href={p.back.href}>{p.back.label}</a>
    </div>
  </article>
  {painting && <RelatedWorks product={p} />}
  {availablePrints.length>0&&<PrintPurchaseDialog product={p}/>}
</main>}
<style is:global>.older-originals-list{margin:26px 0}.older-originals-list h2{font:600 1.6rem/1.2 'Cormorant Garamond',serif;margin:0 0 10px}.older-originals-list ul{list-style:none;margin:0;padding:0}.older-originals-list li{display:grid;grid-template-columns:72px 1fr auto;gap:12px;align-items:center;padding:10px 0;border-top:1px solid #e3d9ce}.older-original-thumb{display:block;background:#f1ece4;border-radius:3px}.older-original-thumb img{display:block;width:72px;height:72px;object-fit:contain;padding:4px}.older-original-name{color:inherit;font-weight:600}.older-originals-list li p{margin:2px 0 0;font-size:.88rem;color:#665b52}.older-originals-list .older-original-buy{padding:8px 18px;min-height:0}.older-original-view{color:#a34528;font-size:.9rem}</style>
</ProductLayout>


