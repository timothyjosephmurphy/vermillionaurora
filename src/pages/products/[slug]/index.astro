---
import PurchaseReassurance from '../../../components/PurchaseReassurance.astro';
import ProductLayout from '../../../layouts/ProductLayout.astro';
import PaintingImage from '../../../components/PaintingImage.astro';
import CommissionProcess from '../../../components/CommissionProcess.astro';
import PrintPurchaseDialog from '../../../components/PrintPurchaseDialog.astro';
import {originalFrameEligible,amazonFrameSearchUrl} from '../../../../catalog/frame-matching.mjs';
import {printOptions,config,papers} from '../../../../catalog/prints.mjs';
import { products, priceLabel, statusLabel, dimensionLabel } from '../../../../catalog/catalog.mjs';
export function getStaticPaths() { return products.map(product=>({params:{slug:product.slug},props:{product}})); }
const {product:p}=Astro.props;
const painting=p.type==='painting';
const originalFrameHref=originalFrameEligible(p)?amazonFrameSearchUrl(p.dimensions):null;
const availablePrints=painting?printOptions(p,config,papers).filter(o=>o.ready&&!o.testOnly):[];
const printFrom=availablePrints.length?Math.min(...availablePrints.map(o=>Number(o.amount))):null;
const facts=painting ? [
  ...(!p.bookGallery?[{label:'Dimensions',value:dimensionLabel(p)}]:[]),
  ...(p.medium?[{label:'Medium',value:p.medium}]:[]),
  ...(p.surface?[{label:p.artist==='Paul Murphy'?'Material':'Surface',value:p.surface}]:[]),
  ...(p.year?[{label:'Year',value:p.year}]:[]),
  ...(p.framing?[{label:'Framing',value:p.framing}]:[]),
  ...(p.facts||[]),
  ...(p.artist==='Paul Murphy'?[{label:'Artist',value:p.artist},{label:'Gallery reference',value:p.galleryReference}]:[])
] : [];
---
<ProductLayout product={p}>
{p.type==='book' ? <main class="container book-product">
  <nav class="book-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/#books">Books</a> / {p.title}</nav>
  <section class="book-intro" aria-labelledby="book-title">
    <img class="book-cover" {...p.image} fetchpriority="high" />
    <div class="book-summary"><p class="eyebrow dark">{p.eyebrow}</p><h1 id="book-title">{p.title}</h1><p class="book-author">{p.author}</p>
      {p.story.map(text=><p class="book-description">{text}</p>)}
      <div class="book-actions"><a class="button button-solid" href={p.book.purchaseUrl} target="_blank" rel="noopener noreferrer">Buy on Amazon ↗</a><a class="button button-ghost" href="#read-book">Read the book</a></div><p class="book-purchase-note">Pricing and formats on Amazon.</p>
    </div>
  </section>
  <section id="read-book" class="book-preview" aria-labelledby="book-preview-title"><div class="book-preview-heading"><h2 id="book-preview-title">Inside the book</h2><a href={p.book.pdfUrl} target="_blank" rel="noopener noreferrer">Open PDF ↗ <span>({p.book.pdfSize})</span></a></div><iframe src={`${p.book.pdfUrl}#view=FitH`} title={`${p.title} — full book PDF viewer`} loading="lazy"></iframe></section>
  <p class="book-back"><a href="/#books">← All books</a></p>
</main> : <main class="container product-detail" data-product-id={painting?p.id:undefined}>
  <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href={p.back.href}>{p.artist==='Paul Murphy'?'Paul Murphy':p.type==='commission'?'Commissions':'Gallery'}</a><span>/</span><span aria-current="page">{p.title}</span></nav>
  {p.examples?.length>0 && <section class="commission-gallery"><div class="section-heading"><h2>Portrait gallery</h2><p>{p.galleryDescription}</p></div><div class="exhibition-grid">{p.examples.map(img=><a class="ex-photo" href={img.src}><img {...img} loading="lazy" decoding="async" /></a>)}</div></section>}
  <article class:list={['product-layout',{'product-layout-text':!painting}]}>
    {painting && <PaintingImage image={p.image} title={p.title} />}
    <div class="product-summary"><p class="eyebrow dark">{p.eyebrow}</p><h1>{p.title}</h1>
  {painting && (p.listing.status==='available' || availablePrints.length>0) && <section class="product-purchase-actions" aria-label="Purchase options">
    {p.listing.status==='available' && <div data-original-purchase>
      {p.checkout?.mode==='integrated' ? <div data-cart-product>
          <div class="cart-product-actions"><button type="button" class="button button-solid" data-cart-buy hidden>Buy now</button><button type="button" class="cart-text-link" data-cart-add hidden>Add to cart</button><a class="button button-solid" data-purchase-inquiry href={p.inquiryHref||`/?product=${p.slug}#contact`}>Inquire to buy</a>{p.listing.price&&<p class="product-detail-price">{priceLabel(p,true)}</p>}</div>
          <p class="cart-product-message" data-cart-added role="status" aria-live="polite"></p>
        </div> : <><a class="button button-solid" data-purchase-inquiry href={p.inquiryHref||`/?product=${p.slug}#contact`}>Inquire to buy</a>{p.listing.price&&<p class="product-detail-price">{priceLabel(p,true)}</p>}</>}
    </div>}
    {availablePrints.length>0 && <div class="product-print-action">
      <button type="button" class="button button-ghost" data-print-open aria-haspopup="dialog" aria-controls="print-purchase-dialog">Buy a print</button>
      <p class="product-print-availability">Print available from ${printFrom.toFixed(2)}</p>
    </div>}
  </section>}
      {p.listing.price && (!painting||p.listing.status!=='available') && <p class="product-detail-price">{priceLabel(p,painting)}</p>}
      {painting && <p class="product-availability" data-live-status>{p.bookGallery?'From the book collection':statusLabel(p)}</p>}
      {painting&&availablePrints.length===0&&<p class="product-print-availability">Prints not yet available for this painting.</p>}
      {facts.length>0 && <dl class="painting-facts">{facts.map(f=><><dt>{f.label}</dt><dd>{f.value}</dd></>)}</dl>}
      {p.storyHeading ? <section class="painting-story" aria-labelledby="painting-story-heading"><h2 id="painting-story-heading">{p.storyHeading}</h2>{p.story.map(text=><p>{text}</p>)}</section> : p.story.map(text=><p class={!painting?'product-description':undefined}>{text}</p>)}
      {painting && (p.listing.status==='available' || availablePrints.length>0) && <PurchaseReassurance kind={p.listing.status==='available'?(availablePrints.length?'all':'original'):'print'}/>}
      {p.type==='commission' && <CommissionProcess />}
      <div class="product-inquiry">{!painting&&<a class="button button-solid" href={p.inquiryHref||`/?product=${p.slug}#contact`}>{p.inquiry.label}</a>}{p.inquiry.note && <p>{p.inquiry.note}</p>}</div>
      {originalFrameHref&&<div class="product-frame-action"><a class="button button-ghost" data-original-frame href={originalFrameHref} target="_blank" rel="noopener noreferrer">Find a matching frame on Amazon</a></div>}
      <a class="product-back" href={p.back.href}>{p.back.label}</a>
    </div>
  </article>
  {availablePrints.length>0&&<PrintPurchaseDialog product={p}/>}
</main>}
</ProductLayout>
