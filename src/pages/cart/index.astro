---
import PurchaseReassurance from '../../components/PurchaseReassurance.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import {catalogVersion} from '../../../catalog/catalog.mjs';
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Your cart | Vermillion Aurora</title><meta property="og:type" content="website"/><meta property="og:site_name" content="Vermillion Aurora"/><meta property="og:title" content="Your cart | Vermillion Aurora"/><meta property="og:description" content="Original paintings, fine-art prints and commissions by Seattle watercolor artist TJ Murphy."/><meta property="og:url" content="https://vermillionaurora.com/cart/"/><meta property="og:image" content="https://vermillionaurora.com/gallery-images/warszawska-syrenka.jpeg"/><meta name="twitter:card" content="summary_large_image"/><meta name="robots" content="noindex"/><meta name="catalog-version" content={catalogVersion}/>
<meta name="referrer" content="same-origin"/>
<link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/site-header.css"/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
</head><body><div class="page-shell"><SiteHeader/>
<main class="container cart-page" data-cart-page>
  <div class="cart-heading"><div><h1 tabindex="-1">Your cart</h1></div><a href="/gallery/" class="cart-text-link">Continue exploring the gallery ↗</a></div>
  <p class="cart-notice" data-cart-notice role="status" aria-live="polite">Loading your cart…</p>
  <noscript><p>Please enable JavaScript to use the cart, or <a href="/#contact">contact TJ to arrange a purchase</a>.</p></noscript>
  <section data-order-panel hidden aria-labelledby="order-title" class="cart-order-panel">
    <p class="eyebrow dark">Your order</p><h2 id="order-title">Checking payment</h2><p data-order-message role="status"></p>
    <p data-order-reference></p><div data-order-items></div><dl class="cart-order-breakdown" data-order-breakdown></dl><p class="cart-paid-total" data-order-total></p><div data-order-tracking></div>
    <div class="cart-order-actions"><a class="button button-solid" data-order-resume hidden>Continue payment</a><button class="button button-ghost" data-order-check type="button">Check payment status</button><button class="cart-text-link" data-order-cancel type="button" hidden>Cancel checkout</button><button class="button button-ghost" data-order-back type="button" hidden>Return to cart</button><button class="button button-ghost" data-order-print type="button" hidden>Print confirmation</button></div>
  </section>
  <div class="cart-layout" data-cart-layout hidden>
    <section class="cart-artworks" aria-label="Selected artworks"><div data-cart-items></div><p class="cart-footnote" data-cart-reservation hidden></p><p class="cart-footnote">Originals are held for 15 minutes after you add them to your cart. Complete checkout before the hold expires.</p></section>
    <aside class="cart-checkout" aria-labelledby="checkout-title"><p class="eyebrow dark">Art for your space</p><h2 id="checkout-title">Order summary</h2>
      <dl class="cart-totals"><div><dt>Artwork subtotal</dt><dd data-cart-subtotal>—</dd></div><div><dt>Shipping</dt><dd data-cart-shipping>Calculated below</dd></div><div><dt>Tax</dt><dd data-cart-tax>Calculated below</dd></div><div class="cart-total"><dt>Total <small>USD</small></dt><dd data-cart-total>—</dd></div></dl>
      <form data-cart-form>
        <fieldset><legend>Contact &amp; delivery</legend>
          <label>Email<input type="email" name="email" autocomplete="email" maxlength="254" required/></label>
          <label>Full name<input name="name" autocomplete="shipping name" maxlength="100" required/></label>
          <label>Street address<input name="street1" autocomplete="shipping address-line1" maxlength="100" required/></label>
          <label>Apartment, suite, etc. <span>(optional)</span><input name="street2" autocomplete="shipping address-line2" maxlength="100"/></label>
          <label>City<input name="city" autocomplete="shipping address-level2" maxlength="100" required/></label>
          <div class="cart-address-row"><label>State<input name="state" autocomplete="shipping address-level1" pattern="[A-Za-z]{2}" maxlength="2" placeholder="WA" required/></label><label>ZIP code<input name="zip" autocomplete="shipping postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" required/></label></div>
          <label>Code <span>(optional)</span><input name="printCode" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="40" placeholder="Print code"/></label>
          <p class="cart-footnote" data-cart-code-note hidden></p>
          <p class="cart-footnote">United States delivery. Prints ship from the print lab, separately from originals. Shipping includes all shipments.</p>
        </fieldset>
        <p class="cart-footnote">Your details are used to quote and fulfill this order. <a href="/privacy/">How your information is handled</a>.</p>
        <button class="button button-solid cart-wide" type="submit" data-cart-quote>Calculate shipping &amp; tax</button>
      </form>
      <div data-cart-payments hidden><p class="cart-footnote" data-cart-payment-help>Calculate shipping and tax to enable payment.</p><div data-cart-methods></div><div data-square-card-box hidden><p class="cart-footnote">Card details are processed securely by Square.</p><div data-square-card></div></div></div>
      <PurchaseReassurance/>
      <p class="cart-footnote cart-help">A question about your order? <a href="/#contact">Contact TJ</a>.</p>
    </aside>
  </div>
  <div class="cart-empty" data-cart-empty hidden><h2>A place for the work you love.</h2><p>Explore the paintings and add an available original or print to begin your collection.</p><a class="button button-solid" href="/gallery/">Explore the paintings</a></div>
</main><SiteFooter/></div></body></html>
