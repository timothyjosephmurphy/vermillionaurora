---
// Full-screen projector page. No site header, nav, or footer.
// The dancer stage is neural-dance/room-lab.js. The camera is camera-markers.js.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex" />
<title>Neural Dance Live | TJ Murphy</title>
<meta name="description" content="Full-screen Neural Dance for a projector: room-music dancers, the microphone, and a Continuity Camera watching pink notes on the wall." />
<link href="/fonts/fonts.css" rel="stylesheet">
<style is:inline>
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#000;color:#f4f6fb;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{overflow:hidden}
button,select,input{font:inherit}
button{cursor:pointer}
#nd-room-lab{--background:#080910;--foreground:#f4f6fb;--viz-series-1:#ff927d;--viz-series-2:#eb92f5;--viz-series-3:#7fe8b3;--viz-series-4:#81b7fc}
#nd-room-projector{position:fixed;z-index:1;inset:0;margin:auto;width:min(100vw,calc(100vh * 1000 / 620));height:min(100vh,calc(100vw * 620 / 1000));background:#080910}
#nd-room-lab [data-stage]{display:block;width:100%;height:100%;background:#080910;touch-action:none}
#nd-live-dock,#nd-camera-mode{position:fixed;z-index:30;left:12px;width:min(960px,calc(100vw - 24px));background:rgba(8,9,16,.92);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:12px;box-shadow:0 18px 50px rgba(0,0,0,.35)}
#nd-live-dock{top:12px;max-height:calc(100vh - 280px);overflow:auto}
#nd-camera-mode{bottom:12px;max-height:42vh;overflow:auto}
.nd-live-bar,.viz-row,.viz-controls{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.viz-controls{align-items:end}
.nd-live-bar{margin:0}
h1,h2{font-size:18px;margin:0 8px 0 0}
.mural-help{color:#aab0c0;line-height:1.45;font-size:14px;margin:8px 0}
.mural-help a{color:#9baef0}
.btn,.form-select{border:1px solid rgba(255,255,255,.18);background:#171a24;color:#f4f6fb;border-radius:9px;padding:8px 12px}
.btn-primary{background:#3158b8;border-color:#527af0}
.btn[aria-pressed="true"],.btn[data-state="listening"]{background:#1d6b45;border-color:#3dba7a}
.btn[data-state="muted"]{background:#3a3420;border-color:#c9a24a;color:#f3e2b3}
.btn[data-state="unavailable"]{border-color:#8a6070}
.btn:disabled{cursor:default;opacity:.55}
button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid #9baef0;outline-offset:3px}
.nd-live-details{margin-top:10px}
.viz-controls{padding:10px;background:#10121a;border-radius:14px;margin:0 0 10px}
.form-label{display:grid;gap:4px;flex:1 1 140px;min-width:0;color:#aab0c0;font-size:13px}
.form-range{width:100%;margin:0;accent-color:#81b7fc}
#nd-camera-mode .form-range{accent-color:#ff7ad9}
.viz-controls output{color:#fff;font-variant-numeric:tabular-nums}
.text-small{font-size:13px;color:#aab0c0}
[data-mic]{color:#d5deff}
[data-legend].is-hot{text-shadow:0 0 10px currentColor}
.meter{display:none;width:48px;height:5px;margin-left:6px;border-radius:99px;background:rgba(255,255,255,.12);overflow:hidden;vertical-align:middle}
#nd-room-lab[data-mic="listening"] .meter{display:inline-block}
.meter i{display:block;height:100%;width:100%;background:currentColor;transform:scaleX(0);transform-origin:left center}
#nd-room-lab [data-spectrum]{display:block;width:100%;height:72px;background:#05060a;border-radius:10px;margin:0 0 8px}
.camera-frame{position:relative;width:min(420px,100%);aspect-ratio:16/9;background:#05060a;border-radius:12px;overflow:hidden;margin:8px 0}
#nd-camera-mode [data-preview],#nd-camera-mode [data-overlay]{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#05060a}
#nd-camera-mode [data-overlay]{touch-action:none;cursor:crosshair}
#nd-room-lab.is-mapping .viz-row:first-of-type{position:fixed;z-index:1000002;top:12px;left:12px;right:12px;width:auto;background:#10121a;padding:10px;border-radius:12px}
.nd-live-reveal{position:fixed;z-index:40;top:10px;left:10px;opacity:.55}
.nd-live-reveal:hover,.nd-live-reveal:focus-visible{opacity:1}
body.nd-live-collapsed #nd-live-dock .nd-live-details{display:none}
body.nd-live-collapsed #nd-camera-mode .viz-controls,body.nd-live-collapsed #nd-camera-mode .mural-help{display:none}
body.nd-live-collapsed #nd-live-dock{max-height:none}
body.nd-live-hidden #nd-live-dock{display:none}
body.nd-live-hidden #nd-camera-mode{top:0;bottom:auto;left:0;width:320px;height:180px;max-height:none;overflow:hidden;padding:0;border:0;background:transparent;box-shadow:none;transform:translateX(-120vw)}
body.nd-live-hidden #nd-camera-mode .viz-row,body.nd-live-hidden #nd-camera-mode .viz-controls,body.nd-live-hidden #nd-camera-mode .mural-help,body.nd-live-hidden #nd-camera-mode .text-small{display:none}
body.nd-live-hidden #nd-camera-mode .camera-frame{width:320px;height:180px;aspect-ratio:auto;margin:0}
body.nd-live-preview-off #nd-camera-mode .camera-frame{position:fixed;left:0;top:0;width:320px;height:180px;transform:translateX(-120vw);opacity:1;pointer-events:none}
</style>
</head>
<body>
<h1 class="nd-live-sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Neural Dance live</h1>
<section id="nd-room-lab" data-mic="off" aria-labelledby="room-music-title">
  <div id="nd-room-projector"><canvas class="cursor-interaction" data-add-dancer data-stage width="1000" height="620" role="img" aria-label="Room-music dancers filling the projection. They move when the microphone hears a kick, bass, snare, or hi-hat."></canvas></div>
  <div id="nd-live-dock">
    <div class="viz-row nd-live-bar">
      <h2 id="room-music-title">Room music</h2>
      <button class="btn btn-primary" type="button" data-action="play">Start</button>
      <button class="btn" type="button" data-action="listen" data-state="off" aria-pressed="false">Listen</button>
      <button class="btn" type="button" data-action="align" aria-pressed="false">Align projector</button>
      <button class="btn" type="button" data-live="fullscreen">Fullscreen</button>
      <button class="btn" type="button" data-live="collapse" aria-expanded="true">Collapse</button>
      <button class="btn" type="button" data-live="hide">Hide controls</button>
      <button class="btn" type="button" data-live="preview" aria-pressed="true">Preview</button>
      <span data-mic role="status" aria-live="polite">Mic off</span>
      <span data-status role="status" aria-live="polite">Loading room music…</span>
    </div>
    <div class="nd-live-details" data-live-details>
      <p class="mural-help">Pick the iPhone camera and start it. Press <strong>Listen</strong> and play music in the room. While Listening, a ring around each dancer draws the live waveform of the band it dances to. Quiet threshold is how far the sound must rise above the measured noise floor before dancers move. Choose <strong>Calibrate wall</strong> and click the four corners of the projected image in the preview: top left, top right, bottom right, bottom left. Turn markers on, then stick a pink note on the wall. It joins the dancers after a moment and leaves when the note comes down. <strong>Hide controls</strong> (or H) clears the projection. Gravity, wander, threshold, peak hold, per-band sensitivity, and the quiet threshold stay in this browser.</p>
      <div class="viz-controls" data-add-dancer>
        <label class="form-label">New dancer<select class="form-select" data-control="type"><option value="0">Kick</option><option value="1" selected>Bass</option><option value="2">Snare</option><option value="3">Hi-hat</option></select></label>
        <label class="form-label">Gravity <output data-value="gravity">2.5×</output><input class="form-range" data-control="gravity" type="range" min="0" max="6" step="0.1" value="2.5" aria-label="Gravity"></label>
        <label class="form-label">Wander <output data-value="wander">0.25</output><input class="form-range" data-control="wander" type="range" min="0" max="0.8" step="0.05" value="0.25" aria-label="Wander"></label>
        <label class="form-label">Threshold <output data-value="threshold">1.40</output><input class="form-range" data-control="threshold" type="range" min="1" max="1.9" step="0.05" value="1.4" aria-label="Threshold"></label>
        <label class="form-label">Peak hold <output data-value="peak">2.8 s</output><input class="form-range" data-control="peak" type="range" min="1" max="6" step="0.1" value="2.8" aria-label="Peak hold"></label>
        <label class="form-label">Kick sensitivity <output data-value="sens-0">1.00×</output><input class="form-range" data-control="sens" data-band="0" type="range" min="0" max="3" step="0.05" value="1" aria-label="Kick sensitivity"></label>
        <label class="form-label">Bass sensitivity <output data-value="sens-1">1.00×</output><input class="form-range" data-control="sens" data-band="1" type="range" min="0" max="3" step="0.05" value="1" aria-label="Bass sensitivity"></label>
        <label class="form-label">Snare sensitivity <output data-value="sens-2">1.00×</output><input class="form-range" data-control="sens" data-band="2" type="range" min="0" max="3" step="0.05" value="1" aria-label="Snare sensitivity"></label>
        <label class="form-label">Hi-hat sensitivity <output data-value="sens-3">1.00×</output><input class="form-range" data-control="sens" data-band="3" type="range" min="0" max="3" step="0.05" value="1" aria-label="Hi-hat sensitivity"></label>
        <label class="form-label">Quiet threshold <output data-value="quiet">0.08</output><input class="form-range" data-control="quiet" type="range" min="0" max="0.4" step="0.01" value="0.08" aria-label="Quiet threshold"></label>
      </div>
      <canvas data-spectrum width="880" height="96" aria-label="Live microphone levels for kick, bass, mid, and treble"></canvas>
      <div class="viz-row text-small"><span data-legend="0">● Kick<span class="meter"><i data-meter="0"></i></span></span><span data-legend="1">◆ Bass<span class="meter"><i data-meter="1"></i></span></span><span data-legend="2">■ Mid<span class="meter"><i data-meter="2"></i></span></span><span data-legend="3">▲ Treble<span class="meter"><i data-meter="3"></i></span></span><span data-floor>noise floor —</span></div>
    </div>
  </div>
</section>
<section id="nd-camera-mode" aria-labelledby="camera-mode-title">
  <div class="viz-row"><h2 id="camera-mode-title">Camera</h2><button class="btn btn-primary" type="button" data-action="camera">Use camera</button><button class="btn" type="button" data-action="refresh">Refresh cameras</button><button class="btn" type="button" data-action="calibrate" aria-pressed="false">Calibrate wall</button><button class="btn" type="button" data-action="markers" aria-pressed="false" disabled>Markers off</button></div>
  <p class="mural-help">The preview is this camera. Continuity Camera shows up as <strong>iPhone Camera</strong> or <strong>iPhone (3) Camera</strong>. Calibration clicks map the projected image, the same four corners as on the <a href="/neural-dance/">Neural Dance</a> page.</p>
  <div class="viz-controls">
    <label class="form-label">Camera<select class="form-select" data-control="device" aria-label="Camera"><option value="">Choose a camera</option></select></label>
    <label class="form-label">Hue tolerance <output data-value="hue">28°</output><input class="form-range" data-control="hue" type="range" min="5" max="80" step="1" value="28" aria-label="Hue tolerance"></label>
    <label class="form-label">Saturation sensitivity <output data-value="sat">0.55</output><input class="form-range" data-control="sat" type="range" min="0" max="1" step="0.01" value="0.55" aria-label="Saturation sensitivity"></label>
    <label class="form-label">Minimum blob size <output data-value="size">18 px</output><input class="form-range" data-control="size" type="range" min="4" max="200" step="1" value="18" aria-label="Minimum blob size"></label>
  </div>
  <div class="camera-frame"><video data-preview autoplay muted playsinline aria-label="Live camera preview"></video><canvas data-overlay aria-hidden="true"></canvas></div>
  <p class="text-small" data-status role="status" aria-live="polite">Camera off</p>
</section>
<button class="btn nd-live-reveal" type="button" data-live="reveal" hidden>Controls</button>
<script src="/neural-dance/vendor/maptastic.js" is:inline></script>
<script src="/neural-dance/silence-gate.js" is:inline></script>
<script src="/neural-dance/wave-ring.js" is:inline></script>
<script type="module" src="/neural-dance/room-lab.js" is:inline></script>
<script type="module" src="/neural-dance/camera-markers.js" is:inline></script>
<script type="module" src="/neural-dance/live-show.js" is:inline></script>
</body>
</html>
