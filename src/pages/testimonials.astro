---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { testimonials } from '../data/testimonials.mjs';
import { ld, person } from '../data/structured-data.mjs';
import { PUBLISH_NOTICE, PUBLISH_NOTICE_VERSION } from '../../cloudflare/testimonial-notice.mjs';
// Hand-curated entries (src/data/testimonials.json) render at build time; approved form submissions load at
// request time from /testimonials/api/approved, so approving one on /testimonial-manager/ needs no rebuild.
const reviews = testimonials.map(t => ({ '@type':'Review', author:{'@type':'Person',name:t.name}, reviewBody:t.quote, itemReviewed:{'@type':'VisualArtwork',name:t.painting||'Painting by TJ Murphy',creator:{'@id':person['@id']}} }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Collector Testimonials | Seattle watercolor artist TJ Murphy</title>
  <meta name="description" content="Words, photos and videos from people who live with paintings by Seattle watercolor artist TJ Murphy, and a form to share your own." />
  <link rel="canonical" href="https://tjm.art/testimonials/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/site-header.css" />
  {reviews.length > 0 && <script type="application/ld+json" set:html={ld({'@context':'https://schema.org','@graph':reviews})} />}
</head>
<body>
  <div class="page-shell">
    <SiteHeader />
    <main id="main-content" class="container testimonials-page">
      <header class="testimonials-intro">
        <p class="eyebrow dark">Collectors</p>
        <h1>Testimonials</h1>
        <p class="testimonials-lede">Over the years I’ve given many of my paintings to friends, family and people I’ve met on my travels, and others have found homes through sales and commissions. If one of them lives with you, I’d love to hear what it means to you.</p>
        <p class="testimonials-jump" data-has-testimonials hidden><a class="button button-solid" href="#share">Share your story</a> <a class="button button-ghost" href="/exhibitions/world-map/">See collectors on the map</a></p>
      </header>

      <section class="testimonials-wall" aria-labelledby="wall-heading" data-has-testimonials hidden={testimonials.length === 0}>
        <h2 id="wall-heading" class="visually-hidden">What collectors say</h2>
        <ul class="testimonial-list" data-testimonial-list>
          {testimonials.map(t => (
            <li class="testimonial" id={t.id}>
              {t.photo && <img class="testimonial-photo" src={t.photo} alt={`${t.painting || 'Painting by TJ Murphy'} in ${t.name === 'A collector' ? 'a collector' : t.name + '’s'} home`} loading="lazy" decoding="async" />}
              <blockquote><p>“{t.quote}”</p></blockquote>
              <p class="testimonial-meta">
                {t.selfie && <img class="testimonial-selfie" src={t.selfie} alt="" width="48" height="48" loading="lazy" decoding="async" />}
                <span><strong>{t.name}</strong>{t.city && <> · {t.city}</>}{t.painting && <><br />{t.paintingHref ? <a href={t.paintingHref}>{t.painting}</a> : t.painting}</>}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section id="share" class="testimonial-share" aria-labelledby="share-heading">
        <div class="share-copy">
          <h2 id="share-heading">Share your story</h2>
          <p>Tell me about the painting you have, where it lives now, and what it means to you. I read every message personally and publish testimonials after I’ve had a chance to review them.</p>
          <p class="share-thanks" data-share-thanks>As a thank-you, I’ll email you a personal code for a print of any of my paintings at cost.</p>
          <ul class="share-points">
            <li>Your email is optional and stays private. I use it only to send your thank-you print code.</li>
            <li>Location data is removed from photos and videos before anything is published.</li>
            <li>Your city, state and country are shown as an approximate pin on my <a href="/exhibitions/world-map/">exhibitions map</a>, never your address.</li>
          </ul>
        </div>
        <div class="share-form-wrap">
          <div class="form-thanks" data-thanks hidden tabindex="-1">
            <h3>Thank you!</h3>
            <p>Your testimonial is on its way to me<span data-thanks-video hidden>, video and all</span>. I’ll review it soon<span data-thanks-code> and email your thank-you print code</span>. It means a lot that you took the time.</p>
            <p><a href="/gallery/">Browse the gallery</a> · <a href="/commissions/">Commission a painting</a></p>
          </div>
          <form class="contact-form testimonial-form" action="/testimonials/api/submit" method="POST" enctype="multipart/form-data" data-testimonial-form novalidate>
            <div class="field-row">
              <label>
                <span>Your name (optional)</span>
                <input type="text" name="name" maxlength="80" autocomplete="name" placeholder="e.g. Jane D." aria-describedby="name-help" />
                <small id="name-help" class="field-help">As you’d like it shown. Leave it blank to appear as “A collector”.</small>
              </label>
              <label>
                <span>Email (optional, kept private)</span>
                <input type="email" name="email" maxlength="254" autocomplete="email" placeholder="you@example.com" aria-describedby="email-help" />
                <small id="email-help" class="field-help">Only if you’d like a thank-you discount code on prints. Never published.</small>
              </label>
            </div>
            <label>
              <span>Which painting? (optional)</span>
              <input type="text" name="painting" maxlength="200" placeholder="Describe it or give its title" />
            </label>
            <label>
              <span data-quote-label>Your testimonial (required)</span>
              <textarea name="quote" required minlength="3" maxlength="2000" rows="6" placeholder="What does the painting mean to you? Where does it hang?"></textarea>
            </label>
            <label>
              <span>City, state and country (optional)</span>
              <input type="text" name="city" maxlength="100" autocomplete="address-level2" placeholder="e.g. Seattle, WA, USA" aria-describedby="city-help" />
              <small id="city-help" class="field-help">Shown with your testimonial and as an approximate pin on the map. Never your address.</small>
            </label>
            <div class="photo-field" data-photo-field>
              <label for="testimonial-photos">Photos (optional, up to 4)</label>
              <input id="testimonial-photos" type="file" name="photos" multiple accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif" aria-describedby="photo-count" data-photo-input />
              <button type="button" class="photo-add" data-photo-add aria-describedby="photo-count" hidden><span aria-hidden="true">+</span> Add photos</button>
              <p id="photo-count" class="photo-count" role="status" aria-live="polite" data-photo-count></p>
            </div>
            <ul class="photo-previews" data-photo-previews aria-label="Selected photos"></ul>
            <fieldset class="video-field" data-video-field data-video-only hidden>
              <legend>Your video (optional)</legend>
              <div class="video-buttons">
                <button type="button" class="photo-add" data-video-record hidden><span aria-hidden="true">●</span> Record a selfie video</button>
                <button type="button" class="photo-add" data-video-choose><span aria-hidden="true">+</span> <span data-video-choose-label>Choose a video</span></button>
              </div>
              <input type="file" accept="video/*" capture="user" class="visually-hidden" tabindex="-1" aria-hidden="true" data-video-capture />
              <input type="file" accept="video/mp4,video/quicktime,video/webm,.mp4,.m4v,.mov,.webm" class="visually-hidden" tabindex="-1" aria-hidden="true" data-video-input />
              <div class="video-selected" data-video-selected hidden>
                <video muted playsinline preload="metadata" data-video-preview aria-label="Preview of your video"></video>
                <div class="video-selected-info">
                  <strong data-video-name></strong>
                  <span data-video-size></span>
                  <button type="button" class="video-remove" data-video-remove>Remove video</button>
                </div>
              </div>
              <div class="video-progress" data-video-progress hidden>
                <progress max="100" value="0" aria-label="Video upload progress" data-video-bar></progress>
                <span data-video-progress-text></span>
              </div>
              <div class="video-consent" data-video-consent hidden>
                <label class="consent"><input type="checkbox" name="videoSite" value="yes" /><span>TJ can show my video on tjm.art</span></label>
                <label class="consent"><input type="checkbox" name="videoSocial" value="yes" /><span>TJ can share my video on his social media.</span></label>
                <p class="field-help">Both are optional. If you leave them unticked, your video is just for TJ. You can ask TJ to take it down anytime by emailing him at <a href="mailto:tj@tjm.art">tj@tjm.art</a>.</p>
              </div>
            </fieldset>
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" />
            <input type="hidden" name="publishNotice" value={PUBLISH_NOTICE_VERSION} />
            <p class="form-publish-note" data-publish-note>{PUBLISH_NOTICE} Testimonials are reviewed before they appear. <a href="/privacy/">Privacy</a>.</p>
            <button type="submit" class="button button-solid">Send my testimonial</button>
            <p class="form-status" role="status" aria-live="polite" aria-atomic="true" data-form-status></p>
          </form>
        </div>
      </section>
      <p class="testimonial-manager-link"><a href="/testimonial-manager/" rel="nofollow">Manage</a></p>
    </main>
    <SiteFooter />
  </div>
  <style is:global>
    .testimonials-page{padding:48px 0 72px;max-width:1080px}
    .testimonials-intro{max-width:760px;line-height:1.75;color:#3f3832}
    .testimonials-intro h1{margin:.2em 0 .3em;font:600 clamp(2.6rem,6vw,4.2rem)/1.05 "Cormorant Garamond",serif;letter-spacing:-.01em;color:var(--ink)}
    .testimonial-form .field-row{align-items:start}
    .testimonials-lede{font:500 1.35rem/1.55 "Cormorant Garamond",serif;color:var(--ink)}
    .testimonials-jump .button{margin:6px 8px 0 0}
    .visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}
    .testimonials-wall{margin:36px 0 12px}
    .testimonial-list{list-style:none;padding:0;margin:0;columns:3 280px;column-gap:24px}
    .testimonial{break-inside:avoid;background:#fffcf6;border:1px solid var(--line,#d7ccba);border-radius:14px;padding:18px;margin:0 0 24px;scroll-margin-top:120px}
    .testimonial-photo{display:block;width:100%;height:auto;border-radius:9px;margin-bottom:12px;background:#e8dfd3}
    .testimonial-thumbs{display:flex;gap:8px;margin:-4px 0 12px;padding:0;list-style:none}
    .testimonial-thumbs a{display:block}.testimonial-thumbs img{width:64px;height:64px;object-fit:cover;border-radius:7px;display:block}
    .testimonial blockquote{margin:0;font:500 1.25rem/1.45 "Cormorant Garamond",serif;white-space:pre-line}
    .testimonial-meta{display:flex;gap:10px;align-items:center;font-size:.85rem;line-height:1.5;margin:12px 0 0}
    .testimonial-meta a{text-decoration:underline;text-underline-offset:3px}
    .testimonial-selfie{border-radius:50%;object-fit:cover;width:48px;height:48px}
    .testimonial-share{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:40px;margin-top:40px;padding-top:36px;border-top:1px solid var(--line)}
    .share-copy{line-height:1.75;color:#3f3832}.share-copy h2{font:600 clamp(2rem,4vw,2.6rem)/1.1 "Cormorant Garamond",serif;margin:0 0 14px;color:var(--ink)}
    .share-copy a,.form-publish-note a,.form-thanks a{text-decoration:underline;text-underline-offset:3px}
    .share-points{padding-left:1.1rem;font-size:.92rem}.share-points li+li{margin-top:6px}
    .testimonial-form .field-help{font-size:.8rem;letter-spacing:0;text-transform:none;color:var(--muted)}
    .testimonial-form label.consent{display:flex;gap:12px;align-items:flex-start;font-size:.92rem;letter-spacing:0;text-transform:none;line-height:1.55}
    .testimonial-form label.consent input{width:22px;height:22px;flex:none;margin-top:2px;accent-color:var(--cta)}
    .testimonial-form [aria-invalid=true]{border-color:#b83518;box-shadow:0 0 0 2px rgba(184,53,24,.15)}
    .testimonial-form button[type=submit]{justify-self:start}
    .form-publish-note{font-size:.9rem;line-height:1.55;color:#3f3832;margin:0}
    .form-status{margin:0;font-size:.95rem}.form-status.error{color:#a3301a}
    .photo-field{display:grid;gap:.5rem;justify-items:start}
    .photo-field>label{color:#3f3832;font-size:.76rem;letter-spacing:.08em;text-transform:uppercase}
    .photo-field input[type=file]{width:100%;border:1px solid rgba(25,19,15,.14);border-radius:12px;background:rgba(255,255,255,.75);padding:.7rem;font-size:.9rem}
    .photo-field.js-photos input[type=file]{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    .photo-add{display:inline-flex;align-items:center;gap:.5rem;min-height:46px;padding:.7rem 1.2rem;border:1.5px dashed rgba(140,77,57,.55);border-radius:12px;background:rgba(255,255,255,.75);color:var(--accent-dark,#5c2d21);font:600 .9rem/1.2 Inter,Arial,sans-serif;cursor:pointer}
    .photo-add span[aria-hidden]{font-size:1.25rem;line-height:1}
    .photo-add:hover{border-color:var(--cta,#d34220);background:#fffaf4}
    .photo-add:focus-visible{outline:3px solid var(--cta,#d34220);outline-offset:3px}
    .photo-add[hidden]{display:none}
    .photo-count{margin:0;font-size:.85rem;color:var(--muted)}.photo-count:empty{display:none}
    .photo-previews{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0;margin:-6px 0 0}.photo-previews:empty{display:none}
    .photo-previews li{position:relative;width:92px}
    .photo-previews img,.photo-previews .no-preview{width:92px;height:92px;object-fit:cover;border-radius:10px;display:grid;place-items:center;background:#e8dfd3;font-size:.7rem;text-align:center;color:var(--muted)}
    .photo-previews button{position:absolute;top:4px;right:4px;width:30px;height:30px;border-radius:50%;border:0;background:rgba(29,26,23,.78);color:#fff;font-size:1.1rem;line-height:1;cursor:pointer}
    .photo-previews button:focus-visible{outline:3px solid var(--cta);outline-offset:2px}
    .video-field{position:relative;border:0;padding:0;margin:0;display:grid;gap:.5rem;justify-items:start;min-width:0}
    /* Hidden video file inputs: beat .contact-form input{width:100%;padding} so they stay 1px, clipped inside the field (was 44px of sideways scroll at 375px). */
    .testimonial-form input.visually-hidden{top:0;left:0;width:1px;height:1px;min-width:0;padding:0;border:0}
    .video-field legend{padding:0;margin-bottom:.5rem;color:#3f3832;font-size:.76rem;letter-spacing:.08em;text-transform:uppercase}
    .video-buttons{display:flex;flex-wrap:wrap;gap:10px}
    .video-selected{display:flex;gap:14px;align-items:center;flex-wrap:wrap;width:100%}
    .video-selected video{width:140px;height:140px;object-fit:cover;border-radius:12px;background:#1d1a17}
    .video-selected-info{display:grid;gap:4px;font-size:.9rem;min-width:0}.video-selected-info strong{overflow-wrap:anywhere}
    .video-remove{justify-self:start;border:0;background:none;padding:6px 0;color:#a3301a;text-decoration:underline;text-underline-offset:3px;font:inherit;cursor:pointer}
    .video-progress{display:grid;gap:4px;width:100%}.video-progress progress{width:100%;height:12px;accent-color:var(--cta,#d34220)}
    .video-progress span{font-size:.85rem;color:var(--muted)}
    .video-consent{display:grid;gap:10px;width:100%}.video-consent .field-help a{text-decoration:underline}
    [data-video-only][hidden],.video-field [hidden]{display:none!important}
    .testimonial-video{margin:0 0 12px}
    .testimonial-video video{display:block;width:100%;max-height:75vh;border-radius:9px;background:#1d1a17}
    .testimonial-video .video-fallback{font-size:.82rem;color:var(--muted);margin:6px 0 0}
    .form-thanks{background:#fffcf6;border:1px solid var(--line);border-radius:22px;padding:1.5rem;line-height:1.7}.form-thanks h3{font:600 2rem/1.1 "Cormorant Garamond",serif;margin:0 0 8px}
    /* Owner convenience link: bottom of the content, right-aligned, small and low-contrast gray (not an overlay). */
    .testimonial-manager-link{display:flex;justify-content:flex-end;margin:40px 0 0}
    .testimonial-manager-link a{display:inline-block;padding:3px 9px;border:1px solid #ddd8d1;border-radius:6px;color:#a8a29b;font:400 .7rem/1.4 Inter,Arial,sans-serif;letter-spacing:.02em;text-decoration:none}
    .testimonial-manager-link a:hover,.testimonial-manager-link a:focus-visible{color:#77716a;border-color:#c9c3bb}
    .testimonial-manager-link a:focus-visible{outline:2px solid #9a948d;outline-offset:2px}
    @media(max-width:860px){.testimonial-share{grid-template-columns:1fr;gap:20px}}
    @media(max-width:640px){.testimonials-page{padding-top:32px}.testimonial-form .field-row{grid-template-columns:1fr}.testimonial-form button[type=submit]{justify-self:stretch}}
  </style>
  <script src="../scripts/testimonials-page.js"></script>
</body>
</html>
