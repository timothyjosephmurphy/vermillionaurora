---
import PolicyLayout from '../../layouts/PolicyLayout.astro';
---
<PolicyLayout title="Testimonial moderation" description="Owner review of collector testimonials before they are published." noindex>
<p>Owner access only. Enter the commission management credential (the Worker’s <code>COMMISSION_MANAGER_TOKEN</code>). It stays in memory for this page and is never saved or put in a link.</p>
<form id="tm-login"><label>Management credential <input id="tm-token" type="password" autocomplete="off" required/></label><button class="button button-solid" type="submit">Open testimonials</button></form>
<div id="tm-controls" hidden>
  <button type="button" data-filter="pending" aria-pressed="true">Pending</button><button type="button" data-filter="approved" aria-pressed="false">Published</button><button type="button" data-filter="all" aria-pressed="false">All</button><button type="button" data-filter="social" aria-pressed="false">Videos OK for social media</button>
  <button type="button" id="tm-refresh">Refresh</button><button type="button" id="tm-lock">Lock</button>
</div>
<p id="tm-status" role="status" aria-live="polite"></p>
<div id="tm-records"></div>
<details class="tm-help"><summary>How this works</summary>
<p>New submissions arrive here as <strong>Pending</strong> and you get an email at tj@vermillionaurora.com. Nothing is public until you press <strong>Approve &amp; publish</strong>. Edit the display name, wording, painting, city or map pin first if needed, and untick any photo you don’t want shown. Published testimonials appear on <a href="/testimonials/">/testimonials/</a> and, if they have a pin, on the <a href="/exhibitions/world-map/">exhibitions map</a> within about a minute; no rebuild is needed.</p>
<p><strong>Delete</strong> permanently removes the submission and its photos (use it to reject). <strong>Unpublish</strong> takes a published testimonial down but keeps it here. When you approve with <strong>Send thank-you email</strong> ticked (the default), the site issues their single-use at-cost print code and emails it to them with a short thank-you from you (reply-to tj@tjm.art). Untick it to approve quietly; you can send it later. Each submission gets at most one code and one email, and the code is always shown here. Email is optional on the form: a testimonial sent without one publishes as usual, but no code is issued or sent (the card says “No email, so no code sent”).</p>
<p><strong>Videos</strong> play right on each card (signed links that expire after a few hours; press Refresh if one stops loading). Each video carries the collector’s two separate, optional permissions: <strong>tjm.art</strong> (may be shown on /testimonials/) and <strong>Social media</strong> (may be shared on your social accounts). A video appears on the site only when it is approved, “Show the video on tjm.art” is ticked, and the collector gave the tjm.art permission; without it the video stays private even after approval (their words, if any, can still be published, and the thank-you email and print code work as usual). <strong>Videos OK for social media</strong> lists approved videos whose owners allowed social sharing, with download links for the marketing side. If a collector asks to take a video down, use the withdraw buttons on their card (or Delete to remove everything). iPhone videos recorded in HEVC may not play in Chrome or Firefox; download them or use Safari. Recording locations are blanked from video files on upload. Videos on testimonials that stay unapproved are deleted after 90 days.</p>
<p>Photos have location (GPS) and other EXIF metadata removed on upload. HEIC photos that the visitor’s browser could not convert are kept private and can’t be published.</p>
</details>
<style is:global>
.policy-page .tm-card{display:grid;gap:12px}
.tm-card .tm-meta{font-size:.9rem;color:#5e554d;margin:0}
.tm-card label{display:grid;gap:4px;font-size:.85rem}
.tm-card input[type=text],.tm-card input[type=number],.tm-card textarea{width:100%;padding:10px;border:1px solid #bcb4a8;border-radius:8px;font:inherit}
.tm-card textarea{min-height:120px}
.tm-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.tm-photos{display:flex;flex-wrap:wrap;gap:12px;list-style:none;padding:0;margin:0}
.tm-photos li{width:150px;font-size:.78rem}.tm-photos img{width:150px;height:150px;object-fit:cover;border-radius:8px;display:block;background:#e8dfd3}
.tm-photos label{display:flex;gap:6px;align-items:center;margin-top:4px}
.tm-badge{display:inline-block;padding:2px 10px;border-radius:12px;font-size:.75rem;font-weight:600;background:#efe0cd}.tm-badge.approved{background:#2f8a4c;color:#fff}
.tm-code{background:#fffcf6;border:2px dashed #2f8a4c;border-radius:10px;padding:12px}.tm-code code{font-size:1.2rem;font-weight:700}
#tm-controls button[aria-pressed=true]{background:#1d1a17;color:#fff}
.tm-quote{white-space:pre-line;font-style:italic}
.tm-send{font-weight:600}
.tm-pinrow{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.tm-pinrow label{display:block}
.tm-video{display:grid;gap:8px;background:#f6efe5;border-radius:10px;padding:12px}
.tm-video video{width:100%;max-width:520px;max-height:70vh;border-radius:8px;background:#1d1a17}
.tm-consent{display:flex;flex-wrap:wrap;gap:8px;margin:0}
.tm-yes,.tm-no{display:inline-block;padding:3px 10px;border-radius:12px;font-size:.8rem;font-weight:600}
.tm-yes{background:#2f8a4c;color:#fff}.tm-no{background:#e7d6d0;color:#7a2a17}
.tm-video label{display:flex;gap:6px;align-items:center}
.tm-social{width:100%;border-collapse:collapse;font-size:.88rem;margin:0 0 18px}.tm-social th,.tm-social td{border-bottom:1px solid #d7ccba;padding:6px 8px;text-align:left}
</style>
<script>
const api='/testimonials/api/owner';
const $=id=>document.getElementById(id);
let token='',filter='pending',records=[];
const status=$('tm-status'),list=$('tm-records');
const say=text=>{status.textContent=text;};
async function call(body,blob=false){
  const r=await fetch(api,{method:'POST',cache:'no-store',headers:{'Content-Type':'application/json',Authorization:`Bearer ${token}`},body:JSON.stringify(body)});
  if(!r.ok){const d=await r.json().catch(()=>({}));const e=Error(d.error||`Request failed (${r.status})`);e.data=d;throw e;}
  return blob?r.blob():r.json();
}
const el=(tag,props={},...kids)=>{const n=Object.assign(document.createElement(tag),props);n.append(...kids.filter(k=>k!=null&&k!==false));return n;};
const field=(label,input)=>el('label',{},label,input);
const btn=(label,action,cls='')=>{const b=el('button',{type:'button',textContent:label,className:cls});b.addEventListener('click',async()=>{b.disabled=true;try{await action(b);}catch(e){say(e.message);}finally{b.disabled=false;}});return b;};
const fmt=iso=>iso?new Date(iso).toLocaleString('en-US',{dateStyle:'medium',timeStyle:'short'}):'';
const who=r=>r.name||'A collector (no name given)';
const socialOk=r=>r.status==='approved'&&r.video&&!r.video.expired&&r.video.consent?.social===true;
const mb=n=>`${(n/1048576).toFixed(n<1048576*10?1:0)} MB`;
function render(){
  const shown=records.filter(r=>filter==='all'||(filter==='social'?socialOk(r):r.status===filter));
  const kids=shown.map(card);
  if(filter==='social'&&shown.length){
    const table=el('table',{className:'tm-social'},el('caption',{className:'tm-meta',textContent:'Approved videos whose owners ticked “TJ can share my video on his social media.”'}),
      el('tr',{},...['Name','Painting','Approved','Also on tjm.art','Video'].map(h=>el('th',{textContent:h}))),
      ...shown.map(r=>el('tr',{},el('td',{},el('a',{href:'#'+r.id,textContent:r.published?.name||r.name||'A collector (no name given)'})),el('td',{textContent:r.published?.painting||r.paintingTitle||''}),el('td',{textContent:fmt(r.approvedAt)}),el('td',{textContent:r.public?.video?'Yes':'No'}),el('td',{},r.videoUrls?el('a',{href:r.videoUrls.download,textContent:`Download (${mb(r.video.bytes)})`}):'Unavailable'))));
    kids.unshift(table);
  }
  list.replaceChildren(...kids);
  const pending=records.filter(r=>r.status==='pending').length,approved=records.filter(r=>r.status==='approved').length,social=records.filter(socialOk).length;
  say(`${pending} pending · ${approved} published · ${social} video${social===1?'':'s'} OK for social media${shown.length?'':' · nothing in this view'}`);
}
const yesNo=(ok,label)=>el('span',{className:ok?'tm-yes':'tm-no',textContent:`${label}: ${ok?'allowed':'not allowed'}`});
function card(r){
  const pub=r.published||{};
  const a=el('article',{className:'tm-card',id:r.id});
  const hidden=r.status==='approved'&&r.public&&!(r.public.quote||r.public.video||r.public.photos?.length);
  a.append(el('h2',{},`${who(r)} `,el('span',{className:'tm-badge '+r.status,textContent:r.status==='approved'?(hidden?'Approved · private (not on the site)':'Published'):'Pending'}),r.video?el('span',{className:'tm-badge',textContent:'Video'}):''));
  a.append(el('p',{className:'tm-meta'},`Received ${fmt(r.createdAt)} · `,...(r.email?[el('a',{href:`mailto:${r.email}`,textContent:r.email}),' (private)']:['No email given']),` · ${r.id}`,r.notifiedAt?' · Email alert sent':r.notifyError?` · Email alert failed (${r.notifyError})`:'',r.thanks?.emailedAt?` · Thanked ${fmt(r.thanks.emailedAt)}`:r.thanks?.code?' · Code issued':''));
  const name=el('input',{type:'text',value:'name' in pub?pub.name:r.name,maxLength:80,placeholder:'A collector'});
  const quote=el('textarea',{value:pub.quote??r.quote??'',maxLength:2000});
  const painting=el('input',{type:'text',value:pub.painting??r.paintingTitle??'',maxLength:200});
  const slug=el('input',{type:'text',value:pub.paintingSlug??r.paintingSlug??'',placeholder:'e.g. painting-emergence',maxLength:150});
  const city=el('input',{type:'text',value:pub.city??r.city??'',maxLength:100});
  const pin=pub.pin||(r.geo?[r.geo.lat,r.geo.lng]:null);
  const lat=el('input',{type:'number',step:'0.01',min:-90,max:90,value:pin?pin[0]:''});
  const lng=el('input',{type:'number',step:'0.01',min:-180,max:180,value:pin?pin[1]:''});
  const map=el('input',{type:'checkbox',checked:r.status==='approved'?Boolean(pub.pin):Boolean(pin)});
  const geoNote=el('small',{textContent:r.geo?`Suggested from “${r.city}”: ${r.geo.label}`:(r.city?'No automatic match; use Look up or type coordinates (city centre, 2 decimals).':'No city given.')});
  a.append(el('p',{className:'tm-quote',textContent:r.quote?`“${r.quote}”`:'(No written words; video only.)'}));
  let videoBox=null;
  if(r.video){
    const v=r.video,c=v.consent||{};
    const box=el('div',{className:'tm-video'});
    box.append(el('p',{className:'tm-consent'},yesNo(c.site,'tjm.art'),yesNo(c.social,'Social media'),c.withdrawnAt?el('span',{className:'tm-meta',textContent:`Permission withdrawn ${fmt(c.withdrawnAt)}`}):''));
    if(v.expired)box.append(el('p',{className:'tm-meta',textContent:`Video deleted ${fmt(v.expiredAt)} (unapproved for 90 days).`}));
    else if(r.videoUrls){
      const player=el('video',{controls:true,playsInline:true,preload:'metadata',src:r.videoUrls.video});
      if(r.videoUrls.poster)player.poster=r.videoUrls.poster;
      const note=el('p',{className:'tm-meta',textContent:`${mb(v.bytes)}${v.duration?` · ${Math.floor(v.duration/60)}:${String(v.duration%60).padStart(2,'0')}`:''} · ${v.originalName||v.type}`});
      player.addEventListener('error',()=>{note.textContent+=' · This browser can’t play this video (likely iPhone HEVC). Download it or open this page in Safari.';});
      box.append(player,el('p',{className:'tm-meta'},note,' ',el('a',{href:r.videoUrls.download,textContent:'Download video'})));
    }
    videoBox=el('input',{type:'checkbox',checked:c.site===true&&(r.status==='approved'?pub.video===true:true),disabled:c.site!==true});
    box.append(el('label',{},videoBox,c.site?' Show the video on tjm.art':' Show the video on tjm.art (not allowed by the collector; it stays private)'));
    const withdraw=el('p',{className:'tm-meta'});
    if(c.site)withdraw.append(btn('Collector withdrew tjm.art permission',async()=>{if(!confirm('Record that the collector no longer allows the video on tjm.art? It comes off the site now.'))return;await call({action:'withdrawVideoConsent',id:r.id,site:true});await load();say('tjm.art permission withdrawn.');}),' ');
    if(c.social)withdraw.append(btn('Collector withdrew social-media permission',async()=>{if(!confirm('Record that the collector no longer allows the video on social media? (Remove any posts you already made.)'))return;await call({action:'withdrawVideoConsent',id:r.id,social:true});await load();say('Social-media permission withdrawn.');}));
    if(withdraw.childNodes.length)box.append(withdraw);
    a.append(box);
  }
  a.append(field('Display name',name),field('Testimonial text (as published)',quote));
  a.append(el('div',{className:'tm-row'},field('Painting title',painting),field('Painting page slug (links to /products/<slug>/)',slug)));
  a.append(el('div',{className:'tm-row'},field('City, state, country',city),field('Pin latitude',lat),field('Pin longitude',lng)));
  a.append(el('div',{className:'tm-pinrow'},el('label',{},el('span',{},map,' Show a pin on the exhibitions map')),btn('Look up',async()=>{const {geo}=await call({action:'geocode',city:city.value});if(!geo){say('No match for that place.');return;}lat.value=geo.lat;lng.value=geo.lng;map.checked=true;geoNote.textContent=`Found: ${geo.label}`;})),geoNote);
  const photoBoxes=[];
  if(r.photos.length){
    const ul=el('ul',{className:'tm-photos'});
    for(const p of r.photos){
      const img=el('img',{alt:`Photo ${p.n+1} from ${who(r)}`});
      call({action:'photo',id:r.id,n:p.n},true).then(b=>{img.src=URL.createObjectURL(b);}).catch(()=>{img.alt='Preview unavailable';});
      const box=el('input',{type:'checkbox',checked:p.publishable&&(r.status!=='approved'||(pub.photos||[]).includes(p.n)),disabled:!p.publishable});box.dataset.n=p.n;photoBoxes.push(box);
      ul.append(el('li',{},img,el('label',{},box,p.publishable?' Publish':' Private (HEIC)'),el('span',{textContent:`${Math.round(p.bytes/1024)} KB${p.removed?.length?' · removed: '+p.removed.join(', '):''}`})));
    }
    a.append(ul);
  } else a.append(el('p',{className:'tm-meta',textContent:'No photos.'}));
  const actions=el('div',{}),out=el('div',{});
  const t=r.thanks||{},noEmail=!r.email;
  const sendBox=el('input',{type:'checkbox',checked:!t.emailedAt});
  const approve=()=>call({action:'approve',id:r.id,name:name.value,quote:quote.value,painting:painting.value,paintingSlug:slug.value.trim(),city:city.value,lat:lat.value,lng:lng.value,map:map.checked,video:videoBox?videoBox.checked:undefined,sendThanks:r.status==='pending'&&!noEmail?sendBox.checked:false,photos:photoBoxes.filter(b=>b.checked).map(b=>Number(b.dataset.n))});
  const report=d=>{const x=d.thanks||{};return [x.issued?'Print code issued.':'',x.emailed?`Thank-you email sent to ${r.email}.`:'',x.emailSkipped||'',x.error||''].filter(Boolean).join(' ');};
  if(noEmail)a.append(el('p',{className:'tm-meta tm-no-email',textContent:'No email, so no code sent.'}));
  if(r.status==='pending'){
    if(!t.emailedAt&&!noEmail)a.append(el('label',{className:'tm-send'},el('span',{},sendBox,` Send thank-you email with their at-cost print code to ${r.email}`)));
    actions.append(btn('Approve & publish',async()=>{const d=await approve();await load();say(`Published ${who(r)}’s testimonial. ${report(d)}`);},'button button-solid'));
  } else {
    actions.append(btn('Save changes',async()=>{await approve();await load();say('Saved.');}));
    actions.append(btn('Unpublish',async()=>{await call({action:'unpublish',id:r.id});await load();say('Unpublished; it is back in Pending.');}));
    if(!t.code&&!noEmail)actions.append(btn('Issue print code (no email)',async()=>{const d=await call({action:'issueCode',id:r.id});await load();say(report(d)||'Code ready.');}));
    if(!t.emailedAt&&!noEmail)actions.append(btn(t.code?'Send thank-you email':'Issue code & send thank-you email',async()=>{
      if(!confirm(`Email ${r.name||'(no name)'} <${r.email}> their thank-you note and print code now?`))return;
      let d;try{d=await call({action:'sendThanks',id:r.id});}catch(e){if(/unknown result/.test(e.message)&&confirm(e.message)){d=await call({action:'sendThanks',id:r.id,force:true});}else throw e;}
      await load();say(report(d));}));
  }
  if(t.code)out.append(el('div',{className:'tm-code'},el('p',{},'Print code: ',el('code',{textContent:t.code})),
    el('p',{className:'tm-meta',textContent:`Issued ${fmt(t.issuedAt)}. Single use, prints only, at print-lab cost plus shipping. `+(t.emailedAt?`Thank-you email sent ${fmt(t.emailedAt)}.`:t.emailError?`Email failed: ${t.emailError}.`:'Not emailed yet.')}),
    btn('Copy code',async()=>{await navigator.clipboard.writeText(t.code);say('Code copied.');})));
  actions.append(btn('Delete (reject)',async()=>{if(!confirm(`Permanently delete ${who(r)}’s testimonial, photos${r.video?' and video':''}?`))return;await call({action:'delete',id:r.id,confirm:r.id});await load();say('Deleted.');}));
  a.append(actions,out);
  return a;
}
async function load(){const d=await call({action:'list'});records=d.records;render();$('tm-controls').hidden=false;}
$('tm-login').addEventListener('submit',async e=>{e.preventDefault();token=$('tm-token').value;$('tm-token').value='';say('Loading…');try{await load();$('tm-login').hidden=true;}catch(err){token='';say(err.message);}});
document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));render();}));
$('tm-refresh').addEventListener('click',()=>load().catch(e=>say(e.message)));
const lock=()=>{token='';records=[];list.replaceChildren();$('tm-controls').hidden=true;$('tm-login').hidden=false;say('Locked.');};
$('tm-lock').addEventListener('click',lock);window.addEventListener('pagehide',lock);
</script>
</PolicyLayout>
