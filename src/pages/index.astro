---
import BookGalleryCarousel from '../components/BookGalleryCarousel.astro';
import {strawberryPaintings} from '../../catalog/strawberry-point-products.mjs';
const sp12=strawberryPaintings.find(p=>p.index===12);
import strawberryProducts,{STRAWBERRY_SIZES,strawberryId} from '../../catalog/strawberry-point-products.mjs';
// Hero card: cycles only through the Strawberry Point Backpacking Trip paintings, largest first (unsized ones last).
const spSize=p=>STRAWBERRY_SIZES[p.index]?.[0]||0;
const spHero=[...strawberryPaintings].sort((a,b)=>spSize(b)-spSize(a)||a.index-b.index).map(p=>({p,pr:strawberryProducts.find(x=>x.id===strawberryId(p))})).filter(x=>x.pr);
const spSrcset=d=>d.widths.map(w=>`${d.base}-${w}.webp ${w}w`).join(', ');
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProductCard from '../components/ProductCard.astro';
import PrintWallCard from '../components/PrintWallCard.astro';
import GalleryRoomCard from '../components/GalleryRoomCard.astro';
import ExhibitionMap from '../components/ExhibitionMap.astro';
import { byId, catalogVersion, urlFor, priceLabel, statusLabel } from '../../catalog/catalog.mjs';
import collections from '../../catalog/collections.json';
const homePaintings=collections.home.filter(entry=>entry.variant==='carousel').map(entry=>byId[entry.product]).filter(product=>product?.type==='painting');
// Featured works: highest original price first, ties by title; prints-only paintings last by lowest print price.
const originalPrice=product=>{const amount=Number(product.listing?.price?.amount);return amount>0?amount:null;};
const byFeaturedPrice=(a,b)=>{const pa=originalPrice(a),pb=originalPrice(b);if(pa!==null||pb!==null){if(pa===null)return 1;if(pb===null)return -1;if(pa!==pb)return pb-pa;}else{const qa=lowestPrintPrice(a)??Infinity,qb=lowestPrintPrice(b)??Infinity;if(qa!==qb)return qa-qb;}return a.title.localeCompare(b.title,'en');};
const sortedAvailable=homePaintings.filter(product=>['available','inquiry'].includes(product.listing?.status)).sort(byFeaturedPrice);
// Manual overrides applied after the price sort: [productToMove, productItGoesDirectlyBefore].
const featuredPlaceBefore=[['archived-painting-436','archived-painting-433']];
const availablePaintings=featuredPlaceBefore.reduce((list,[move,before])=>{const item=list.find(p=>p.id===move);if(!item||!list.some(p=>p.id===before))return list;const rest=list.filter(p=>p!==item);rest.splice(rest.findIndex(p=>p.id===before),0,item);return rest;},sortedAvailable);
// No item limit: every qualifying home painting is shown in its carousel.
const collectorPaintings=homePaintings.filter(product=>!['available','inquiry'].includes(product.listing?.status));
const collectorPreview=collectorPaintings;
const featured=availablePaintings[0]||homePaintings[0];
import displayImages from '../../scripts/display-images.json';
import {tjWall} from '../data/paintings-wall.mjs';
// Hero background: a slow crossfade through the wide (landscape, >= 1.6:1) Featured works. Slide 1 stays the
// Hope hero image (the LCP); the rest load one at a time, only just before they are shown.
const HERO_FIRST='/display/esperanza-hero-aba277665d-1134.webp';
const landscapeRatio=p=>{const i=p.image||{};if(i.width&&i.height)return i.width/i.height;const d=p.dimensions;return d?d.width/d.height:0;};
const heroSrc=p=>{const f=p.image?.fullSrc||p.image?.src||'';if(f.startsWith('/display/'))return f;const e=displayImages[f];const v=e?.variants?.filter(x=>x.w<=1920).at(-1);return v?.src||null;};
const heroSlides=[HERO_FIRST,...availablePaintings.filter(p=>p.id!=='hope-the-vermillion-aurora'&&landscapeRatio(p)>=1.6).map(heroSrc).filter(Boolean)];
import { person, website, ld } from '../data/structured-data.mjs';
import { printsFromLabel, showBuy, lowestPrintPrice } from '../data/card-commerce.mjs';
---
<!DOCTYPE html><html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script type="application/ld+json" set:html={ld(person)} />
    <script type="application/ld+json" set:html={ld(website)} />
    <title>TJ Murphy | Seattle Watercolor Artist — Paintings, Murals &amp; Commissions</title>
    <meta name="description" content="Paintings and murals by TJ Murphy, celebrating natural beauty and self-sovereignty through Pacific Northwest landscapes, expressive portraits, and a limited palette.">
    <!-- Hero background is the LCP element; keep this URL in sync with .hero-background in styles.css. -->
    <link rel="preload" as="image" type="image/webp" href="/display/esperanza-hero-aba277665d-1134.webp" fetchpriority="high">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="/featured-carousel/carousel.css">
  <link rel="stylesheet" href="/home-compact.css">
  <link rel="stylesheet" href="/portrait-preview.css"><link rel="stylesheet" href="/site-header.css">
<meta name="catalog-version" content={catalogVersion} />  <style is:global>
    .commission-mix{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:center;max-width:980px;margin:0 auto}
    .commission-mix-carousel{max-width:460px;width:100%;margin:0 auto}
    .commission-mix-copy h3{font:600 1.8rem/1.2 "Cormorant Garamond",serif;margin:0 0 10px}
    .commission-mix-prices{list-style:none;padding:0;margin:12px 0;line-height:1.9}
    .commission-mix-prices a{text-decoration:underline;text-underline-offset:3px}
    @media(max-width:760px){.commission-mix{grid-template-columns:1fr;gap:20px}}
  </style>
</head>
  <body class="home-page">
    <div class="page-shell">
      <section class="wall-peek" id="painting-wall-peek" aria-label="The Painting Wall">
        <a href="/gallery/wall/all/" class="wall-peek-link">
          <span class="wall-peek-frame"><img data-wall-src="/gallery-wall/framed-wall.webp" width="1600" height="880" alt="TJ Murphy’s framed paintings arranged on the painting wall" decoding="async"/></span>
          <span class="wall-peek-text"><span class="wall-peek-eyebrow">Above the studio</span><span class="wall-peek-title">The Painting Wall</span><span class="wall-peek-sub">{tjWall.artworks.length} paintings at true size · Walk the wall →</span></span>
        </a>
      </section>
      <script is:inline>
        // Land on the usual top content: the wall sits above it and is revealed by scrolling up.
        // Only on a fresh navigation without a #fragment; reloads and back/forward keep the browser's position.
        (function(){var w=document.getElementById('painting-wall-peek');if(!w)return;var n=(performance.getEntriesByType&&performance.getEntriesByType('navigation')[0])||{};
          if(location.hash||(n.type&&n.type!=='navigate')||window.scrollY>2)return;var h=w.offsetHeight,de=document.documentElement;
          de.style.minHeight=(h+innerHeight+2)+'px';window.scrollTo({top:h,left:0,behavior:'instant'});
          document.addEventListener('DOMContentLoaded',function(){de.style.minHeight='';},{once:true});})();
      </script>
      <SiteHeader />

      <main id="main-content">
        <section class="hero" id="top">
          <div class="hero-background hero-slideshow" aria-hidden="true" data-hero-slides={JSON.stringify(heroSlides.slice(1))}><img class="hero-slide is-active" src={HERO_FIRST} alt="" fetchpriority="high" decoding="async"/><img class="hero-slide" alt="" decoding="async"/></div>
          <a class="hero-room-link" href="/gallery/room/">Explore the 3D gallery</a>
          <div class="container hero-grid">
            <div class="hero-copy">
              <p class="eyebrow">Seattle watercolor &amp; pastel artist · Inspiring self-sovereignty</p>
              <h1>Natural beauty. Independent spirit.</h1>
              <p class="lede">
                I paint the changing light of the Pacific Northwest, the places I travel, and the character of the people I meet. My work celebrates natural beauty and self-sovereignty, the freedom to think, create, and shape a life of your own.
              </p>
              <div class="hero-actions hero-actions-centered">
                <a href="/gallery/" class="button button-solid">Explore the paintings</a>
              </div>
            </div>

            <div class="hero-panel" aria-label="Featured artwork panel">
              <div class="art-card featured-art">
                <a href={`/products/${strawberryId(spHero[0].p)}/`} aria-label={`View ${spHero[0].pr.title}`}><img src={`${spHero[0].p.display.base}-480.webp`} alt={spHero[0].pr.title}/></a>
              </div>
              <ul class="sp-hero-source" hidden>
                {spHero.map(({p,pr})=><li class="product-card" data-sp-id={pr.id} data-buy="false"><a class="product-title-link" href={`/products/${pr.id}/`}>{pr.title}</a><img src={`${p.display.base}-480.webp`} srcset={spSrcset(p.display)} alt="" loading="lazy"/><div class="product-info"><p>{`Watercolor pastel · ${pr.listing?.status==='available'?priceLabel(pr):statusLabel(pr)}`}</p></div></li>)}
              </ul>
            </div>
          </div>
        </section>

        <section id="gallery" class="section section-light">
          <div class="container">
            <div class="section-heading">
              <h2>Featured works</h2>
            </div>
            <div class="painting-discovery-actions"><a href="/gallery/available/" class="button button-solid">Shop available paintings</a><a href="/gallery/" class="button button-ghost">Browse the full gallery</a></div>
            {/* The empty-state text is only in the HTML when it is true; availability.js fills it in if live stock empties the track. */}
            <p class="painting-empty-message" data-available-empty hidden={availablePaintings.length > 0}>{availablePaintings.length === 0 && 'No original paintings are available right now. Browse the collector’s items or ask about a commission.'}</p>
            <div class="ex-carousel painting-carousel available-paintings-carousel" data-painting-group="available" role="region" aria-roledescription="carousel" aria-label="Featured works">
              <div class="ex-track" data-available-paintings tabindex="0" aria-label="Swipe or use arrow keys to browse featured works">{availablePaintings.map((product,index)=><ProductCard product={product} variant="carousel" priority={index===0} />)}<article class="product-card card-tile ex-slide gallery-feature-tile" data-gallery-feature="strawberry-point" data-buy="false"><a href="/gallery/strawberry-point/" class="gallery-product-image" aria-label="Explore the Strawberry Point Backpacking Trip gallery"><img src={`${sp12.display.base}-480.webp`} srcset={`${sp12.display.base}-480.webp 480w, ${sp12.display.base}-960.webp 960w`} sizes="(max-width: 980px) 80vw, 340px" width={sp12.display.width} height={sp12.display.height} alt="Strawberry Point Backpacking Trip #12, a painting by TJ Murphy" loading="lazy" decoding="async" style="object-fit:contain"/></a><div class="product-info ex-slide-caption"><h3><a href="/gallery/strawberry-point/" class="product-title-link">Strawberry Point Backpacking Trip</a></h3><p>{strawberryPaintings.length} watercolor pastels · A gallery from the Olympic Peninsula</p><p class="card-buy-row"><span>Originals from $75 · Explore →</span></p></div></article></div>
              <div class="ex-controls" hidden=""><button type="button" class="ex-autoplay" aria-label="Pause automatic available paintings scrolling">Pause</button><button type="button" data-direction="-1" aria-label="Previous available painting">←</button><p class="ex-position" role="status">1 / {availablePaintings.length}</p><button type="button" data-direction="1" aria-label="Next available painting">→</button><a href="/gallery/available/" class="button button-solid carousel-view-all">View available paintings</a></div>
            </div>
            <noscript><p><a href="/gallery/available/">Shop available paintings</a></p></noscript>
          </div>
        </section>

        <section id="collectors-items" class="section section-light">
          <div class="container">
            <div class="section-heading">
              <h2>Collector’s Items</h2>
              <p>Sold and unavailable works from the collection.</p>
            </div>
            <p class="painting-empty-message" data-collector-empty hidden={collectorPreview.length > 0}>{collectorPreview.length === 0 && 'There are no sold or unavailable works in this selection right now.'}</p>
            <div class="ex-carousel painting-carousel collector-items-carousel" data-painting-group="collectors" role="region" aria-roledescription="carousel" aria-label="Collector’s Items">
              <div class="ex-track" data-collector-paintings tabindex="0" aria-label="Swipe or use arrow keys to browse collector’s items">{collectorPreview.map(product=><ProductCard product={product} variant="carousel" />)}</div>
              <div class="ex-controls" hidden=""><button type="button" class="ex-autoplay" aria-label="Pause automatic collector’s items scrolling">Pause</button><button type="button" data-direction="-1" aria-label="Previous collector’s item">←</button><p class="ex-position" role="status">1 / {collectorPreview.length}</p><button type="button" data-direction="1" aria-label="Next collector’s item">→</button><a href="/gallery/" class="button button-solid carousel-view-all">Browse the full gallery</a></div>
            </div>
            <p class="testimonial-cta"><a href="/testimonials/">Own one of my paintings? Share your story <span aria-hidden="true">→</span></a></p>
          </div>
        </section>

        <BookGalleryCarousel />
        <section id="exhibitions" class="section section-light"><div class="container"><div class="section-heading"><h2>Exhibitions</h2></div><div class="ex-carousel" role="region" aria-roledescription="carousel" aria-label="Exhibitions"><div class="ex-track" tabindex="0" aria-label="Swipe or use arrow keys to browse exhibitions"><article class="ex-slide product-card" aria-label="1 of 10"><a href="/exhibitions/world-map/"><ExhibitionMap compact /><div class="ex-slide-caption product-info"><h3>Exhibitions Around the World</h3><p>Explore the map · Seattle &amp; beyond →</p></div></a></article><article class="ex-slide product-card" aria-label="2 of 10"><a href="/exhibitions/intiman-auction/"><img src="https://media.vermillionaurora.com/images/Ex-Intiman-Auction/IMG_4483.jpeg" alt="Intiman Theater Seattle Auction exhibition" loading="lazy"><div class="ex-slide-caption product-info"><h3>Intiman Theater Seattle Auction</h3><p>2023 · View exhibition →</p></div></a></article><article class="ex-slide product-card" aria-label="3 of 10"><a href="/exhibitions/cape-town/"><img src="https://media.vermillionaurora.com/images/Ex-Cape-Town/IMG_9174.jpeg" alt="Adopting Bitcoin Cape Town, South Africa exhibition" loading="lazy"><div class="ex-slide-caption product-info"><h3>Adopting Bitcoin Cape Town, South Africa</h3><p>2025 · View exhibition →</p></div></a></article><article class="ex-slide product-card" aria-label="4 of 10"><a href="/exhibitions/el-salvador/"><img src="https://media.vermillionaurora.com/images/Ex-El-Salvador/IMG_5441.jpeg" alt="Adopting Bitcoin El Salvador exhibition" loading="lazy"><div class="ex-slide-caption product-info"><h3>Adopting Bitcoin El Salvador</h3><p>2024 · View exhibition →</p></div></a></article><article class="ex-slide product-card" aria-label="5 of 10"><a href="/exhibitions/living-room/"><img src="/exhibitions/living-room/images/three-landscapes-in-living-room.jpg" alt="Three framed watercolor landscapes hanging side by side in a living room" loading="lazy" style="object-fit:contain;background:#e8dfd3"><div class="ex-slide-caption product-info"><h3>My Living Room, Seattle, Washington</h3><p>Current · View exhibition →</p></div></a></article><article class="ex-slide product-card" aria-label="6 of 10"><a href="/exhibitions/studio-601/"><img src="/exhibitions/studio-601-hero.png" alt="Studio 601, Seattle, Washington exhibition" loading="lazy"><div class="ex-slide-caption product-info"><h3>Studio 601, Seattle, Washington</h3><p>2023 · View exhibition →</p></div></a></article><article class="ex-slide product-card" aria-label="7 of 10"><a href="/exhibitions/victrola/"><img src="/exhibitions/victrola-hero.png" alt="Victrola Coffee Shop, Seattle, Washington exhibition" loading="lazy"><div class="ex-slide-caption product-info"><h3>Victrola Coffee Shop, Seattle, Washington</h3><p>2025 · View exhibition →</p></div></a></article><article class="ex-slide product-card" aria-label="8 of 10"><a href="/exhibitions/bitcoin-film-festival-warsaw/"><img src="/exhibitions/bitcoin-film-festival-warsaw/images/display-at-kinoteka.jpeg" alt="Three paintings displayed outside the Kinoteka theater for Bitcoin Film Festival" loading="lazy"><div class="ex-slide-caption product-info"><h3>Bitcoin Film Festival Warsaw, Poland</h3><p>2026 · Kinoteka · Palace of Culture and Science</p></div></a></article><GalleryRoomCard /><PrintWallCard /></div><div class="ex-controls" hidden=""><button type="button" class="ex-autoplay" aria-label="Pause automatic exhibition scrolling">Pause</button><button type="button" data-direction="-1" aria-label="Previous exhibition">←</button><p class="ex-position" role="status">1 / 10</p><button type="button" data-direction="1" aria-label="Next exhibition">→</button><a href="/exhibitions/" class="button button-solid carousel-view-all">View all exhibitions</a></div></div></div></section>

        <section id="murals" class="section section-shop">
          <div class="container">
            <div class="section-heading"><h2>Murals</h2></div>
            <div class="ex-carousel mural-carousel" role="region" aria-roledescription="carousel" aria-label="Murals">
              <div class="ex-track" tabindex="0" aria-label="Swipe or use arrow keys to browse murals">
                <article class="ex-slide product-card" aria-label="1 of 3"><a href="/murals/#garden-mural"><img src="/murals/images/cormorant-hero-hires.jpg" alt="Cormorant mural: orange sunset over Puget Sound, with a bird and sailboats" loading="lazy"><div class="ex-slide-caption product-info"><h3>Cormorant Presiding over Sunset on Puget Sound</h3><p>Garden mural · Seattle</p></div></a></article>
                <article class="ex-slide product-card" aria-label="2 of 3"><a href="/murals/#friends-story"><img src="/murals/images/3886996e.jpg" alt="Completed Friends Club shipping-container mural" loading="lazy"><div class="ex-slide-caption product-info"><h3>Friends Club</h3><p>Festival mural · Lillooet, BC</p></div></a></article>
                <article class="ex-slide product-card" aria-label="3 of 3"><a href="/murals/berlin-el-salvador/"><img src="/murals/images/berlin-el-salvador/hero.jpeg" style="object-fit:contain;background:#e8dfd3" alt="Orange Berlín El Salvador sign displayed at the basketball court" loading="lazy"><div class="ex-slide-caption product-info"><h3>Berlin, El Salvador</h3><p>Bitcoin Festival · Community mural</p></div></a></article>
              </div>
              <div class="ex-controls" hidden=""><button type="button" class="ex-autoplay" aria-label="Pause automatic mural scrolling">Pause</button><button type="button" data-direction="-1" aria-label="Previous mural">←</button><p class="ex-position" role="status">1 / 3</p><button type="button" data-direction="1" aria-label="Next mural">→</button><a href="/murals/" class="button button-solid carousel-view-all">View all murals</a></div>
            </div>
          </div>
        </section>

        <section id="books" class="section section-shop">
          <div class="container">
            <div class="section-heading"><h2>Art books &amp; illustrated poetry</h2><p><a href="/books/" style="text-decoration:underline;text-underline-offset:.2em">Browse all books →</a></p></div>
            <div class="ex-carousel book-carousel" role="region" aria-roledescription="carousel" aria-label="Books">
              <div class="ex-track" tabindex="0" aria-label="Swipe or use arrow keys to browse books">
              {collections.home.filter(entry=>entry.variant==='book').map(entry=><ProductCard product={byId[entry.product]} variant={entry.variant} />)}
</div>
              <div class="ex-controls" hidden=""><button type="button" class="ex-autoplay" aria-label="Pause automatic book scrolling">Pause</button><button type="button" data-direction="-1" aria-label="Previous book">←</button><p class="ex-position" role="status">1 / 3</p><button type="button" data-direction="1" aria-label="Next book">→</button></div>
            </div>
          </div>
        </section>

        <section id="services" class="section section-contrast">
          <div class="container">
            <div class="section-heading narrow">
              
              <h2>Commissions</h2>
              <p><a href="/commissions/" style="text-decoration:underline;text-underline-offset:.2em">View packages, FAQ &amp; form →</a> · <a href="/commissions/process/" style="text-decoration:underline;text-underline-offset:.2em">How I create your painting →</a></p>
            </div>

            <div class="commission-mix">
              <div class="portrait-preview commission-mix-carousel" data-portrait="commissions-mix" data-mix="small-landscape,single-portrait,double-portrait" aria-label="Commission examples: landscapes and portraits">
                <a class="portrait-preview-stage" href="/commissions/"><img src={byId['small-landscape'].examples[0].src} alt={byId['small-landscape'].examples[0].alt} loading="lazy" /></a>
              </div>
              <div class="commission-mix-copy">
                <h3>Landscapes &amp; portraits, painted for you</h3>
                <p>A meaningful place or the people you love, in watercolor pastel.</p>
                <ul class="commission-mix-prices">
                  <li><a href="/commissions/#landscape">Landscapes</a> from ${Math.min(...byId['small-landscape'].options.map(o=>Number(o.amount))).toLocaleString('en-US')}</li>
                  <li><a href="/commissions/#portrait">Portraits</a>, 1–4 faces, from ${Math.min(...byId['single-portrait'].options.map(o=>Number(o.amount))).toLocaleString('en-US')}</li>
                </ul>
                <p class="service-terms">50% deposit to start · Typical turnaround 2–4 weeks</p>
                <a class="button button-solid" href="/commissions/">See packages &amp; start a commission</a>
              </div>
            </div>
          </div>
        </section>

        <section id="featured-artists" class="section section-light">
          <div class="container">
            <div class="section-heading">
              
              <h2>Featured Artists and Collaborations</h2>
            </div>
            <div class="ex-track" aria-label="Featured artists and collaborations">
              <article class="ex-slide product-card"><a href="/exhibitions/paul-murphy/"><img src="https://media.vermillionaurora.com/images/Ex-Featured-Artist-Paul-Murphy/IMG_7409.jpeg" alt="Painting by Paul Murphy" loading="lazy"><div class="ex-slide-caption product-info"><h3>Paul Murphy</h3><p>View featured artist →</p></div></a></article>
              <article class="ex-slide product-card"><a href="/exhibitions/chase-toole/"><img src="/gallery-images/insect-garden.jpg" alt="El Salvador: Past — a collaboration by Chase Toole and TJ Murphy" loading="lazy"><div class="ex-slide-caption product-info"><h3>Chase Toole Collab</h3><p>Three collaborations with TJ Murphy · View gallery →</p></div></a></article>
              <article class="ex-slide product-card"><a href="/exhibitions/gavin-robertson/"><img src="/gallery-images/coined-in-watercolor-film-poster.jpg" alt="Coined in Watercolor film poster by TJ Murphy" loading="lazy" style="object-fit:contain"><div class="ex-slide-caption product-info"><h3>Gavin Robertson Collab</h3><p>Coined in Watercolor · Film and paintings · View gallery →</p></div></a></article>
            </div>
          </div>
        </section>

        <section id="about" class="section section-plain" aria-labelledby="artist-film-heading">
          <div class="container">
            <div class="section-heading">
              
              <h2 id="artist-film-heading">About the Artist &amp; Film</h2>
            </div>
            <div class="artist-film-carousel" role="region" aria-roledescription="carousel" aria-label="Artist profile and film">
              <div id="artist-film-track" class="artist-film-track" tabindex="0" aria-label="Swipe or use arrow keys to browse the artist profile and film">
                <article class="product-card artist-film-card" aria-roledescription="slide" aria-label="1 of 2: About the artist">
                  <a class="artist-film-media artist-film-portrait" href="/about/" aria-label="Meet TJ Murphy">
                    <img src="/about/images/tj-murphy-portrait.jpg" alt="TJ Murphy smiling outdoors in sunglasses and a white shirt" width="424" height="360" loading="lazy" decoding="async">
                  </a>
                  <div class="artist-film-copy">
                    <p class="eyebrow dark">About the artist</p>
                    <h3>TJ Murphy</h3>
                    <p>TJ Murphy is a Seattle-based artist working in watercolor, watercolor pastel, and outdoor acrylic murals. Since 2020, he has explored the changing light of the Pacific Northwest and the expressions that give a portrait its character. His work brings luminous color, rich texture, and close observation to landscapes, portraits, and public spaces.</p>
                    <a href="/about/" class="button button-solid">Meet the artist</a>
                  </div>
                </article>
                <article id="film" class="product-card artist-film-card" aria-roledescription="slide" aria-label="2 of 2: Coined in Watercolor documentary">
                  <div class="artist-film-media artist-film-video">
