<script is:inline src="/catalog/availability.js" defer=""></script>  <style is:global>
    .hero-grid-solo{grid-template-columns:minmax(0,1fr)}
    /* Small Strawberry Point card beside the headline: compact stage, no empty prints/Buy row, clear of the 3D link. */
    .hero .hero-panel{justify-self:end;align-self:center;margin-top:36px}
    .hero .featured-art{width:280px;max-width:280px;padding:12px}
    .hero .featured-stage{--featured-painting-h:250px;--featured-title-size:1.3rem;--featured-caption-pad-top:10px;--featured-caption-pad-bottom:4px;--featured-buy-row-pad-top:0px;--featured-buy-row-h:0px;--featured-caption-slack:.25rem}
    .hero .featured-caption .card-buy-row{display:none}
    .hero-slideshow{background:#2b2420 !important;filter:none !important;overflow:hidden}
    .hero-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 3s ease-in-out;filter:saturate(.85) contrast(1.05)}
    .hero-slide.is-active{opacity:1}
    .hero-slideshow::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,rgba(10,9,9,.62) 0%,rgba(10,9,9,.38) 45%,rgba(10,9,9,.18) 100%)}
    @media (prefers-reduced-motion: reduce){.hero-slide{transition:none}}
    .hero-room-link{position:absolute;top:14px;right:18px;z-index:2;font-size:.78rem;letter-spacing:.04em;color:rgba(255,255,255,.86);text-decoration:none;padding:6px 10px;border-radius:999px;background:rgba(16,14,13,.28)}
    .hero-room-link:hover,.hero-room-link:focus-visible{color:#fff;background:rgba(16,14,13,.5);text-decoration:underline}
    .wall-peek{height:min(78vh,720px);background:#2c2723;display:flex;align-items:center;justify-content:center;overflow:hidden}
    .wall-peek-link{display:flex;flex-direction:column;align-items:center;gap:18px;width:min(1100px,92vw);color:#f4ede4;text-decoration:none}
    .wall-peek-frame{display:block;width:100%;aspect-ratio:1600/880;max-height:calc(min(78vh,720px) - 130px);background:#3a332d;border-radius:4px;overflow:hidden}
    .wall-peek-frame img{width:100%;height:100%;object-fit:contain;display:block}
    .wall-peek-text{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center}
    .wall-peek-eyebrow{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;opacity:.7}
    .wall-peek-title{font:600 2rem/1 'Cormorant Garamond',serif}
    .wall-peek-sub{font-size:.85rem;opacity:.85}
    .wall-peek-link:hover .wall-peek-title{text-decoration:underline}
    @media (max-width:700px){.wall-peek{height:62vh}.wall-peek-frame{max-height:calc(62vh - 120px)}.hero-room-link{top:8px;right:10px;font-size:.72rem}.hero-grid .hero-copy{padding-top:52px}.hero .hero-panel{justify-self:center;margin-top:0}.hero .featured-art{width:min(260px,100%)}.hero .featured-stage{--featured-painting-h:200px;--featured-title-size:1.2rem}}
    /* Homepage carousels: no Pause/arrow/counter controls. Auto-advance continues, pauses on
       hover, focus and touch, and stays off for prefers-reduced-motion (exhibitions.js and
       featured-carousel/carousel.js). Swipe, scroll and keyboard arrows on the track still work. */
    .ex-controls .ex-autoplay, .ex-controls [data-direction], .ex-controls .ex-position, .featured-controls { display: none !important; }
  </style>
