---
import Layout from '../../layouts/BookGalleryLayout.astro';
import manifest from '../../../catalog/book-galleries.json';
import {archivePaintings,archivePreview} from '../../../catalog/archive-products.mjs';
import {olderWorkGroups,olderWorkPreview} from '../../../catalog/older-work-products.mjs';
const olderWorkCount=olderWorkGroups.reduce((n,g)=>n+g.members.length,0);
import {byId} from '../../../catalog/catalog.mjs';
import {config,papers,printOptions} from '../../../catalog/prints.mjs';
import {sectionArtworkIds} from '../../data/canonical-artworks.mjs';
import {wallLabelGalleries} from '../../../catalog/wall-label-galleries.mjs';

const galleryArtworks=[...new Set(manifest.sections.flatMap(sectionArtworkIds))];
const totalPrintReady=galleryArtworks.filter(id=>printOptions(byId[id],config,papers).some(option=>option.ready)).length;
const gallerySummaries=manifest.sections.map(group=>({
  ...group,
  artworks:sectionArtworkIds(group),
  printReadyCount:sectionArtworkIds(group).filter(id=>printOptions(byId[id],config,papers).some(option=>option.ready)).length
}));
const bookTitles=Object.fromEntries(manifest.books.map(book=>[book.id,book.title]));
---

<Layout title="Selected Galleries" description="Explore TJ Murphy’s watercolor landscapes and portraits by book chapter, with selected fine-art prints.">
  <nav aria-label="Breadcrumb"><a href="/">Home</a> / Selected Galleries</nav>
  <header class="book-gallery-intro">
    <p class="eyebrow dark">The book collections</p>
    <h1>Selected Galleries</h1>
    <p class="book-gallery-print-total" data-total-print-ready-count={totalPrintReady}>Travel through the landscapes, people, and stories collected in my watercolor books. {totalPrintReady} distinct works across these galleries currently have fine-art prints available.</p>
  </header>
  <section class="book-gallery-overview" aria-labelledby="browse-galleries-heading">
    <h2 class="book-group-heading" id="browse-galleries-heading">Browse the galleries</h2>
    <ul class="book-gallery-grid book-gallery-carousel-grid" aria-label="Selected Galleries">
      {gallerySummaries.map(group=>{
        const first=byId[group.artworks[0]];
        return <li class="book-gallery-card" data-product={`/book-galleries/${group.id}/`} data-caption={`${bookTitles[group.book]} · ${group.artworks.length} works · ${group.printReadyCount} with fine-art prints`}>
          <a href={`/book-galleries/${group.id}/`}>
            <img src={first.image.src} alt={`${group.title} gallery — ${first.title}`} loading="lazy" decoding="async"/>
            <h3>{group.title}</h3>
            <p data-print-ready-count={group.printReadyCount}>{bookTitles[group.book]} · {group.artworks.length} {group.artworks.length===1?'work':'works'} · {group.printReadyCount} with fine-art prints</p>
          </a>
        </li>;
      })}
      <li class="book-gallery-card" data-product="/gallery/archived/" data-caption={`${archivePaintings.length} paintings from the studio archive`}><a href="/gallery/archived/"><img src={archivePreview(archivePaintings[0],480)} alt="Archived Paintings by TJ Murphy" loading="lazy" decoding="async"/><h3>Archived Paintings</h3><p>{archivePaintings.length} works · From the studio archive</p></a></li>
      <li class="book-gallery-card" data-product="/gallery/older-work/" data-caption={`${olderWorkCount} older paintings from the studio`}><a href="/gallery/older-work/"><img src={olderWorkPreview(olderWorkGroups[0],480)} alt="Older Work by TJ Murphy" loading="lazy" decoding="async"/><h3>Older Work</h3><p>{olderWorkCount} works · From the studio</p></a></li>
    </ul>
  </section>
  <section id="wall-labels" aria-labelledby="wall-label-galleries-heading">
    <h2 class="book-group-heading" id="wall-label-galleries-heading">Wall labels</h2>
    <p>Groups from the studio wall labels. These sit alongside the book chapters above.</p>
    <ul class="book-gallery-grid" aria-label="Wall label galleries">
      {wallLabelGalleries.map(gallery => <li class="book-gallery-card wall-label-card">
        <a href={`/galleries/${gallery.id}/`}>
          <img src={gallery.thumb} alt={`${gallery.title} — studio wall label`} width={gallery.thumbWidth} height={gallery.thumbHeight} loading="lazy" decoding="async" />
          <h3>{gallery.title}</h3>
          <p>Wall label · {gallery.works.length} {gallery.works.length === 1 ? 'work' : 'works'}</p>
        </a>
      </li>)}
    </ul>
  </section>
  <nav class="book-gallery-links" aria-label="Read the watercolor books">
    {manifest.books.map(book=><a href={`/products/${book.id}/`}>Read {book.title} →</a>)}
    <a href="/galleries/">All wall label galleries →</a>
  </nav>
</Layout>
<style is:global>
  .book-gallery-card.wall-label-card img { height: auto; aspect-ratio: 4 / 1; object-fit: contain; background: #111; }
</style>

