---
import Layout from '../../layouts/BookGalleryLayout.astro';
import manifest from '../../../catalog/book-galleries.json';
import {byId,urlFor} from '../../../catalog/catalog.mjs';
import {config,papers,printOptions} from '../../../catalog/prints.mjs';

export function getStaticPaths(){return manifest.sections.map(group=>({params:{section:group.id},props:{group}}));}

const {group:g}=Astro.props;
const book=manifest.books.find(entry=>entry.id===g.book);
const artworks=g.artworks.map(id=>{
  const product=byId[id];
  const source=manifest.artworks.find(art=>art.id===id);
  const options=printOptions(product,config,papers).filter(option=>option.ready);
  return {id,product,source,options};
});
const printReadyCount=artworks.filter(art=>art.options.length>0).length;
---

<Layout title={`${g.title} — ${book.title}`} description={`${g.title}: watercolor artwork from ${book.title} by TJ Murphy.`}>
  <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/book-galleries/">Art book galleries</a> / {g.title}</nav>
  <header class="book-gallery-intro">
    <p class="eyebrow dark">{book.title}</p>
    <h1>{g.title}</h1>
    <p class="book-gallery-stats" data-print-ready-count={printReadyCount}>{artworks.length} {artworks.length===1?'work':'works'} · {printReadyCount} {printReadyCount===1?'has':'have'} fine-art prints available.</p>
    <div class="book-gallery-links">
      <a href={`${book.pdfUrl}#page=${g.startPage}`} target="_blank" rel="noopener noreferrer">See this section in the book ↗</a>
      <a href="/book-galleries/">All book galleries →</a>
    </div>
  </header>

  <section class="ex-carousel book-art-carousel" role="region" aria-roledescription="carousel" aria-label={`${g.title} gallery`}>
    <div class="ex-track" tabindex="0" aria-label={`Swipe or use arrow keys to browse ${g.title}`}>
      {artworks.map(({id,product,source,options},index)=>
        <article class="ex-slide product-card book-art-slide" aria-label={`${index+1} of ${artworks.length}`}>
          <a href={urlFor(product)}>
            <img class="book-art-image" src={product.image.src} alt={product.title} loading={index===0?'eager':'lazy'} decoding="async"/>
            <div class="ex-slide-caption product-info">
              <h3>{product.title}</h3>
              {source?.measurements?.length>0&&<p class="book-art-measurements">{source.measurements.join('; ')}</p>}
              {options.length>0
                ? <p class="print-available">Fine-art prints from ${Math.min(...options.map(option=>Number(option.amount))).toFixed(2)}</p>
                : <p>View artwork →</p>}
            </div>
          </a>
        </article>
      )}
    </div>
    <div class="ex-controls" hidden>
      <button type="button" class="ex-autoplay" aria-label={`Pause automatic ${g.title} scrolling`}>Pause</button>
      <button type="button" data-direction="-1" aria-label="Previous artwork">←</button>
      <p class="ex-position" role="status">1 / {artworks.length}</p>
      <button type="button" data-direction="1" aria-label="Next artwork">→</button>
    </div>
  </section>
</Layout>
