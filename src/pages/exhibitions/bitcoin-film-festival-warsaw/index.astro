---
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
const imageRoot='/exhibitions/bitcoin-film-festival-warsaw/images/';
const photos=[
  {file:'coined-in-watercolor-film-poster.jpg',src:'/gallery-images/coined-in-watercolor-film-poster.jpg',width:724,height:1084,alt:'Coined in Watercolor Film Poster by TJ Murphy, watercolor pastels on Arches cold press watercolor paper.',caption:'Coined in Watercolor Film Poster · created for Gavin Robertson’s documentary premiere.'},
  {file:'display-at-kinoteka.jpeg',width:480,height:360,alt:'Warsaw Syrenka, the Coined in Watercolor poster, and the honey badger with cub framed and illuminated outside the Kinoteka theater.',caption:'The artworks displayed outside the theater entrance.'},
  {file:'three-festival-paintings.jpeg',width:1024,height:768,alt:'The three paintings made for Bitcoin Film Festival hanging together: Warsaw Syrenka, Coined in Watercolor, and the honey badger with cub.',caption:'The three works made for the festival.'},
  {file:'warsaw-syrenka.jpeg',width:360,height:550,alt:'Watercolor of the Warsaw Syrenka holding a sword and a Bitcoin shield, with orange hussar wings behind her.',caption:'Warsaw Syrenka.'},
  {file:'honey-badger-and-cub.jpeg',width:332,height:516,alt:'Watercolor of a honey badger holding its cub, with the Genesis block rendered in pale lettering on an orange background.',caption:'Bitcoin honey badger with cub and Genesis block.'},
  {file:'coined-in-watercolor-at-festival.jpeg',width:480,height:360,alt:'The Coined in Watercolor poster displayed among Bitcoin Film Festival posters above a table at Kinoteka.',caption:'Coined in Watercolor among the festival posters.'},
  {file:'palace-of-culture-and-science.jpeg',width:360,height:480,alt:'The Palace of Culture and Science in Warsaw, seen from the plaza beneath a blue sky.',caption:'The Palace of Culture and Science, Warsaw.'},
  {file:'outside-kinoteka.jpeg',width:360,height:480,alt:'Two festival visitors smiling outside the Kinoteka entrance beneath the Palace of Culture and Science.',caption:'Outside the Kinoteka entrance.'},
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bitcoin Film Festival Warsaw, Poland | Vermillion Aurora</title>
    <meta name="description" content="TJ Murphy’s Warsaw Syrenka, Bitcoin honey badger with cub, and Coined in Watercolor film poster, created for Bitcoin Film Festival and displayed at Kinoteka in Warsaw." />
    <link rel="canonical" href="https://vermillionaurora.com/exhibitions/bitcoin-film-festival-warsaw/" />
    <meta property="og:title" content="Bitcoin Film Festival Warsaw, Poland" />
    <meta property="og:description" content="Three paintings made for the festival, displayed outside the theater entrance at Kinoteka in the Palace of Culture and Science." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vermillionaurora.com/exhibitions/bitcoin-film-festival-warsaw/" />
    <meta property="og:image" content={`https://vermillionaurora.com${imageRoot}display-at-kinoteka.jpeg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/site-header.css" />
    <link rel="stylesheet" href="/exhibitions/viewer.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader />
      <main class="container exhibition-page warsaw-exhibition">
        <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/exhibitions/">Exhibitions</a></nav>
        <header class="warsaw-heading">
          <p class="eyebrow dark">Art &amp; cinema · Warsaw, Poland</p>
          <h1>Bitcoin Film Festival Warsaw, Poland</h1>
          <p><time datetime="2026">2026</time> · Kinoteka · Palace of Culture and Science</p>
        </header>
        <section class="warsaw-photos" aria-label="Bitcoin Film Festival photographs">
          <div class="exhibition-grid">
            {photos.map((photo,index)=>{const src=photo.src||`${imageRoot}${photo.file}`;return <a class="ex-photo" href={src} data-caption={photo.caption}><img src={src} width={photo.width} height={photo.height} alt={photo.alt} loading={index<3?'eager':'lazy'} decoding="async" /></a>;})}
          </div>
        </section>
        <section class="warsaw-story" aria-labelledby="warsaw-story-title">
          <p class="eyebrow dark">The story</p>
          <h2 id="warsaw-story-title">Paintings made for the festival</h2>
          <p>I made these paintings specifically for the Bitcoin Film Festival: the <a href="/products/warszawska-syrenka/">Warsaw Syrenka</a> and the <a href="/products/honeybadger-and-cub-with-genesis-block/">Bitcoin honey badger with cub</a>, along with the <a href="/products/coined-in-watercolor-film-poster/">movie poster for <em>Coined in Watercolor</em></a>, Gavin Robertson’s documentary.</p>
          <p>The festival took place at Kinoteka, inside Warsaw’s Palace of Culture and Science. These artworks were displayed outside the entrance to the theater for the Bitcoin Film Festival.</p>
          <div class="story-links"><a class="button button-solid" href="https://bitcoinfilmfest.com/" target="_blank" rel="noopener noreferrer">Visit Bitcoin Film Festival ↗</a><a href="/exhibitions/gavin-robertson/">Watch Gavin’s documentary →</a></div>
        </section>
        <section id="location" class="warsaw-location" aria-labelledby="venue-title">
          <div class="venue-copy">
            <p class="eyebrow dark">The venue</p>
            <h2 id="venue-title">Palace of Culture and Science</h2>
            <p><strong>Kinoteka</strong><br />Plac Defilad 1<br />00-901 Warsaw, Poland</p>
            <p>Kinoteka’s entrance faces Aleje Jerozolimskie.</p>
            <a href="https://maps.app.goo.gl/beKcn52kcShNibj66" target="_blank" rel="noopener noreferrer">Open Kinoteka in Google Maps ↗</a>
            <a href="https://kinoteka.pl/o-nas/kontakt/" target="_blank" rel="noopener noreferrer">Kinoteka venue information ↗</a>
          </div>
          <div id="warsaw-map" role="region" aria-label="Map showing Kinoteka in the Palace of Culture and Science, Warsaw"><p class="map-fallback"><a href="https://maps.app.goo.gl/beKcn52kcShNibj66">View the venue on Google Maps ↗</a></p></div>
        </section>
        <nav class="warsaw-more" aria-label="More exhibitions"><a href="/exhibitions/">← All exhibitions</a><a href="/#exhibitions">Back to the exhibitions carousel</a></nav>
      </main>
      <SiteFooter />
    </div>
    <script is:inline src="/exhibitions/viewer.js" defer></script>
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script is:inline>
      if (window.L) {
        const element=document.getElementById('warsaw-map');
        element.querySelector('.map-fallback').hidden=true;
        const position=[52.2311858,21.0065384];
        const map=L.map(element,{scrollWheelZoom:false}).setView(position,16);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);
        L.circleMarker(position,{radius:8,color:'#9e3218',fillColor:'#d34220',fillOpacity:1}).addTo(map)
          .bindPopup('<strong>Kinoteka</strong><br>Palace of Culture and Science<br>Plac Defilad 1, Warsaw').openPopup();
      }
    </script>
  </body>
</html>
<style>
  .warsaw-exhibition{padding-block:24px 56px;max-width:1200px}
  .product-breadcrumb{display:flex;gap:10px;flex-wrap:wrap}
  .warsaw-heading{margin:24px 0}
  .warsaw-heading .eyebrow{margin:0 0 8px}
  .warsaw-heading h1{font:600 clamp(2.3rem,5vw,4.2rem)/1.08 "Cormorant Garamond",serif;max-width:1000px;margin:0 0 14px}
  .warsaw-heading>p:last-child{color:var(--muted);margin:0}
  .warsaw-story{max-width:820px;margin:40px auto;font-size:1.03rem;line-height:1.8}
  h2{font:600 clamp(1.8rem,3.5vw,2.5rem)/1.15 "Cormorant Garamond",serif;margin:0 0 18px}
  .warsaw-story p{margin:0 0 18px}
  .warsaw-story a:not(.button),.venue-copy a,.warsaw-more a{text-decoration:underline;text-underline-offset:4px}
  .story-links{display:flex;align-items:center;flex-wrap:wrap;gap:20px;margin-top:24px;font-size:.9rem}
  .story-links .button{font-size:.78rem}
  .warsaw-location{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:36px;align-items:center;border-top:1px solid var(--line);padding-top:40px;margin-top:44px}
  .venue-copy p{line-height:1.7}.venue-copy .eyebrow{margin:0 0 10px}.venue-copy a{display:block;margin-top:14px;font-size:.85rem}
  #warsaw-map{height:360px;width:100%;border:1px solid var(--line);border-radius:8px;background:#e8dfd3;z-index:0}
  .map-fallback{padding:24px;font-size:.9rem}.map-fallback[hidden]{display:none}
  .warsaw-more{display:flex;justify-content:space-between;flex-wrap:wrap;gap:18px;border-top:1px solid var(--line);padding-top:24px;margin-top:40px;font-size:.9rem}
  a:focus-visible{outline:3px solid #9e4936;outline-offset:4px}
  @media(max-width:700px){.warsaw-location{grid-template-columns:1fr;gap:20px}.warsaw-story{margin-block:28px}.warsaw-heading{margin-top:20px}#warsaw-map{height:320px}}
</style>
