---
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { byId, catalogVersion } from '../../../../catalog/catalog.mjs';
import collections from '../../../../catalog/collections.json';
---
<!DOCTYPE html><html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gavin Robertson Collab | Vermillion Aurora</title>
  <meta name="description" content="From neighbors at the Nantucket to filming in Seattle and Cape Town: the story behind Gavin Robertson’s documentary, Coined in Watercolor, with paintings by TJ Murphy.">
  <link rel="canonical" href="https://vermillionaurora.com/exhibitions/gavin-robertson/">
  <meta property="og:title" content="Gavin Robertson Collab">
  <meta property="og:description" content="A friendship, a journey into art, and a documentary filmed in Seattle and Cape Town.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://vermillionaurora.com/exhibitions/gavin-robertson/">
  <meta property="og:image" content="https://vermillionaurora.com/gallery-images/coined-in-watercolor-film-poster.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/site-header.css">
  <style is:inline>
.film-collaboration-page{padding-block:28px 64px}
.film-collaboration-page .product-breadcrumb{margin-bottom:24px;display:flex;flex-wrap:wrap;gap:8px}
.film-collaboration-heading{max-width:850px;margin-bottom:28px}
.film-collaboration-heading .eyebrow{margin:0 0 8px}
.film-collaboration-heading h1{font:600 clamp(2.6rem,6vw,4.6rem)/1.08 "Cormorant Garamond",serif;margin:0 0 14px}
.film-collaboration-gallery{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:28px;align-items:start}
.film-collaboration-page .product-card{min-width:0;overflow:hidden}
.film-collaboration-page .product-card:hover{transform:none}
.film-collaboration-portrait>a{display:block;background:var(--paper)}.film-collaboration-portrait img{display:block;width:100%;height:auto}.film-collaboration-poster>a{display:block;background:var(--paper)}
.film-collaboration-poster img{display:block;width:100%;height:auto}
.film-collaboration-page .product-info{padding:24px}
.film-collaboration-page .product-card h2{font:600 clamp(1.7rem,3vw,2.3rem)/1.15 "Cormorant Garamond",serif;margin:0 0 14px}
.film-collaboration-page .product-info p{font-size:.95rem;line-height:1.7;font-weight:400}
.film-collaboration-page .product-info .eyebrow{font-size:.7rem;margin:0 0 8px}
.film-collaboration-page .product-info .product-availability{font-weight:600}
.film-collaboration-video{width:100%;aspect-ratio:16/9;min-height:200px;background:#171513}
.film-collaboration-video iframe{display:block;width:100%;height:100%;border:0}
.film-collaboration-more{display:flex;flex-wrap:wrap;gap:18px;border-top:1px solid var(--line);padding-top:24px;margin-top:36px;font-size:.9rem}
.film-collaboration-more a{text-decoration:underline;text-underline-offset:3px}
@media(max-width:800px){.film-collaboration-gallery{grid-template-columns:1fr;max-width:650px;margin-inline:auto}.film-collaboration-film{grid-row:1}.film-collaboration-poster{grid-row:auto}.film-collaboration-page{padding-top:20px}.film-collaboration-page .product-info{padding:20px}}

.film-collaboration-intro{display:grid;grid-template-columns:minmax(0,360px) minmax(0,1fr);gap:clamp(28px,4vw,56px);align-items:start;margin-bottom:48px}
.film-collaboration-intro .film-collaboration-portrait{width:100%;max-width:360px;margin:0}
.film-collaboration-intro .product-info{padding:18px 20px}
.film-collaboration-intro .product-card h2{font-size:1.65rem;margin-bottom:10px}
.film-collaboration-story{max-width:680px}
.film-collaboration-story h2{font:600 clamp(1.8rem,3vw,2.5rem)/1.15 "Cormorant Garamond",serif;margin:0 0 20px}
.film-collaboration-story p{line-height:1.8;color:var(--muted);margin:0 0 18px}
.film-collaboration-story p:last-child{margin-bottom:0}
@media(max-width:800px){.film-collaboration-intro{grid-template-columns:1fr;gap:28px;margin-bottom:36px}.film-collaboration-intro .film-collaboration-portrait{max-width:320px;margin-inline:auto}.film-collaboration-story{max-width:650px;margin-inline:auto}}
</style>
<meta name="catalog-version" content={catalogVersion} /></head>
<body>
<div class="page-shell">
<SiteHeader />
<main class="container film-collaboration-page" id="top">
  <nav class="product-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span>
    <a href="/#featured-artists">Featured Artists and Collaborations</a><span aria-hidden="true">/</span>
    <span aria-current="page">Gavin Robertson Collab</span>
  </nav>
  <div class="film-collaboration-heading">
    <p class="eyebrow accent">Gavin Robertson &amp; TJ Murphy</p>
    <h1>Gavin Robertson Collab</h1>
  </div>
  <section class="film-collaboration-intro" aria-labelledby="collaboration-story-title">
    <article class="product-card film-collaboration-portrait" data-availability="Not for sale">
      <a href="/gallery-images/gavin-and-i-in-cape-town.png" target="_blank" rel="noopener noreferrer" aria-label="View Gavin and I in Cape Town at full size">
        <img src="/gallery-images/gavin-and-i-in-cape-town.png" alt="Gavin and I in Cape Town — a painted portrait of Gavin Robertson and TJ Murphy" width="776" height="582" fetchpriority="high" decoding="async">
      </a>
      <div class="product-info">
        <p class="eyebrow dark">Painting · TJ Murphy</p>
        <h2>Gavin and I in Cape Town</h2>
        <p class="product-availability">Not for sale</p>
        <a href="/gallery-images/gavin-and-i-in-cape-town.png" target="_blank" rel="noopener noreferrer">View full size ↗</a>
      </div>
    </article>
    <div class="film-collaboration-story">
      <h2 id="collaboration-story-title">From the Nantucket to Cape Town</h2>
      <p>Gavin and I were neighbors at the Nantucket for a number of years. We spent a lot of time talking about Bitcoin, my art projects—including the rock opera I was working on—and my journey toward becoming an artist.</p>
      <p>Gavin thought I had an interesting story, one worth making a film about, and told me he wanted to make a documentary about that journey. Documentary filmmaking is his passion. He’s been studying it through courses, and this project became a way to develop his craft while telling my story.</p>
      <p>We began shooting in Seattle. After those shoots, Gavin asked whether there was a Bitcoin conference we could travel to together, where I could bring my paintings—something I’d already been doing. I suggested the one in his hometown of Cape Town the following month. We made it happen, and continued filming there.</p>
    </div>
  </section>
  <section class="film-collaboration-gallery" aria-label="Gavin Robertson Collab gallery">
    {collections.gavin.map(entry=><ProductCard product={byId[entry.product]} variant={entry.variant} />)}
<article class="product-card film-collaboration-film">
      <div class="film-collaboration-video">
        <iframe width="960" height="540" src="https://www.youtube-nocookie.com/embed/i7tvzE_bqM8?playsinline=1" title="Coined in Watercolor: The Art of Going All In — documentary by Gavin Robertson" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen=""></iframe>
      </div>
      <div class="product-info">
        <p class="eyebrow dark">A documentary by Gavin Robertson</p>
        <h2>Coined in Watercolor: The Art of Going All In</h2>
        <p>Gavin Robertson follows my journey of becoming an artist, from Seattle to Cape Town. The documentary premiered at the Bitcoin Film Festival in Warsaw, Poland, in 2026.</p>
        <p>I painted the poster for the premiere, using a frame from the documentary where I am meditating on top of Table Mountain in Cape Town, South Africa. I gave the painting as a gift to the organizer of the Bitcoin Film Festival.</p>
        <a class="button button-ghost" href="https://www.youtube.com/watch?v=i7tvzE_bqM8" target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a>
      </div>
    </article>
  </section>
  <nav class="film-collaboration-more" aria-label="Explore more artwork">
    <a href="/#featured-artists">Featured Artists and Collaborations</a>
    <a href="/gallery/">Browse all paintings</a>
  </nav>
</main>
<SiteFooter />
</div>


<script is:inline src="/catalog/availability.js" defer=""></script></body></html>