---
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { GALLERY_3D_URL } from '../../../data/gallery-entry.mjs';

const title = 'Walk-Through 3D Gallery | TJ Murphy';
const description = 'Walk TJ Murphy’s 3D gallery: a domed building on the lawn, rooms of original paintings, and the Kinoteka cinema annex. Then enter the gallery in your browser.';
const pageUrl = 'https://tjm.art/exhibitions/3d-gallery/';
const imageRoot = '/exhibitions/3d-gallery/images/';
const hero = `${imageRoot}exterior.webp`;
const neuralRoom = `${GALLERY_3D_URL}?room=neural-dance`;
const shots = [
  {
    file: 'rotunda.webp', width: 1600, height: 900,
    alt: 'Inside a domed gallery room, with watercolor landscapes on the walls and the courtyard visible through an arch',
    caption: 'Rainier at dawn, from Denny Blaine.',
    story: `<p>The two wide paintings on the left are the same beach: Denny Blaine, near where I live in Seattle. <a href="/products/sunrise-on-rainier-from-denny-blaine/">Sunrise on Rainier from Denny Blaine</a> is the close view, a rainbow sky and my meditation blanket on the rocks. I went down at dawn the day my friend Lisa was climbing Rainier.</p><p><a href="/products/sunrise-on-tahoma-from-denny-blaine/">Sunrise on Tahoma from Denny Blaine</a> is the farther view, below it. That's me on the rock at the left, wrapped in the blanket.</p>`,
  },
  {
    file: 'round-room.webp', width: 1600, height: 900,
    alt: 'A round gallery room with portraits and landscapes on white walls beneath a ring of windows',
    caption: 'Bass Coast portraits, and smaller landscapes between them.',
    story: `<p>The scratchy portraits are from Bass Coast. The fan is <a href="/products/book-art-f367882aaeb0e32471eb/">Jennica at Bass Coast</a>. With her: <a href="/products/book-art-54ff45104a57a68d4beb/">Neil</a>, <a href="/products/book-art-614d5b68dbe5052e302a/">Devo</a>, and <a href="/products/book-art-4350a257e5a6a5e75a31/">Michael</a>. I painted portraits of the crew over a few years at Bass Coast, the Eclipse in Austin, and Black Rock City, and gave them as gifts.</p><p>The smaller landscapes along the far side of the room include the <a href="/products/archived-painting-433/">Bass Coast sunrise studies</a>.</p>`,
  },
  {
    file: 'green-room.webp', width: 1600, height: 900,
    alt: 'Four framed figurative paintings on a white wall in a room with a pale green floor, beside a stone arch',
    caption: 'Three paintings for the Bitcoin Film Festival.',
    story: `<p>The wall on the green floor is the set I made for the <a href="/exhibitions/bitcoin-film-festival-warsaw/">Bitcoin Film Festival in Warsaw</a>. <a href="/products/honeybadger-and-cub-with-genesis-block/">Honeybadger and Cub with Genesis Block</a> is the mascot protecting its cub. I wrote the Genesis block in clear wax first, so the watercolor would resist it.</p><p><a href="/products/coined-in-watercolor-film-poster/">Coined in Watercolor</a> is the poster for Gavin Robertson's documentary. I painted it from a frame of me meditating on Table Mountain in Cape Town, and I gave the painting to the festival organizer. <a href="/products/warszawska-syrenka/">Warszawska Syrenka</a> is Warsaw's protector spirit, with hussar wings and a Bitcoin shield. Tomek at the festival suggested the siren, and that the B belongs on the shield.</p><p>On the wall to the left is <a href="/products/book-art-ec22daff29e72f16eb76/">Tomer Strolight</a>, hat and sunglasses, microphone up. The page has the painting. I haven't written a longer note there.</p>`,
  },
  {
    file: 'patio-arch.webp', width: 1600, height: 900,
    alt: 'A stone arch opening from a gallery onto a patio with a landscape painting, and smaller works on the interior wall',
    caption: 'The cormorant mural, out on the patio.',
    story: `<p>The painting on the fence is <a href="/products/cormorant-presiding-over-sunset-on-puget-sound/">Cormorant Presiding over Sunset on Puget Sound</a>. A cormorant dries its wings on an old piling while orange clouds sit over the sound, a strip of turquoise sky between them, and two sailboats below the mountains. The original is a mural in a private garden. Prints are made from a photograph of it.</p><p>Outdoor pieces sit past the stone arches. More on the rooms is in <a href="/blog/walk-my-paintings-3d-gallery/">Walk My 206 Paintings in 3D</a>.</p>`,
  },
  {
    file: 'portrait-salon.webp', width: 1600, height: 900,
    alt: 'A curved gallery wall of portrait paintings beneath a balcony of windows',
    caption: 'Loree, and the portraits hung with her.',
    story: `<p>The close portrait with the flower crown is <a href="/products/book-art-64cfd389b3dbb5cde532/">Loree</a>. <a href="/products/book-art-a627c7b7d19ace6b3e51/">John</a> hangs next to her. The pages have the paintings. I haven't written a longer note for either one.</p>`,
  },
  {
    file: 'sunset-studies.webp', width: 1600, height: 900,
    alt: 'Small sunset paintings arranged on a gallery wall, with an arch opening into another room',
    caption: 'Sunset strips, and the paintings beside them.',
    story: `<p>The long row of small horizontal panels is the sunset ridge strips, from the <a href="/gallery/older-work/">older work</a>. One of them is <a href="/products/older-work-sunset-ridge-strips-original-1/">Sunset Ridge Strip 174</a>. I don't have a longer story for the set on the site.</p><p>On the same wall: <a href="/products/painting-moonlit-water/">Moonrise Over the Cascades</a>, a full moon over a lake in the North Cascades, painted in Seattle; <a href="/products/painting-sunflower-woman/">Vision of Ukraine at Peace</a>; <a href="/products/painting-figures-in-wheatfield/">The Mother of Kiev</a>; and <a href="/products/girl-wearing-flower-crown/">Girl Wearing Flower Crown</a>.</p>`,
  },
  {
    file: 'wide-hall.webp', width: 1600, height: 900,
    alt: 'Three large colorful paintings on a curved gallery wall, with an arch looking into the courtyard',
    caption: 'El Salvador, with Chase Toole.',
    story: `<p>These three are a collaboration with Chase Toole: <a href="/products/painting-insect-garden/">El Salvador: Past</a>, <a href="/products/painting-emergence/">Present</a>, and <a href="/products/painting-twin-dragons/">Future</a>. I flew to El Zonte for the reference photos and painted them by hand in Seattle, then brought work back for <a href="/exhibitions/el-salvador/">Adopting Bitcoin in El Salvador</a>.</p><p>The doorway out of this room is marked El Salvador. The longer note is <a href="/blog/el-salvador-sunrises-sunsets/">Sunrise and Sunset at Bitcoin Beach</a>.</p>`,
  },
  {
    file: 'kinoteka.webp', width: 1600, height: 900,
    alt: 'The Kinoteka annex, a small cinema with red seats facing a curtained screen',
    caption: 'The Kinoteka annex.',
    story: `<p>Kinoteka is the cinema inside Warsaw's Palace of Culture and Science. Gavin Robertson's documentary <a href="/film/">Coined in Watercolor</a> premiered there on June 5, 2026, at the Bitcoin Film Festival. This room is that theater: red seats facing a screen.</p><p>The same annex runs <a href="/neural-dance/">Neural Dance</a>, the interactive mural projection, inside the gallery. <a href="${neuralRoom}">Open the Neural Dance annex</a>.</p>`,
  },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Walk-Through 3D Gallery',
  description,
  url: pageUrl,
  primaryImageOfPage: `https://tjm.art${hero}`,
  isPartOf: { '@type': 'WebSite', name: 'TJ Murphy', url: 'https://tjm.art/' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content="Walk-Through 3D Gallery" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`https://tjm.art${hero}`} />
    <meta property="og:image:alt" content="The domed 3D gallery from the lawn, with the courtyard fountain and the Kinoteka tower" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    <link href="/fonts/fonts.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/site-header.css" />
  </head>
  <body>
    <div class="page-shell">
      <SiteHeader />
      <main class="container gallery-landing" id="main-content">
        <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/exhibitions/">Exhibitions</a></nav>
        <header class="gallery-landing-heading">
          <p class="eyebrow dark">A gallery you can walk</p>
          <h1>Walk-Through 3D Gallery</h1>
          <p>You can walk this gallery in a browser, on a phone or a computer. I hung the paintings at their real size in domed rooms, with a courtyard in the middle and the Kinoteka cinema off to one side. The pictures below are a few of the stops. The ring is the door.</p>
        </header>
        <figure class="gallery-hero">
          <img src={hero} width="1600" height="900" alt="The domed 3D gallery from the lawn, with the courtyard fountain and the Kinoteka tower" fetchpriority="high" decoding="async" />
        </figure>
        <div class="portal-row">
          <a class="portal" href={GALLERY_3D_URL}>
            <span class="portal-ring" aria-hidden="true"></span>
            <span class="portal-core">Enter the gallery</span>
          </a>
        </div>
        <section class="gallery-shots" aria-label="Views inside the 3D gallery">
          {shots.map((shot) => (
            <figure>
              <img src={`${imageRoot}${shot.file}`} width={shot.width} height={shot.height} alt={shot.alt} loading="lazy" decoding="async" />
              <figcaption>
                <p class="shot-caption">{shot.caption}</p>
                <div class="shot-story" set:html={shot.story}></div>
              </figcaption>
            </figure>
          ))}
        </section>
        <section class="gallery-note">
          <p>You move through the rooms in the browser. The plaque beside a painting opens its page.</p>
          <p class="gallery-pay">Pay with Bitcoin / Lightning (BTCPay) or card.</p>
          <p><a href={GALLERY_3D_URL}>Enter the gallery →</a></p>
        </section>
        <nav class="gallery-more" aria-label="More exhibitions"><a href="/exhibitions/">← All exhibitions</a><a href="/#exhibitions">Back to the exhibitions carousel</a></nav>
      </main>
      <SiteFooter />
    </div>
    <div class="warp" aria-hidden="true"></div>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <script is:inline>
      (function () {
        const link = document.querySelector('.portal');
        if (!link) return;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)');
        link.addEventListener('click', (event) => {
          if (reduce.matches || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
          event.preventDefault();
          document.body.classList.add('is-warping');
          window.setTimeout(() => { location.href = link.href; }, 680);
        });
      })();
    </script>
  </body>
</html>
<style>
  .gallery-landing { padding-block: 24px 56px; max-width: 1100px; }
  .product-breadcrumb { display: flex; gap: 10px; flex-wrap: wrap; font-size: .8rem; }
  .gallery-landing-heading { margin: 22px 0 18px; }
  .gallery-landing-heading .eyebrow { margin: 0 0 8px; }
  .gallery-landing-heading h1 { font: 600 var(--page-title-size)/var(--page-title-leading) "Cormorant Garamond", serif; margin: 0 0 12px; }
  .gallery-landing-heading p:last-child { max-width: 68ch; margin: 0; color: var(--muted); line-height: 1.7; }
  .gallery-hero { margin: 22px 0 0; }
  .gallery-hero img { width: 100%; height: min(46vh, 460px); object-fit: cover; object-position: center 42%; border-radius: 16px; background: #e8dfd3; }
  .gallery-shots img { width: 100%; height: auto; border-radius: 16px; background: #e8dfd3; }
  .portal-row { display: flex; justify-content: center; margin-top: -78px; position: relative; z-index: 2; }
  .portal {
    position: relative; display: grid; place-items: center; width: min(210px, 62vw); aspect-ratio: 1;
    color: #fff8ef; text-decoration: none; border-radius: 50%;
    transition: transform .35s ease;
  }
  .portal-ring, .portal-ring::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 20deg, transparent 0 10%, #ffd7a8 16%, #d34220 30%, transparent 42%, #9fd4ff 58%, #fff1d6 68%, #d34220 80%, transparent 90% 100%);
    filter: drop-shadow(0 0 10px rgba(211, 66, 32, .55));
    animation: portal-spin 9s linear infinite;
    -webkit-mask: radial-gradient(circle, transparent 0 56%, #000 58% 76%, transparent 79%);
    mask: radial-gradient(circle, transparent 0 56%, #000 58% 76%, transparent 79%);
  }
  .portal-ring::after { inset: 8%; animation-duration: 14s; animation-direction: reverse; opacity: .85; filter: drop-shadow(0 0 14px rgba(255, 196, 120, .7)); }
  .portal-core {
    position: relative; z-index: 1; width: 58%; aspect-ratio: 1; border-radius: 50%;
    display: grid; place-items: center; text-align: center; padding: 14px;
    background: radial-gradient(circle at 50% 38%, #4a2c22 0%, #1c1210 72%);
    box-shadow: inset 0 0 28px rgba(255, 186, 120, .45), 0 10px 28px rgba(28, 18, 14, .28);
    font: 600 .74rem/1.25 Inter, system-ui, sans-serif; letter-spacing: .14em; text-transform: uppercase;
  }
  .portal:hover, .portal:focus-visible { transform: scale(1.05); }
  .portal:hover .portal-ring, .portal:focus-visible .portal-ring { animation-duration: 2.2s; }
  .portal:focus-visible { outline: 3px solid #bd381c; outline-offset: 6px; }
  .gallery-shots { display: grid; gap: 22px; margin-top: 36px; }
  @media (min-width: 860px) {
    .gallery-shots { grid-template-columns: 1fr 1fr; }
    .gallery-shots figure:first-child, .gallery-shots figure:last-child { grid-column: 1 / -1; }
  }
  .gallery-shots figure { margin: 0; }
  .gallery-shots figcaption { margin-top: 8px; }
  .shot-caption { margin: 0 0 6px; color: var(--ink, #2c2924); font-size: 1rem; line-height: 1.4; }
  .shot-story { max-width: 68ch; color: var(--ink, #2c2924); font-size: .95rem; line-height: 1.6; }
  .shot-story p { margin: 0 0 10px; }
  .shot-story a, .gallery-note a, .gallery-more a { text-decoration: underline; text-underline-offset: 3px; }
  .gallery-pay { font-weight: 600; }
  .gallery-note { max-width: 68ch; margin: 36px auto 0; font-size: 1.03rem; line-height: 1.75; }
  .gallery-note p { margin: 0 0 14px; }
  .gallery-more a { text-decoration: underline; text-underline-offset: 4px; }
  .gallery-more { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 18px; border-top: 1px solid var(--line); padding-top: 24px; margin-top: 36px; font-size: .9rem; }
  .warp { position: fixed; inset: 0; z-index: 80; pointer-events: none; opacity: 0; background: radial-gradient(circle at 50% 42%, rgba(255, 236, 214, .15) 0 8%, rgba(88, 36, 18, .35) 18%, rgba(12, 8, 7, .94) 46%); }
  .is-warping .warp { animation: warp-zoom .68s ease-in forwards; }
  @keyframes portal-spin { to { transform: rotate(1turn); } }
  @keyframes warp-zoom { from { opacity: 1; transform: scale(.35); } to { opacity: 1; transform: scale(2.6); } }
  @media (max-width: 720px) {
    .gallery-hero img { height: 220px; }
    .portal-row { margin-top: -58px; }
    .portal-core { font-size: .66rem; letter-spacing: .1em; }
    .gallery-shots { gap: 28px; }
    .shot-story { font-size: .92rem; line-height: 1.55; }
  }
  @media (prefers-reduced-motion: reduce) {
    .portal-ring, .portal-ring::after { animation: none; }
    .portal, .portal:hover, .portal:focus-visible { transform: none; transition: none; }
    .is-warping .warp { animation: none; opacity: 0; }
  }
</style>
