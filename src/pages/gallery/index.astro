---
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { byId, catalogVersion, urlFor, priceLabel, statusLabel, dimensionLabel } from '../../../catalog/catalog.mjs';
import { artworkAlt } from '../../data/artwork-alt.mjs';
import collections from '../../../catalog/collections.json';
---
<!DOCTYPE html><html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gallery | Watercolor Paintings by TJ Murphy, Seattle Artist</title>
    <meta name="description" content="Watercolor pastel paintings by Seattle artist TJ Murphy: Pacific Northwest landscapes, portraits and travel scenes, with originals, prints and commissions.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/exhibitions/viewer.css"><link rel="stylesheet" href="/site-header.css">
  <link rel="stylesheet" href="/gallery/painting-list.css">
<meta name="catalog-version" content={catalogVersion} />
  <script is:inline>document.documentElement.classList.add('js-gallery');</script></head>
  <body class="painting-gallery-page">
    <div class="page-shell">
      <SiteHeader />

      <main id="main-content">
        <section id="gallery" class="section section-light">
          <div class="container">
            <div class="section-heading">
              <p class="eyebrow dark">Gallery</p>
              <h1>Paintings by TJ Murphy</h1>
            </div>

            <div class="gallery-viewer-reserve" aria-hidden="true"></div>
            <div data-gallery-list>
              <div class="gallery-filter" hidden>
                <label class="gallery-sort" for="gallery-sort">Sort by
                  <select id="gallery-sort" aria-describedby="gallery-size-note">
                    <option value="price-desc">Price: high to low</option>
                    <option value="price-asc">Price: low to high</option>
                    <option value="size-desc">Size: largest first</option>
                    <option value="size-asc">Size: smallest first</option>
                  </select>
                </label>
                <label><input type="checkbox" id="available-only"> Available only</label>
                <span id="gallery-result-count" role="status" aria-live="polite">{collections.gallery.length} of {collections.gallery.length} paintings</span>
                <p id="gallery-size-note">Size is sorted by painted area.</p>
              </div>
              <ul class="painting-list" aria-label="Paintings">
                {collections.gallery.map(entry=>{
                  const p=byId[entry.product],status=statusLabel(p),url=urlFor(p);
                  const area=p.dimensions?p.dimensions.width*p.dimensions.height/(p.dimensions.unit==='cm'?2.54**2:1):undefined;
                  return <li class="painting-list-row" data-product-id={p.id} data-availability={status} data-price={p.listing.price?.amount} data-area={area}>
                    <a href={url} class="gallery-product-image" aria-label={`View ${p.title}`} tabindex="-1"><img src={p.image.src} alt={artworkAlt(p)} loading="lazy" decoding="async" width={p.image.width} height={p.image.height} /></a>
                    <h3><a href={url} class="product-title-link">{p.title}</a></h3>
                    <p class="painting-list-dimensions">{dimensionLabel(p)}</p>
                    <p class="painting-list-price" data-card-price>{p.listing.status==='available'?priceLabel(p):status}</p>
                  </li>;
                })}
              </ul>
              <p class="gallery-empty" hidden>No paintings are currently available. Uncheck “Available only” to see the full collection.</p>
            </div>

          </div>
          </section></main></div>



      <SiteFooter />



  <script is:inline src="/exhibitions/viewer.js" defer=""></script>

<script is:inline src="/catalog/availability.js" defer=""></script></body></html>
