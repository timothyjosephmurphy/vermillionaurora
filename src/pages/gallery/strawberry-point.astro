---
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import {strawberryPaintings,strawberryGroups,strawberryId,strawberryTitle,strawberryGroupTitle} from '../../../catalog/strawberry-point-products.mjs';
import {catalogVersion} from '../../../catalog/catalog.mjs';
const title='Strawberry Point Hiking Trip';
const description='Paintings by TJ Murphy from a three-day backpacking trip to Strawberry Point on the Pacific coast of the Olympic Peninsula.';
const src=(d,w)=>`${d.base}-${w}.webp`,srcset=d=>d.widths.map(w=>`${src(d,w)} ${w}w`).join(', ');
const story=[
  'Last summer I hiked with my friends John and Charlie to Strawberry Point, on the Pacific coast of the Olympic Peninsula. We backpacked for three days. To reach the point we waited for low tide to cross the beach, then made camp on the point in a windbreak.',
  'The first night we cooked pork loin and vegetables in foil packets on the campfire. It made for a heavy pack on the way in and a lighter one on the way out. We played guitar, told stories, played rock baseball on the beach and watched the sunsets.',
  'Even in summer the Pacific brought rain and a sharp, constant wind. On the rainy day we huddled in the swirling smoke of the campfire.',
  'On the way out we met Gary, who seems to hike the trail every day, a strange and interesting woodland fellow. I asked how his day was going. “Grand Slam! I saw sea otters!” We saw him again later, taking photos.',
  'It was a beautiful trip with great friends. I painted these this fall as part of a year in retrospect, painting from photos of all my trips. I plan a series of twelve paintings in this format.'
];
---
<!doctype html><html lang="en"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title} | TJ Murphy</title><meta name="description" content={description}/>
  <meta name="catalog-version" content={catalogVersion}/><link rel="canonical" href="https://tjm.art/gallery/strawberry-point/"/>
  <meta property="og:title" content={`${title} | TJ Murphy`}/><meta property="og:description" content={description}/>
  <meta property="og:url" content="https://tjm.art/gallery/strawberry-point/"/><meta property="og:type" content="website"/>
  <meta property="og:image" content={`https://tjm.art${src(strawberryPaintings[0].display,1600)}`}/>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"/>
  <link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/site-header.css"/>
</head><body><div class="page-shell"><SiteHeader/>
<main class="container archive-main" id="main-content">
  <nav class="archive-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/gallery/">Gallery</a><span>/</span><span aria-current="page">{title}</span></nav>
  <header class="archive-intro"><p class="eyebrow dark">Olympic Peninsula · Painted fall 2026</p><h1>{title}</h1>
    {story.map(t=><p>{t}</p>)}
    <p class="archive-count">{strawberryPaintings.length} paintings · not yet for sale, inquiries welcome</p>
  </header>
  <ul class="archive-grid" aria-label="Strawberry Point paintings">
    {strawberryPaintings.map((p,i)=><li class="archive-card" data-product-id={strawberryId(p)}><a href={`/products/${strawberryId(p)}/`}>
      <div class="archive-image"><img src={src(p.display,480)} srcset={srcset(p.display)} sizes="(max-width: 600px) calc(100vw - 48px), (max-width: 960px) 45vw, 30vw" width={p.display.width} height={p.display.height} alt={`${strawberryTitle(p)}, a painting by TJ Murphy`} loading={i<3?'eager':'lazy'} decoding="async"/></div>
      <div class="archive-caption"><h2>{strawberryTitle(p)}</h2><p><span>Inquire</span></p></div></a></li>)}
  </ul>
  <h2 class="sp-sets">As photographed together</h2>
  <ul class="archive-grid" aria-label="Strawberry Point paintings photographed together">
    {strawberryGroups.map(g=><li class="archive-card" data-product-id={g.id}><a href={`/products/${g.id}/`}>
      <div class="archive-image"><img src={src(g.display,480)} srcset={srcset(g.display)} sizes="(max-width: 600px) calc(100vw - 48px), 30vw" width={g.display.width} height={g.display.height} alt={`${g.members.length} paintings by TJ Murphy from Strawberry Point, photographed together`} loading="lazy" decoding="async"/></div>
      <div class="archive-caption"><h2>{strawberryGroupTitle(g)}</h2><p>{g.members.length} paintings</p></div></a></li>)}
  </ul>
  <p class="archive-back"><a href="/gallery/">← Return to the main gallery</a></p>
</main><SiteFooter/></div>
<style>
  .archive-main{padding-top:30px;padding-bottom:70px}.archive-breadcrumb{display:flex;flex-wrap:wrap;gap:10px;font-size:.85rem;color:#665b52}.archive-intro{max-width:750px;margin:42px 0 32px}.archive-intro h1{font:500 clamp(2.8rem,6vw,4.5rem)/1.05 'Cormorant Garamond',serif;margin:12px 0 18px}.archive-intro>p{line-height:1.65}.archive-count{color:#73685e;font-size:.9rem}.archive-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px 28px}.archive-card{min-width:0}.archive-card a{display:block;color:inherit;text-decoration:none}.archive-image{background:#f1ece4;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;border-radius:4px;overflow:hidden}.archive-image img{width:100%;height:100%;object-fit:contain;padding:16px}.archive-caption{padding:15px 2px 0}.archive-caption h2{font:600 1.65rem/1.15 'Cormorant Garamond',serif;margin:0 0 7px}.archive-caption p{margin:0 0 6px;font-size:.9rem}.archive-caption span{color:#73685e}.archive-back{margin-top:54px}.archive-card a:hover h2{color:#a34528}.sp-sets{font:500 2.2rem/1.1 'Cormorant Garamond',serif;margin:64px 0 24px}@media(max-width:960px){.archive-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.archive-grid{grid-template-columns:1fr}}
</style>
</body></html>
