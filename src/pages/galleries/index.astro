---
import Layout from '../../layouts/BookGalleryLayout.astro';
import {wallLabelGalleries} from '../../../catalog/wall-label-galleries.mjs';
---

<Layout title="Galleries" description="Wall label galleries of paintings by TJ Murphy, grouped the way they hang in the studio.">
  <nav aria-label="Breadcrumb"><a href="/">Home</a> / Galleries</nav>
  <header class="book-gallery-intro">
    <p class="eyebrow dark">Wall labels</p>
    <h1>Galleries</h1>
    <p>Paintings grouped under the studio wall labels. A work can belong to more than one group. Book chapter galleries stay on <a href="/book-galleries/">Selected Galleries</a>.</p>
  </header>
  <ul class="book-gallery-grid" aria-label="Wall label galleries">
    {wallLabelGalleries.map(gallery => <li class="book-gallery-card wall-label-card">
      <a href={`/galleries/${gallery.id}/`}>
        <img src={gallery.thumb} alt="" width={gallery.thumbWidth} height={gallery.thumbHeight} loading="lazy" decoding="async" />
        <h2>{gallery.title}</h2>
        <p>{gallery.works.length} {gallery.works.length === 1 ? 'work' : 'works'}</p>
      </a>
    </li>)}
  </ul>
</Layout>

<style is:global>
  .book-gallery-card.wall-label-card img { height: auto; aspect-ratio: 4 / 1; object-fit: contain; background: #111; }
</style>
