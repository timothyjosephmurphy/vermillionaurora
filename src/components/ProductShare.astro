---
import {urlFor} from '../../catalog/catalog.mjs';
const {product}=Astro.props;
const url=new URL(urlFor(product),Astro.site||'https://tjm.art').href;
const title=`${product.title} by ${product.artist||product.author||'TJ Murphy'}`;
const post=`${title}\n${url}`;
const imageSrc=product.image?.src||product.examples?.[0]?.src;
const image=imageSrc?new URL(imageSrc,url).href:null;
const label=product.type==='painting'?'Share this painting':product.type==='book'?'Share this book':'Share this page';
const id=`share-${product.slug}`;
const xHref=`https://x.com/intent/tweet?${new URLSearchParams({text:title,url})}`;
const facebookHref=`https://www.facebook.com/sharer/sharer.php?${new URLSearchParams({u:url})}`;
---
<!-- Share buttons are icon-only by design (TJ). Keep the inline SVG icons; tests/product-share.test.mjs guards this. -->
<section class="product-share" aria-label={label} data-product-share data-share-url={url} data-share-title={title} data-share-image={image} data-share-slug={product.slug}>
  <h2>{label}</h2>
  <div class="share-actions">
    <a class="share-action share-action-icon" href={xHref} target="_blank" rel="noopener noreferrer" aria-label="Share on X (opens in a new tab)" title="Share on X"><svg class="share-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg><span class="share-label">Share on X</span></a>
    <a class="share-action share-action-icon" href={facebookHref} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook (opens in a new tab)" title="Share on Facebook"><svg class="share-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg><span class="share-label">Share on Facebook</span></a>
    <button class="share-action share-action-icon" type="button" data-share-toggle="nostr" aria-controls={`${id}-nostr`} aria-expanded="false" aria-label="Share on Nostr" title="Share on Nostr" hidden><svg class="share-icon" viewBox="3 2 18.5 20" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4.71 21.69C4.55 21.62 4.56 21.02 4.73 20.53C4.81 20.31 4.88 19.95 4.88 19.73C4.88 19.29 4.95 19.21 5.48 19.05C5.72 18.98 5.94 18.83 6.07 18.63C6.19 18.47 6.48 18.07 6.71 17.74C6.94 17.42 7.12 17.12 7.12 17.07C7.12 17.02 7.18 16.94 7.24 16.9C7.42 16.79 7.85 16.11 7.91 15.83C7.95 15.68 8.19 15.38 8.5 15.12C10.35 13.54 10.43 13.44 10.17 13.25C10.07 13.18 9.91 13.12 9.8 13.12C9.69 13.12 9.52 13.06 9.42 12.99C9.32 12.91 9.17 12.85 9.1 12.85C8.97 12.84 8.66 12.71 7.61 12.21C7.27 12.04 6.61 12.2 6.07 12.57C5.48 12.99 5.2 12.92 4.1 12.06C3.77 11.8 3.75 11.75 3.75 11.26C3.75 10.77 3.78 10.7 4.18 10.24C4.42 9.97 4.65 9.75 4.7 9.75C4.75 9.75 4.98 9.67 5.2 9.56C5.51 9.42 5.91 9.36 6.77 9.31C7.4 9.28 8.09 9.2 8.29 9.13C8.49 9.06 8.73 9 8.83 9C9.04 9 10.18 8.48 10.26 8.35C10.29 8.3 10.45 8.24 10.62 8.2C10.79 8.17 11.01 8.09 11.11 8.02C11.21 7.96 11.52 7.85 11.79 7.79C12.06 7.72 12.31 7.63 12.33 7.58C12.43 7.43 14.93 7.49 15.14 7.64C15.24 7.72 15.4 7.78 15.5 7.78C15.61 7.78 15.86 7.86 16.07 7.96C16.28 8.06 16.62 8.18 16.83 8.23C17.03 8.29 17.38 8.39 17.59 8.45C18.36 8.68 19.21 8.02 19.29 7.13C19.35 6.47 19.21 6.2 18.39 5.46C17.51 4.67 17.25 4.19 17.25 3.4C17.25 2.87 17.27 2.81 17.58 2.54C18.03 2.15 18.36 2.16 19.07 2.6C19.38 2.8 19.73 3 19.83 3.06C19.93 3.12 20.02 3.26 20.02 3.39C20.02 3.6 19.98 3.61 19.45 3.62C18.17 3.65 18.09 3.93 19.09 4.89C20.86 6.59 20.66 8.3 18.51 9.89C17.7 10.49 17.62 10.61 17.62 11.25C17.63 11.98 16.89 13.12 16.41 13.12C16.31 13.13 16.02 13.2 15.78 13.3C15.53 13.4 15.08 13.5 14.78 13.54C14.48 13.57 14.07 13.68 13.88 13.78C13.47 13.99 12.47 15.14 12.47 15.41C12.47 15.6 12.43 15.6 13.34 15.32C13.58 15.25 14 15.12 14.27 15.05C14.54 14.97 14.9 14.84 15.05 14.77C15.46 14.58 15.93 14.72 16.17 15.11C16.27 15.28 16.42 15.51 16.5 15.62C16.58 15.73 16.72 15.93 16.82 16.07C17.03 16.37 16.93 16.65 16.63 16.62C15.88 16.54 15.57 16.42 15.31 16.13L15.04 15.82L14.53 15.99C13.47 16.33 12.58 16.65 11.94 16.89C10.93 17.29 10.56 16.6 11.16 15.44C11.32 15.12 11.52 14.79 11.6 14.7C11.74 14.54 11.71 14.25 11.54 14.25C11.49 14.25 11.25 14.41 11 14.6C10.75 14.8 10.43 15.03 10.29 15.12C10.15 15.21 9.87 15.51 9.66 15.78C9.45 16.06 9.18 16.34 9.04 16.41C8.81 16.53 8.43 17 7.78 17.95C7.6 18.21 7.27 18.66 7.05 18.94C6.4 19.78 6.38 19.82 6.38 19.91C6.38 19.96 6.16 20.22 5.9 20.5C5.64 20.77 5.37 21.14 5.3 21.32C5.19 21.57 4.95 21.79 4.84 21.74C4.84 21.74 4.78 21.71 4.71 21.69Z"/></svg><span class="share-label">Share on Nostr</span></button>
    {image&&<button class="share-action share-action-icon" type="button" data-share-toggle="instagram" aria-controls={`${id}-instagram`} aria-expanded="false" aria-label="Share on Instagram" title="Share on Instagram" hidden><svg class="share-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg><span class="share-label">Share on Instagram</span></button>}
    <button class="share-action" type="button" data-share-copy-link title="Copy link to this page" hidden><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/></svg>Copy link</button>
    <button class="share-action" type="button" data-share-native title="Share with an app on this device" hidden><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.5 6.8-4m-6.8 7 6.8 4"/></svg>Share…</button>
  </div>
  <div class="share-panel" id={`${id}-nostr`} data-share-panel="nostr" hidden>
    <h3>Share on Nostr</h3>
    <p>Copy this post into your Nostr app, or choose a compatible app from your device’s share menu.</p>
    <label for={`${id}-nostr-post`}>Post text</label>
    <textarea id={`${id}-nostr-post`} readonly rows="3" data-share-post>{post}</textarea>
    <div class="share-actions"><button class="share-action" type="button" data-share-copy-post>Copy post</button><button class="share-action" type="button" data-share-native hidden>Choose sharing app…</button></div>
  </div>
  {image&&<div class="share-panel" id={`${id}-instagram`} data-share-panel="instagram" hidden>
    <h3>Share on Instagram</h3>
    <p>Save the artwork image and copy the caption below. Add the image to your Instagram post or Story; use a Link sticker in your Story to link to this page.</p>
    <div class="share-actions"><button class="share-action" type="button" data-share-download>Save artwork image</button><a class="share-action" href={image} target="_blank" rel="noopener noreferrer">Open image ↗</a></div>
    <label for={`${id}-instagram-post`}>Caption and product link</label>
    <textarea id={`${id}-instagram-post`} readonly rows="3" data-share-post>{post}</textarea>
    <button class="share-action" type="button" data-share-copy-post>Copy caption &amp; link</button>
  </div>}
  <div class="share-panel" data-share-copy-fallback hidden><label for={`${id}-url`}>Product link — select and copy</label><input id={`${id}-url`} type="url" readonly value={url}/></div>
  <p class="share-status" role="status" aria-live="polite" data-share-status></p>
  <noscript><p>Copy this product link to share elsewhere: <a href={url}>{url}</a></p></noscript>
</section>
<script>
  import '../scripts/product-share.js';
</script>
<style>
  .product-share{margin:22px 0;padding-top:18px;border-top:1px solid var(--line);font-size:.82rem}
  .product-share h2{font:600 .88rem/1.4 Inter,sans-serif;margin:0 0 10px;color:var(--muted)}
  .share-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .share-action{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:8px 13px;border:1px solid var(--line);border-radius:24px;background:transparent;color:var(--ink);font:500 .78rem/1.3 Inter,sans-serif;text-decoration:none;cursor:pointer}
  .share-action:hover{border-color:var(--accent);background:var(--paper)}
  /* Social networks are icon-only round buttons; the label stays for screen readers (and the title shows as a tooltip). */
  .share-action-icon{width:44px;height:44px;padding:0;border-radius:50%}
  .share-action-icon .share-icon{display:block;flex:none}
  .share-label{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .share-action:focus-visible,.share-panel input:focus-visible,.share-panel textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .share-action[aria-expanded="true"]{border-color:var(--accent);background:var(--paper)}
  .share-action:disabled{opacity:.6;cursor:wait}
  .share-panel{margin-top:12px;padding:14px;border:1px solid var(--line);border-radius:8px;background:var(--paper)}
  .share-panel h3{font:600 .95rem/1.4 Inter,sans-serif;margin:0 0 8px}
  .share-panel p{font-size:.82rem;line-height:1.6;margin:0 0 12px}
  .share-panel label{display:block;margin:12px 0 6px;font-size:.78rem}
  .share-panel input,.share-panel textarea{box-sizing:border-box;display:block;width:100%;min-width:0;padding:10px;margin-bottom:10px;border:1px solid var(--line);border-radius:4px;background:var(--bg,#fff);color:var(--ink);font:400 .82rem/1.5 Inter,sans-serif}
  .share-panel textarea{resize:vertical;min-height:88px}
  .share-status{font-size:.8rem;line-height:1.5;margin:8px 0 0;color:var(--muted)}
  .share-status:empty{display:none}
  .product-share [hidden]{display:none!important}
  .product-share noscript{overflow-wrap:anywhere}
</style>
