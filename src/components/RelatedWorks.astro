---
// "Related works" for TJ Murphy paintings, chosen by shared tags (catalog/painting-tags.json, studio-tracker #248).
import ArtworkImage from './ArtworkImage.astro';
import { urlFor, statusLabel } from '../../catalog/catalog.mjs';
import { artworkAlt } from '../data/artwork-alt.mjs';
import { relatedWorks } from '../../catalog/related-works.mjs';
const { product } = Astro.props;
const works = relatedWorks(product);
---
{works.length >= 2 && <section class="related-works" aria-labelledby="related-works-heading">
  <h2 id="related-works-heading">Related works</h2>
  <ul class="related-works-grid">
    {works.map(w => <li class="related-work" data-related-id={w.id}>
      <a href={urlFor(w)} class="related-work-link">
        <span class="related-work-image"><ArtworkImage src={w.image.src} alt={artworkAlt(w)} width={w.image.width} height={w.image.height} loading="lazy" decoding="async" /></span>
        <span class="related-work-title">{w.title}</span>
      </a>
      <span class="related-work-meta">{w.relatedTags.slice(0, 2).join(' · ')}{statusLabel(w) && w.listing?.status !== 'not-for-sale' ? ` · ${statusLabel(w)}` : ''}</span>
    </li>)}
  </ul>
</section>}
<style is:global>
.related-works{margin:48px 0 24px;padding-top:28px;border-top:1px solid #e3dbd0}
.related-works h2{font:600 1.8rem/1.2 'Cormorant Garamond',serif;margin:0 0 18px}
.related-works-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.related-work-link{display:block;color:inherit;text-decoration:none}
.related-work-image{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;background:#f1ece4;border-radius:3px;overflow:hidden}
.related-work-image img,.related-work-image svg{width:100%;height:100%;object-fit:contain;padding:10px;box-sizing:border-box}
.related-work-title{display:block;margin-top:10px;font-weight:600;line-height:1.3}
.related-work-link:hover .related-work-title{text-decoration:underline}
.related-work-meta{display:block;margin-top:3px;font-size:.86rem;color:#665b52}
@media(max-width:720px){.related-works-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;padding-bottom:6px}.related-work{flex:0 0 62%;scroll-snap-align:start}}
</style>
