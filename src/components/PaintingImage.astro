---
import ArtworkImage from './ArtworkImage.astro';
import displayImages from '../../scripts/display-images.json';
// gallery: optional extra photos shown as thumbnails after the main painting (e.g. room shots).
//   [{base, widths, width, height, fallback, alt, caption}] -> `${base}-${w}.avif|webp` and a JPEG fallback.
// video: optional product video below the photos ({label, caption, poster, width, height, sources:[{src,type,media}]}).
const { image, title, gallery = [], video = null } = Astro.props;
const PRODUCT_SIZES = '(max-width: 980px) calc(100vw - 48px), 560px';
const srcset = (g, ext) => g.widths.map(w => `${g.base}-${w}.${ext} ${Math.min(w, g.width)}w`).join(', ');
const largest = g => `${g.base}-${g.widths.at(-1)}.webp`;
const mainThumb = (displayImages[image.src]?.variants || []).find(v => v.w >= 160)?.src || image.src;
const count = gallery.length + 1;
---
<div class="product-media">
<figure class="product-figure">
  <a class="painting-image-trigger" href={image.fullSrc||image.src} aria-label={`View ${title} full screen`} aria-haspopup="dialog" aria-controls="painting-lightbox">
    <ArtworkImage src={image.src} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" />
    <span class="painting-image-hint">View full screen <span aria-hidden="true">⤢</span></span>
  </a>
  <figcaption>{image.caption}</figcaption>
</figure>
{gallery.length > 0 && <ul class="product-thumbs" aria-label={`Photos of ${title}`} data-product-thumbs>
  <li><button type="button" class="product-thumb" aria-pressed="true" aria-label={`Show photo 1 of ${count}: ${image.alt}`} data-thumb-main>
    <img src={mainThumb} alt="" loading="lazy" decoding="async" />
  </button></li>
  {gallery.map((g, i) => <li><button type="button" class="product-thumb" aria-pressed="false" aria-label={`Show photo ${i + 2} of ${count}: ${g.alt}`}
      data-src={g.fallback} data-srcset={srcset(g, 'webp')} data-full={largest(g)} data-alt={g.alt} data-caption={g.caption || ''} data-width={g.width} data-height={g.height}>
    <picture>
      <source type="image/avif" srcset={`${g.base}-${g.widths[0]}.avif`} />
      <source type="image/webp" srcset={`${g.base}-${g.widths[0]}.webp`} />
      <img src={g.fallback} alt="" width={g.width} height={g.height} loading="lazy" decoding="async" />
    </picture>
  </button></li>)}
</ul>}
{video && <figure class="product-video">
  <video controls preload="metadata" playsinline poster={video.poster} width={video.width} height={video.height} aria-label={video.label} data-product-video>
    {video.sources.map(s => <source src={s.src} type={s.type} media={s.media} />)}
    <a href={video.sources.at(-1).src}>Download the video ({video.label})</a>
  </video>
  {video.caption && <figcaption>{video.caption}</figcaption>}
</figure>}
</div>
<dialog id="painting-lightbox" class="painting-lightbox" aria-label={`${title} — full-screen painting`}>
  <button class="painting-lightbox-close" type="button" autofocus>Close <span aria-hidden="true">×</span></button>
  <ArtworkImage src={image.fullSrc||image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
</dialog>

<script define:vars={{ PRODUCT_SIZES }}>
  // Thumbnails swap the main photo (and the full-screen view). The painting itself stays the first, default photo.
  const list = document.querySelector('[data-product-thumbs]');
  const figure = document.querySelector('.product-figure');
  const main = figure?.querySelector('.painting-image-trigger img');
  const box = document.querySelector('.painting-lightbox img');
  if (list && main) {
    const link = figure.querySelector('.painting-image-trigger'), caption = figure.querySelector('figcaption');
    const keep = el => Object.fromEntries(['src', 'srcset', 'sizes', 'alt', 'width', 'height'].map(a => [a, el?.getAttribute(a)]));
    const original = { main: keep(main), box: keep(box), href: link.getAttribute('href'), label: link.getAttribute('aria-label'), caption: caption?.textContent || '' };
    const set = (el, attrs) => { if (!el) return; for (const [a, v] of Object.entries(attrs)) v == null ? el.removeAttribute(a) : el.setAttribute(a, v); };
    list.addEventListener('click', event => {
      const button = event.target.closest('.product-thumb');
      if (!button || button.getAttribute('aria-pressed') === 'true') return;
      list.querySelectorAll('.product-thumb').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      if (button.hasAttribute('data-thumb-main')) {
        set(main, original.main); set(box, original.box);
        link.setAttribute('href', original.href); link.setAttribute('aria-label', original.label);
        if (caption) caption.textContent = original.caption;
        return;
      }
      const d = button.dataset;
      set(main, { srcset: d.srcset, sizes: PRODUCT_SIZES, src: d.src, alt: d.alt, width: d.width, height: d.height });
      set(box, { srcset: null, sizes: null, src: d.full, alt: d.alt, width: d.width, height: d.height });
      link.setAttribute('href', d.full); link.setAttribute('aria-label', `View photo full screen: ${d.alt}`);
      if (caption) caption.textContent = d.caption || d.alt;
    });
  }
</script>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>('.painting-image-trigger');
  const dialog = document.querySelector<HTMLDialogElement>('.painting-lightbox');
  if (trigger && dialog && typeof dialog.showModal === 'function') {
    let scrollX = 0, scrollY = 0, startedOnBackdrop = false;
    trigger.addEventListener('click', event => {
      // Keep the original image link available for new tabs and without JavaScript.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (dialog.open) return;
      scrollX = window.scrollX;
      scrollY = window.scrollY;
      document.documentElement.style.setProperty('--painting-viewer-scroll', `-${scrollY}px`);
      document.documentElement.classList.add('painting-viewer-open');
      dialog.showModal();
    });
    dialog.querySelector('button')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('pointerdown', event => {
      startedOnBackdrop = event.target === dialog;
    });
    dialog.addEventListener('click', event => {
      if (startedOnBackdrop && event.target === dialog) dialog.close();
      startedOnBackdrop = false;
    });
    // Native dialog supplies Escape closing, focus containment and an inert page.
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('painting-viewer-open');
      document.documentElement.style.removeProperty('--painting-viewer-scroll');
      window.scrollTo({ left: scrollX, top: scrollY, behavior: 'instant' });
      trigger.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .product-media { min-width: 0; }
  .painting-image-trigger { display: block; cursor: zoom-in; }
  .painting-image-trigger:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  .painting-image-hint { display: flex; align-items: center; justify-content: flex-end; gap: .4rem; margin-top: .65rem; color: var(--muted); font-size: .75rem; }
  .painting-image-hint span { font-size: 1.3rem; line-height: 1; }
  .product-thumbs { display: flex; flex-wrap: wrap; gap: .6rem; margin: .9rem 0 0; padding: 0; list-style: none; }
  .product-thumb { display: block; width: 76px; height: 76px; padding: 0; border: 1px solid var(--line); border-radius: 4px; background: var(--paper); cursor: pointer; overflow: hidden; }
  .product-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .product-thumb[aria-pressed="true"] { outline: 2px solid var(--accent); outline-offset: 2px; }
  .product-thumb:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .product-video { margin: 1.25rem 0 0; }
  .product-video video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #0f0d0b; border-radius: 4px; }
  .product-video figcaption { margin-top: .6rem; font-size: .875rem; color: var(--muted); }
  @media (max-width: 600px) { .product-thumb { width: 64px; height: 64px; } }
  .painting-lightbox { position: fixed; inset: 0; width: 100%; height: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; border: 0; padding: max(76px, calc(env(safe-area-inset-top) + 64px)) max(20px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(20px, env(safe-area-inset-left)); background: rgba(15, 13, 11, .97); color: #fff; overflow: hidden; cursor: zoom-out; }
  .painting-lightbox[open] { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); place-items: center; }
  .painting-lightbox::backdrop { background: #0f0d0b; }
  .painting-lightbox img { width: auto; height: auto; min-width: 0; min-height: 0; max-width: 100%; max-height: 100%; object-fit: contain; cursor: default; }
  .painting-lightbox-close { position: absolute; top: max(12px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); display: flex; align-items: center; gap: .65rem; min-height: 44px; padding: .4rem .85rem; border: 1px solid #8d8074; border-radius: 6px; background: #302b27; color: #fff; cursor: pointer; font-size: .875rem; }
  .painting-lightbox-close span { font-size: 1.6rem; line-height: 1; }
  .painting-lightbox-close:hover { background: #494139; }
  .painting-lightbox-close:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  :global(html.painting-viewer-open) { overflow: hidden; }
  :global(html.painting-viewer-open body) { position: fixed; top: var(--painting-viewer-scroll); width: 100%; overflow: hidden; }
</style>
