---
import SocialLinks from './SocialLinks.astro';
---
<footer class="site-footer">
        <div class="container footer-inner">
          <div class="footer-brand-block">
            <p class="footer-brand">TJ Murphy</p>
            <p class="footer-studio">Vermillion Aurora Productions</p>
            <SocialLinks class="social-links-compact footer-socials" />
          </div>
          <div class="footer-links">
            <a href="/murals/">Murals</a>
            <a href="/gallery/">Gallery</a>
            <a href="/#exhibitions">Exhibitions</a>
            <a href="/books/">Books</a>
            <a href="/commissions/">Commissions</a>
            <a href="/about/">About</a>
            <a href="/film/">Film</a>
            <a href="/testimonials/">Testimonials</a>
            <a href="/commissions/#form">Contact</a>
            <a href="/shipping-returns/">Shipping &amp; returns</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/links/">Social links</a>
          </div>
        </div>
      </footer>
<style>
  .footer-brand-block { display: grid; gap: 10px; }
  .footer-studio {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .footer-socials { margin-top: 4px; }
  @media (max-width: 700px) {
    .footer-inner { flex-direction: column; align-items: flex-start; padding: 28px 0; }
  }
</style>
