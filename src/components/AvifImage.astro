---
import { avifSrcset } from '../data/avif-srcset.mjs';
const { src, srcset, sizes, alt, width, height, loading, decoding, fetchpriority, style, class: className } = Astro.props;
const avif = avifSrcset(srcset || (typeof src === 'string' && src.endsWith('.webp') ? src : ''));
---
<picture>
  {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
  <img src={src} srcset={srcset} sizes={sizes} alt={alt} width={width} height={height} loading={loading} decoding={decoding} fetchpriority={fetchpriority} style={style} class={className} />
</picture>
<style>
  /* The img stays the layout box, so gallery grids keep the same size. Browsers that
     skip a source inside display:contents still use the WebP img. */
  picture { display: contents; }
</style>
