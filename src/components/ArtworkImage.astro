---
const { src, alt, width, height, ...attributes } = Astro.props;
// Display orientation only; retain the original photograph for print fulfillment.
const rotateLeft = src === 'https://media.vermillionaurora.com/images/Ex-Featured-Artist-Paul-Murphy/IMG_7416.jpeg';
---
{rotateLeft ? <svg xmlns="http://www.w3.org/2000/svg" class="oriented-painting-image" viewBox="0 0 3192 3450" width="3192" height="3450" role="img" aria-label={alt} data-image-src={src} data-image-alt={alt}>
  <image href={src} width="3450" height="3192" transform="translate(0 3450) rotate(-90)" />
</svg> : <img src={src} alt={alt} width={width} height={height} {...attributes} />}

<style is:global>
  .oriented-painting-image { display:block; width:100%; height:auto; }
  .product-figure .oriented-painting-image { max-height:75vh; }
  .gallery-product-image .oriented-painting-image { height:100%; }
  .painting-lightbox .oriented-painting-image { width:100%; height:100%; max-width:100%; max-height:100%; cursor:default; }
  @media(max-width:600px) { .product-figure .oriented-painting-image { max-height:65vh; } }
</style>
