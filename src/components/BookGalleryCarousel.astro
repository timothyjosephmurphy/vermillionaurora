---
import manifest from '../../catalog/book-galleries.json';
import {byId} from '../../catalog/catalog.mjs';
import {sectionArtworkIds} from '../data/canonical-artworks.mjs';
import {archivePaintings,archivePreview} from '../../catalog/archive-products.mjs';
import {olderWorkGroups,olderWorkPreview} from '../../catalog/older-work-products.mjs';
import {olderWorkPaintingCount} from '../data/older-work-gallery.mjs';
import {wallLabelGalleries} from '../../catalog/wall-label-galleries.mjs';
import {artworkAlt} from '../data/artwork-alt.mjs';
import {galleryHero} from '../data/gallery-hero.mjs';
import {HOME_STRIP_SIZES, homeStripSources} from '../data/home-strip-image.mjs';
const olderWorkCount=olderWorkPaintingCount();
const groups=manifest.sections;
const slideCount=groups.length+wallLabelGalleries.length+2;
const strip = (src) => homeStripSources(src);
---
<section id="book-galleries" class="section section-light"><div class="container">
  <div class="section-heading"><h2>Selected Galleries</h2></div>
  <div class="ex-carousel book-section-carousel" role="region" aria-roledescription="carousel" aria-label="Selected Galleries">
    <div class="ex-track" tabindex="0" aria-label="Swipe or use arrow keys to browse galleries">
      {groups.map(g=>{const p=byId[sectionArtworkIds(g)[0]];const thumb=strip(p.image.src);return <article class="ex-slide product-card"><a class="book-strip-thumb" href={`/book-galleries/${g.id}/`}>{thumb?.avif ? <picture><source type="image/avif" srcset={thumb.avif} sizes={thumb.sizes} /><img data-image-src={p.image.src} src={thumb.src} srcset={thumb.srcset} sizes={thumb.sizes} width={p.image.width} height={p.image.height} alt={p.title} loading="lazy" decoding="async" /></picture> : <img data-image-src={thumb ? p.image.src : undefined} src={thumb?.src || p.image.src} srcset={thumb?.srcset} sizes={thumb?.sizes} width={p.image.width} height={p.image.height} alt={p.title} loading="lazy" decoding="async" />}<div class="ex-slide-caption product-info"><p>{g.book==='watercolor-landscapes'?'Landscapes':'Portraits'}</p><h3>{g.title}</h3><p>{g.artworks.length} {g.artworks.length===1?'work':'works'} · Explore gallery →</p></div></a></article>})}
      {wallLabelGalleries.map(g=>{const hero=galleryHero(g);const thumb=strip(hero.image.src);return <article class="ex-slide product-card"><a class="book-strip-thumb" href={`/galleries/${g.id}/`}>{thumb?.avif ? <picture><source type="image/avif" srcset={thumb.avif} sizes={thumb.sizes} /><img data-image-src={hero.image.src} src={thumb.src} srcset={thumb.srcset} sizes={thumb.sizes} width={hero.image.width} height={hero.image.height} alt={artworkAlt(hero)} loading="lazy" decoding="async" /></picture> : <img data-image-src={thumb ? hero.image.src : undefined} src={thumb?.src || hero.image.src} srcset={thumb?.srcset} sizes={thumb?.sizes} width={hero.image.width} height={hero.image.height} alt={artworkAlt(hero)} loading="lazy" decoding="async" />}<div class="ex-slide-caption product-info"><p>Wall label</p><h3>{g.title}</h3><p>{g.works.length} {g.works.length===1?'work':'works'} · Explore gallery →</p></div></a></article>})}
      <article class="ex-slide product-card"><a class="book-strip-thumb" href="/gallery/archived/"><img src={archivePreview(archivePaintings[0],480)} alt="Archived Paintings by TJ Murphy" sizes={HOME_STRIP_SIZES} loading="lazy" decoding="async"/><div class="ex-slide-caption product-info"><p>From the studio archive</p><h3>Archived Paintings</h3><p>{archivePaintings.length} works · Explore gallery →</p></div></a></article>
      <article class="ex-slide product-card"><a class="book-strip-thumb" href="/gallery/older-work/"><img src={olderWorkPreview(olderWorkGroups[0],480)} alt="Older Work by TJ Murphy" sizes={HOME_STRIP_SIZES} loading="lazy" decoding="async"/><div class="ex-slide-caption product-info"><p>From the studio</p><h3>Older Work</h3><p>{olderWorkCount} works · Explore gallery →</p></div></a></article>
    </div>
    <div class="ex-controls" hidden><button type="button" class="ex-autoplay" aria-label="Pause automatic gallery scrolling">Pause</button><button type="button" data-direction="-1" aria-label="Previous gallery">←</button><p class="ex-position" role="status">1 / {slideCount}</p><button type="button" data-direction="1" aria-label="Next gallery">→</button><a href="/book-galleries/" class="button button-solid carousel-view-all">View all galleries</a></div>
  </div>
</div></section>
<style is:global>
  /* studio-tracker #777: portrait page scans were the tile height under object-fit:contain.
     Crop this carousel only. Exhibitions, murals, and featured works keep their own image rules. */
  .book-section-carousel .ex-slide img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    background: #f4efe8;
  }
</style>

