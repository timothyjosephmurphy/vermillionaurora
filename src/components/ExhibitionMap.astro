---
import locations from '../../exhibitions/world-map/locations.json';
import { testimonialPins } from '../data/testimonials.mjs';
const { compact = false } = Astro.props;
const point = ([lat,lon]: number[]) => ({ x:24+(lon+180)*3.2, y:30+(90-lat)*3.2 });
const kind = (place: typeof locations[number]) => place.exhibitions.every(item => item.type === 'mural') ? 'mural' : place.exhibitions.some(item => item.type === 'mural') ? 'mixed' : 'exhibition';
const color = (place: typeof locations[number]) => kind(place) === 'mural' ? '#236fa1' : kind(place) === 'mixed' ? 'url(#atlas-preview-mixed)' : '#d34220';
---
{compact ? <div class="exhibition-atlas atlas-compact">
  <svg class="atlas-art" viewBox="0 0 1200 650" role="img" aria-label="World map of exhibitions and murals in Seattle, Lillooet, San Salvador, Berlín in El Salvador, Warsaw, and Cape Town">
    <defs><linearGradient id="atlas-preview-mixed"><stop offset="50%" stop-color="#d34220"/><stop offset="50%" stop-color="#236fa1"/></linearGradient></defs>
    <image href="/exhibitions/world-map/land.svg" width="1200" height="650" />
    {locations.map(place => {const {x,y}=point(place.coordinates);return <circle cx={x} cy={y} r="5" fill={color(place)} stroke="#fffaf2" stroke-width="1.5"/>;})}
    <g class="atlas-preview-labels">
      <text x="270" y="116" text-anchor="middle">Seattle · Lillooet</text>
      <text x="290" y="320" text-anchor="middle">San Salvador · Berlín</text>
      <text x="695" y="151">Warsaw</text>
      <text x="690" y="430">Cape Town</text>
    </g>
  </svg>
</div> : <div class="exhibition-atlas" data-exhibition-atlas>
  <div class="atlas-toolbar" aria-label="Map views" hidden>
    <button type="button" data-map-view="world" aria-pressed="true">World view</button>
    <button type="button" data-map-view="northwest" aria-pressed="false">Seattle &amp; Lillooet</button>
    <button type="button" data-map-view="salvador" aria-pressed="false">San Salvador &amp; Berlín</button>
  </div>
  <ul class="atlas-legend" aria-label="Pin colors">
    <li data-kind="exhibition"><span class="legend-dot" aria-hidden="true"></span>Exhibitions</li>
    <li data-kind="mural"><span class="legend-dot" aria-hidden="true"></span>Murals</li>
    <li data-kind="mixed"><span class="legend-dot" aria-hidden="true"></span>Both</li>
    {testimonialPins.length > 0 && <li data-kind="testimonial"><span class="legend-dot" aria-hidden="true"></span><a href="/testimonials/">Collector testimonials</a></li>}
  </ul>
  <script type="application/json" data-testimonial-pins set:html={JSON.stringify(testimonialPins).replace(/</g,'\\u003c')} />
  <div class="atlas-layout">
    <div class="atlas-canvas" role="region" aria-label="Interactive map of exhibitions and murals">
      <div class="atlas-fallback"><img src="/exhibitions/world-map/land.svg" alt="World map"/><p>Choose a city to explore its exhibitions and murals.</p></div>
    </div>
    <div class="atlas-places" aria-label="Exhibitions and murals by location">
      <h2>Explore a place</h2>
      <p class="atlas-instructions" role="status">Choose a city to see its exhibitions and murals.</p>
      {locations.map(place => <details id={`map-${place.id}`} class="atlas-place" data-place={place.id} data-city={place.city} data-lat={place.coordinates[0]} data-lng={place.coordinates[1]} data-region={place.region || place.id} data-number={place.number} data-kind={kind(place)}>
        <summary><span class="pin-number" aria-hidden="true">{place.number}</span><span>{place.city}<small>{place.country}</small></span></summary>
        <ul>{place.exhibitions.map(exhibition => <li><a href={exhibition.href||`/exhibitions/${exhibition.slug}/`}>{exhibition.name}{exhibition.type==='mural'&&<span> · Mural</span>}{exhibition.date&&<span class="exhibition-date"> · {exhibition.date}</span>}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
      </details>)}
    </div>
  </div>
</div>}
<style>
  .exhibition-atlas{background:#f3eee5;border-radius:8px;color:#3d3027;isolation:isolate;overflow:hidden}
  .atlas-art{display:block;width:100%;height:auto;font-family:Inter,Arial,sans-serif}.atlas-compact{border-radius:0}
  .atlas-preview-labels{fill:#3d3027;font-size:25px;font-weight:600;paint-order:stroke;stroke:#f3eee5;stroke-width:5px;stroke-linejoin:round}
  .atlas-toolbar{display:flex;flex-wrap:wrap;gap:8px;padding:16px;border-bottom:1px solid #d7ccba}.atlas-toolbar[hidden]{display:none}
  .atlas-toolbar button{font:500 .82rem/1.4 Inter,Arial,sans-serif;min-height:42px;padding:9px 14px;border:1px solid #cdbfae;border-radius:24px;background:#fffcf6;color:#3d3027;cursor:pointer}
  .atlas-toolbar button[aria-pressed="true"]{background:#bd381c;border-color:#bd381c;color:white}
  .atlas-legend{display:flex;flex-wrap:wrap;gap:12px 22px;list-style:none;padding:12px 18px;margin:0;border-bottom:1px solid #d7ccba;font:.8rem/1.4 Inter,Arial,sans-serif}
  .atlas-legend li{display:flex;align-items:center;gap:7px}.legend-dot{display:inline-block;width:14px;height:14px;border-radius:50%;background:#d34220}
  [data-kind="mural"] :is(.pin-number,.legend-dot){background:#236fa1}
  [data-kind="testimonial"] .legend-dot{background:#2f8a4c}
  .atlas-canvas :global(.atlas-testimonial){width:14px;height:14px;border-radius:50%;background:#2f8a4c;border:2px solid #fffcf6;box-shadow:0 0 0 1px #2f8a4c}
  [data-kind="mixed"] :is(.pin-number,.legend-dot){background:linear-gradient(90deg,#d34220 50%,#236fa1 50%)}
  .atlas-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;align-items:stretch}
  .atlas-canvas{min-height:570px;min-width:0;background:#f3eee5;z-index:0}
  .atlas-fallback img{width:100%}.atlas-fallback p{padding:16px;font-size:.9rem}
  .atlas-places{padding:22px 18px}.atlas-places h2{font:600 1.7rem/1.1 "Cormorant Garamond",serif;margin:0 0 9px}
  .atlas-instructions{font-size:.8rem;line-height:1.6;color:#776356;margin:0 0 18px}
  .atlas-place{background:#fffcf6;border:1px solid #d7ccba;border-radius:6px;scroll-margin-top:150px}.atlas-place+.atlas-place{margin-top:8px}
  .atlas-place summary{display:flex;align-items:center;gap:10px;position:relative;padding:13px 28px 13px 12px;cursor:pointer;list-style:none;font:600 1rem/1.3 Inter,Arial,sans-serif}
  .atlas-place summary::-webkit-details-marker{display:none}.atlas-place summary::after{content:'+';position:absolute;right:12px;color:#9e3218;font-size:1.2rem}.atlas-place[open] summary::after{content:'−'}
  .atlas-place[open]{border-color:#bd381c}.atlas-place summary small{display:block;font:400 .7rem/1.5 Inter,Arial,sans-serif;margin-top:3px;color:#776356}
  .pin-number{flex:none;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#d34220;color:white;font:600 .78rem/1 Inter,Arial,sans-serif}
  .atlas-place ul{margin:0;padding:0 14px 16px;list-style:none}.atlas-place li+li{margin-top:12px}
  .atlas-place a{font-size:.82rem;line-height:1.6;text-decoration:underline;text-underline-offset:3px;display:inline-block}.atlas-place a:hover{color:#ad321b}
  .exhibition-atlas :is(a,button,summary):focus-visible{outline:3px solid #bd381c;outline-offset:3px}
  .atlas-canvas :global(.atlas-marker){border:0;background:none}.atlas-canvas :global(.atlas-marker svg){display:block;overflow:visible}
  .atlas-canvas :global(.atlas-marker[aria-expanded="true"] path){stroke:#3d3027;stroke-width:3}
  .atlas-canvas :global(.atlas-cluster){display:grid;place-items:center;border:3px solid #fffcf6;border-radius:50%;background:#d34220;color:white;box-shadow:0 0 0 5px #3d302726;font:700 16px/1 Inter,Arial,sans-serif}
  .atlas-canvas :global(.atlas-cluster[data-kind="mural"]){background:#236fa1}
  .atlas-canvas :global(.atlas-cluster[data-kind="mixed"]){background:linear-gradient(90deg,#d34220 50%,#236fa1 50%)}
  .atlas-canvas :global(.leaflet-marker-icon:focus-visible){outline:3px solid #63220f;outline-offset:5px}
  .atlas-canvas :global(.leaflet-tooltip){font:500 12px/1.4 Inter,Arial,sans-serif}
  @media(max-width:850px){.atlas-layout{grid-template-columns:1fr}.atlas-canvas{height:430px;min-height:0}.atlas-places{padding:22px 16px}.atlas-place summary{min-height:70px}.atlas-place ul{padding-left:48px}.atlas-toolbar{padding:12px}.atlas-toolbar button{font-size:.76rem;padding-inline:11px}}
  @media(max-width:420px){.atlas-canvas{height:360px}}
</style>
