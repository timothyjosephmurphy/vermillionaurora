---
import locations from '../../exhibitions/world-map/locations.json';
const { compact = false } = Astro.props;
const point = ([lat,lon]: number[]) => ({ x:24+(lon+180)*3.2, y:30+(90-lat)*3.2 });
const leaderEnds: Record<string,string> = { seattle:'210,242', 'el-salvador':'215,638', warsaw:'825,176', 'cape-town':'835,638' };
---
<div class:list={['exhibition-atlas', { 'atlas-compact': compact }]}>
  {[...(compact ? [false] : [true,false])].map(expanded =>
    <svg class:list={['atlas-art',expanded?'atlas-expanded':'atlas-small']} viewBox={`0 0 1200 ${expanded?800:650}`} role="img" aria-label="World map of exhibitions in Seattle, the San Salvador area, Warsaw, and Cape Town">
      <image href="/exhibitions/world-map/land.svg" x="0" y={expanded?135:0} width="1200" height="650" />
      {locations.map(place => {
        const {x,y:originalY}=point(place.coordinates);
        const y=originalY+(expanded?135:0);
        return <g>
          {expanded && <polyline points={`${x},${y} ${leaderEnds[place.id]}`} fill="none" stroke="#ad8673" stroke-width="1.5" />}
          <circle cx={x} cy={y} r="23" fill="#d34220" opacity=".13" />
          <path d={`M ${x} ${y+10} C ${x-4} ${y+4},${x-15} ${y-5},${x-15} ${y-16} A 15 15 0 1 1 ${x+15} ${y-16} C ${x+15} ${y-5},${x+4} ${y+4},${x} ${y+10} Z`} fill="#bd381c" stroke="#fffaf2" stroke-width="2" />
          <text x={x} y={y-11} text-anchor="middle" fill="white" font-size="15" font-weight="700">{place.number}</text>
          {!expanded && <text x={x+25} y={y-5} fill="#3d3027" font-size="22" font-weight="600" paint-order="stroke" stroke="#f3eee5" stroke-width="5" stroke-linejoin="round">{place.city}</text>}
        </g>;
      })}
    </svg>
  )}
  {!compact && <div class="atlas-labels">
    {locations.map(place => <section id={`map-${place.id}`} class:list={['atlas-label',place.labelClass]} aria-labelledby={`map-${place.id}-title`}>
      <h2 id={`map-${place.id}-title`}><span class="pin-number" aria-label={`Pin ${place.number}`}>{place.number}</span>{place.city}<small>{place.country}</small></h2>
      <ul>{place.exhibitions.map(exhibition => <li><a href={`/exhibitions/${exhibition.slug}/`}>{exhibition.name}<span class="exhibition-date"> · {exhibition.date}</span><span aria-hidden="true"> ↗</span></a></li>)}</ul>
    </section>)}
  </div>}
</div>
<style>
  .exhibition-atlas{position:relative;background:#f3eee5;border-radius:8px;color:#3d3027;isolation:isolate}
  .atlas-art{display:block;width:100%;height:auto;font-family:Inter,Arial,sans-serif}
  .atlas-small{display:none}.atlas-compact .atlas-small{display:block}.atlas-compact{border-radius:0}
  .atlas-label{position:absolute;background:rgba(255,252,246,.96);border:1px solid #d7ccba;border-radius:6px;padding:18px 20px;width:30%;box-shadow:0 5px 20px #55432a08}
  .atlas-label.seattle{left:2%;top:3%;width:35%}.atlas-label.warsaw{right:2%;top:3%}.atlas-label.salvador{left:2%;bottom:3%;width:35%}.atlas-label.cape{right:2%;bottom:3%}
  .atlas-label h2{font:600 1.65rem/1.1 "Cormorant Garamond",serif;margin:0 0 14px;padding-left:36px;position:relative}
  .atlas-label h2 small{display:block;font:500 .67rem/1.5 Inter,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin-top:4px;color:#776356}
  .pin-number{position:absolute;left:0;top:1px;display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#bd381c;color:white;font:600 .78rem/1 Inter,Arial,sans-serif}
  .atlas-label ul{margin:0;padding:0;list-style:none}.atlas-label li+li{margin-top:9px}
  .atlas-label a{font-size:.8rem;line-height:1.5;text-decoration:underline;text-underline-offset:3px;display:inline-block}
  .atlas-label a:hover{color:#ad321b}.atlas-label a:focus-visible{outline:3px solid #bd381c;outline-offset:4px}
  @media(max-width:1050px){.atlas-expanded{display:none}.atlas-small{display:block}.atlas-labels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:0 18px 20px}.atlas-label.seattle,.atlas-label.warsaw,.atlas-label.salvador,.atlas-label.cape{position:static;width:auto}.atlas-label a{font-size:.85rem}}
  @media(max-width:560px){.atlas-labels{grid-template-columns:1fr}.atlas-label{padding:18px}.atlas-label h2{font-size:1.7rem}}
</style>
