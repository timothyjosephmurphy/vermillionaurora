---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import {catalogVersion} from '../../catalog/catalog.mjs';
import {tjWall,paulWall,notToScale,statusOrder} from '../data/paintings-wall.mjs';
const {who}=Astro.props;
const wall=who==='paul'?paulWall:tjWall,list=wall.artworks;
const copy=who==='paul'
  ?{path:'/gallery/wall/paul/',title:"Paul Murphy's Paintings on the Wall | TJ Murphy",h1:"Paul Murphy's paintings",label:'Zoomable gallery of Paul Murphy\u2019s paintings',desc:"Explore every painting by Paul Murphy on one zoomable gallery wall, shown at true relative scale.",help:'Pinch or scroll to move closer. Drag to explore. Click once to see a painting\u2019s details; click again to open its story.'}
  :{path:'/gallery/wall/all/',title:'All Paintings on the Wall | TJ Murphy',h1:'All the paintings',label:'Zoomable gallery of all of TJ Murphy\u2019s paintings',desc:"Explore every painting by TJ Murphy on one zoomable gallery wall at true relative scale: available, sold and not for sale.",help:'Pinch or scroll to move closer. Drag to explore. Click once to see a painting\u2019s details; click again to open its story.'};
const counts=Object.fromEntries(statusOrder.map(([key])=>[key,key==='all'?list.length:list.filter(a=>a.status===key).length]));
const data=JSON.stringify({artworks:list.map(({mismatch,alt,...art})=>art),world:wall.world,wall:who==='paul'?'paul':'all'}).replace(/</g,'\\u003c');
const unsized=who==='paul'?[]:notToScale;
const groups=[['Commission packages',unsized.filter(i=>i.kind==='Commission package')],['Art-book pages',unsized.filter(i=>i.kind==='Art-book page')],['Archived Paintings',unsized.filter(i=>i.kind==='Archived painting')],['Older Work',unsized.filter(i=>i.kind==='Older Work')],['Strawberry Point Hiking Trip',unsized.filter(i=>i.kind==='Strawberry Point Hiking Trip')]].filter(([,items])=>items.length);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{copy.title}</title>
  <meta name="description" content={copy.desc} />
  <meta name="catalog-version" content={catalogVersion} />
  <link rel="canonical" href={`https://tjm.art${copy.path}`} />
  <meta property="og:title" content={copy.title} />
  <meta property="og:description" content={copy.desc} />
  <meta property="og:type" content="website" /><meta property="og:url" content={`https://tjm.art${copy.path}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" /><link rel="stylesheet" href="/site-header.css" /><link rel="stylesheet" href="/payments/cart.css" />
  <script is:inline src="/payments/cart.js" defer></script>
  <script is:inline>
    // A second navigation can cancel a native cross-document transition.
    for(const name of ['pageswap','pagereveal'])addEventListener(name,event=>{
      const transition=event.viewTransition;if(!transition)return;
      for(const promise of [transition.ready,transition.finished,transition.updateCallbackDone])promise.catch(error=>{if(error.name!=='AbortError')throw error;});
    });
  </script>
  <style is:global>
    @view-transition{navigation:none}
    ::view-transition-group(wall-painting){animation-duration:.48s;animation-timing-function:cubic-bezier(.22,1,.36,1)}
    ::view-transition-old(root),::view-transition-new(root){animation-duration:.3s}
    @media(prefers-reduced-motion:reduce){::view-transition-group(*){animation-duration:.01ms!important}}
  </style>
  <style is:global>
  .print-wall-page{background:#f7f3ec;color:#29241f}
  .print-wall-main{max-width:1880px;margin:0 auto;padding:10px 24px 48px}
  .wall-intro{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:0 0 8px}.wall-intro>div{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .wall-back{font-size:12px;text-decoration:none;color:#7c6554}
  .wall-intro h1{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.1;margin:0;letter-spacing:-.015em}
  .wall-intro>p{max-width:420px;font-size:11px;line-height:1.4;color:#736858;margin:0;text-align:right}
  .wall-viewport{position:relative;height:max(320px,calc(100svh - var(--wall-top,180px) - 12px));overflow:clip;isolation:isolate;overscroll-behavior:contain;background:radial-gradient(ellipse at 50% 15%,#faf8f3,#e9e3d8);border:1px solid #d9d0c3;border-radius:4px;cursor:grab}
  .wall-canvas{position:absolute;inset:0;touch-action:none}
  .wall-viewport:focus-visible{outline:2px solid #c64e32;outline-offset:4px}
  .wall-viewport.is-dragging{cursor:grabbing}
  .wall-viewport:fullscreen{height:100dvh;width:100vw;border:0;border-radius:0;min-height:0}
  .wall-immersive{overflow:hidden}
  .wall-immersive .site-header{visibility:hidden;pointer-events:none}
  .wall-immersive .wall-viewport{position:fixed;inset:0;width:100%;height:100dvh;min-height:0;border:0;border-radius:0;z-index:10000}
  .wall-immersive .wall-picker{display:none}
  .wall-immersive .wall-tools{justify-content:center;bottom:max(8px,env(safe-area-inset-bottom));left:8px;right:8px}
  [data-inspecting] .wall-canvas{clip-path:inset(0 0 308px 0)}
  [data-inspecting][data-inspection-side="true"] .wall-canvas{clip-path:inset(0 260px 64px 0)}
  .wall-scene{position:absolute;top:0;left:0;transform-origin:0 0;user-select:none;will-change:transform;background:radial-gradient(ellipse at 50% 10%,#fbf8f2,#ebe6dd)}
  .wall-floor{position:absolute;left:0;right:0;bottom:0;height:40px;background:linear-gradient(#baa181,#dfc4a0);border-top:14px solid #f8f6ef;box-shadow:0 -1px 0 #d3cabc}
  .wall-art{box-sizing:border-box;position:absolute;display:flex;align-items:center;justify-content:center;background:#fffefb;border-style:solid;border-color:#262321;box-shadow:3px 5px 5px #29201940,inset 0 0 2px #7776;text-decoration:none;color:inherit;cursor:pointer;outline-offset:5px}
  .wall-art:focus-visible{outline:2px solid #d35a3b}
  .wall-art img{display:block;flex-shrink:0;max-width:none;max-height:none;object-fit:contain;pointer-events:none;user-select:none;-webkit-user-drag:none}
  .wall-tools{position:absolute;z-index:5;left:16px;right:16px;bottom:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;pointer-events:none}
  .wall-tools>*{pointer-events:auto}
  .wall-zoom-tools,.wall-picker select{background:rgba(255,253,247,.91);backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px);border:1px solid #fff9;box-shadow:0 3px 18px #3627161a;border-radius:9px;color:#302920;font:12px Inter,system-ui,sans-serif}
  .wall-picker select{max-width:260px;width:100%;min-height:44px;padding:10px 28px 10px 12px;cursor:pointer}
  .wall-zoom-tools{display:flex;align-items:center;padding:3px;gap:1px}
  .wall-zoom-tools button{min-height:40px;min-width:40px;padding:6px 12px;border:0;border-radius:6px;background:none;color:inherit;font:inherit;cursor:pointer;white-space:nowrap}
  .wall-zoom-tools button[data-wall-plus],.wall-zoom-tools button[data-wall-minus]{font-size:22px;padding:0 8px}
  .wall-zoom-tools output{min-width:46px;text-align:center;font-variant-numeric:tabular-nums;font-size:11px;color:#807364}
  .wall-zoom-tools button:hover{background:#e8ded0}
  .wall-zoom-tools button:disabled{opacity:.3;cursor:default}
  .wall-zoom-tools button:focus-visible,.wall-picker select:focus-visible{outline:2px solid #c64e32;outline-offset:2px}
  .wall-glass{position:absolute;z-index:4;box-sizing:border-box;width:236px;height:220px;padding:12px;border:1px solid #ffffffbd;border-radius:12px;background:rgba(252,249,243,.79);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 5px 22px #2f241318;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .16s ease;cursor:default;display:grid;grid-template-rows:12px 38px 18px 14px 16px 34px 16px;gap:5px}
  .wall-glass.is-visible{opacity:1;visibility:visible}
  .wall-glass.is-visible a,.wall-glass.is-visible button{pointer-events:auto}
  .wall-glass-close{position:absolute;top:0;right:0;width:28px;height:28px;background:none;border:0;color:#80715f;font-size:20px;cursor:pointer}
  .wall-glass-eyebrow{font:8px/12px Inter,system-ui,sans-serif;letter-spacing:.04em;text-transform:uppercase;color:#8c7158;margin:0 18px 0 0;white-space:nowrap}
  .wall-glass h2{font:500 19px/19px 'Cormorant Garamond',Georgia,serif;letter-spacing:-.01em;margin:0 12px 0 0;color:#292119;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .wall-glass-meta,.wall-glass-size,.wall-glass-state{font:10px/14px Inter,system-ui,sans-serif;color:#6f6451;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.wall-glass-state{font-weight:600;color:#3d3328}.wall-glass-buy[hidden]{display:block;visibility:hidden}
  .wall-glass-price{font:500 16px/22px Inter,system-ui,sans-serif;margin:0;letter-spacing:-.02em}
  .wall-glass-specs{display:grid;gap:0;font:9px/13px Inter,system-ui,sans-serif;color:#736754;margin:0}
  .wall-glass-specs span:last-child{display:none}
  .wall-glass-buy{display:flex;align-items:center;text-decoration:none;box-sizing:border-box;width:100%;min-height:34px;background:#c65032;border:1px solid #c65032;color:#fffaf6;border-radius:6px;font:500 10px Inter,system-ui,sans-serif;padding:6px;cursor:pointer;justify-content:center;letter-spacing:.02em}
  .wall-glass-buy:disabled{opacity:.5;cursor:default}
  .wall-glass-links{display:flex;justify-content:space-between;gap:8px;font:9px/16px Inter,system-ui,sans-serif}
  .wall-glass-links a{color:#70503b;text-underline-offset:3px}
  .wall-glass-message{font:9px/12px Inter,system-ui,sans-serif;margin:0;color:#704e32}
  .wall-caption{display:flex;justify-content:space-between;gap:24px;color:#857563;font-size:10px;line-height:1.6;margin:12px 0 28px}
  .wall-caption p{margin:0}
  .wall-index{border-top:1px solid #ded5c8;padding:16px 0;font-size:12px;color:#705b47}
  .wall-index summary{cursor:pointer;min-height:32px}
  .wall-index ul{columns:3;list-style:none;padding:10px 0 0;margin:0}
  .wall-index li{break-inside:avoid;margin:0 0 12px;line-height:1.5}.wall-index a{color:inherit;text-underline-offset:3px}
  @media(max-width:760px){
    .print-wall-main{padding:6px 8px 30px}.wall-intro{display:block;margin:0 4px 6px}.wall-intro>div{gap:8px 10px}.wall-intro>p{display:none}
    .wall-tools{left:8px;right:8px;bottom:8px;gap:6px;flex-wrap:wrap;justify-content:center}
    .wall-picker{flex-basis:100%;display:flex;justify-content:center}.wall-picker select{max-width:230px;font-size:11px;min-height:38px}
    .wall-zoom-tools button{font-size:11px;min-height:38px;padding:5px 10px}
    .wall-caption{display:block;font-size:9px;margin-left:5px}.wall-caption p+p{margin-top:5px}.wall-index ul{columns:2}
  }
  .wall-switch{display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0;list-style:none}.wall-switch a{min-height:30px!important;padding:4px 12px!important}
  .wall-switch a,.wall-filter button{display:inline-flex;align-items:center;min-height:36px;padding:6px 14px;border:1px solid #d3c8b8;border-radius:999px;background:#fffdf8;color:#4a3d30;font:500 12px Inter,system-ui,sans-serif;text-decoration:none;cursor:pointer}
  .wall-switch a[aria-current="page"],.wall-filter button[aria-pressed="true"]{background:#2f2922;border-color:#2f2922;color:#fffaf2}
  .wall-switch a:focus-visible,.wall-filter button:focus-visible{outline:2px solid #c64e32;outline-offset:2px}
  .wall-filter{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:0 0 6px}.wall-filter button{min-height:30px;padding:4px 12px}
  .wall-filter>span{font:11px Inter,system-ui,sans-serif;color:#7c6c5a;margin-right:4px}
  .wall-art.is-dimmed{opacity:.14;pointer-events:none;box-shadow:none}
  .wall-unsized{border-top:1px solid #ded5c8;padding:16px 0;font-size:12px;color:#705b47}
  .wall-unsized summary{cursor:pointer;min-height:32px;font-weight:600}
  .wall-unsized h3{font:600 12px Inter,system-ui,sans-serif;margin:14px 0 6px}
  .wall-unsized ul{columns:3;list-style:none;padding:4px 0 0;margin:0}
  .wall-unsized li{break-inside:avoid;margin:0 0 8px;line-height:1.45}.wall-unsized a{color:inherit;text-underline-offset:3px}
  @media(max-width:760px){.wall-unsized ul{columns:1}.wall-switch a,.wall-filter button{font-size:11px;padding:6px 11px}}
  @media(prefers-reduced-motion:reduce){.wall-glass{transition:none}}
</style>
</head>
<body class="print-wall-page paintings-wall-page">
  <div class="page-shell">
    <SiteHeader />
    <main id="main-content" class="print-wall-main" data-gallery-wall data-paintings-wall={who==='paul'?'paul':'all'}>
      <header class="wall-intro">
        <div><a class="wall-back" href="/gallery/">← Gallery</a><h1>{copy.h1}</h1>
          <ul class="wall-switch" aria-label="Choose a wall">
            <li><a href="/gallery/wall/all/" aria-current={who==='paul'?undefined:'page'}>TJ Murphy ({tjWall.artworks.length})</a></li>
            <li><a href="/gallery/wall/paul/" aria-current={who==='paul'?'page':undefined}>Paul Murphy ({paulWall.artworks.length})</a></li>
          </ul>
        </div>
        <p id="wall-help">{copy.help}</p>
      </header>
      <div class="wall-filter" role="group" aria-label="Show paintings by status" data-wall-filter hidden>
        <span>Show</span>{statusOrder.filter(([key])=>counts[key]>0).map(([key,label])=><button type="button" data-filter={key} aria-pressed={key==='all'?'true':'false'}>{label} ({counts[key]})</button>)}
      </div>
      <section class="wall-viewport" data-wall-viewport tabindex="0" aria-label={copy.label} aria-describedby="wall-help wall-keyboard">
        <div class="wall-canvas">
        <div class="wall-scene" data-wall-scene style={`width:${wall.world.width}px;height:${wall.world.height}px`}>
          <div class="wall-floor" aria-hidden="true"></div>
          {list.map(art=><a
            class="wall-art" data-wall-art={art.id} data-status={art.status} href={art.href} aria-label={`${art.title} — view painting`}
            style={`left:${art.x}px;top:${art.y}px;width:${art.width}px;height:${art.height}px;border-width:${art.frameWidth}px`}
          >
            <img data-art-image={art.id} src={art.sources[0].src} alt={art.alt} width={art.sourceWidth} height={art.sourceHeight} decoding="async" draggable="false"
              style={`width:${art.imageWidth}px;height:${art.imageHeight}px`} />
          </a>)}
        </div>
        </div>
        <div class="wall-tools" data-wall-ui>
          <label class="wall-picker"><span class="visually-hidden">Find a painting</span><select data-wall-picker aria-label="Find a painting"><option value="">Find a painting</option>{list.map(art=><option value={art.id}>{art.title}</option>)}</select></label>
          <div class="wall-zoom-tools" role="group" aria-label="Gallery zoom controls">
            <button type="button" data-wall-minus aria-label="Zoom out">−</button><output data-wall-zoom aria-label="Zoom level">100%</output><button type="button" data-wall-plus aria-label="Zoom in">+</button>
            <button type="button" data-wall-fit>Fit wall</button><button type="button" data-wall-fullscreen>Full screen</button>
          </div>
        </div>
        <aside class="wall-glass" data-wall-panel data-wall-ui aria-labelledby="wall-product-title" aria-hidden="true" inert>
          <button class="wall-glass-close" type="button" data-wall-close aria-label="Hide painting details">×</button>
          <p class="wall-glass-eyebrow" data-wall-artist></p>
          <h2 id="wall-product-title" data-wall-title></h2>
          <p class="wall-glass-meta" data-wall-medium></p>
          <p class="wall-glass-size" data-wall-size></p>
          <p class="wall-glass-state" data-wall-state></p>
          <a class="button button-solid wall-glass-buy" data-wall-buy href="/gallery/" hidden>Buy</a>
          <div class="wall-glass-links"><a data-wall-product href="/gallery/">Painting &amp; story</a></div>
        </aside>
      </section>
      <div class="wall-caption">
        <p>{list.length} paintings · Shown at true relative scale{list.some(a=>a.scaleBasis==='print')&&` (${list.filter(a=>a.scaleBasis==='print').length} without a recorded size are shown at their largest print size)`} · Each photo is shown in its own shape</p>
        <p id="wall-keyboard">Keyboard: + / − to zoom, arrows to move, Esc or 0 to return to the wall.</p>
      </div>
      <p class="visually-hidden" data-wall-status role="status" aria-live="polite"></p>
      <details class="wall-index" data-wall-index open><summary>Browse the paintings</summary><ul>{list.map(art=><li><a href={art.href}>{art.title}</a> <span class="visually-hidden">— </span><small>{art.statusLabel}</small></li>)}</ul></details>
      {groups.length>0 && <details class="wall-unsized" data-wall-unsized><summary>Not shown to scale ({unsized.length})</summary>
        <p>These have no painting size, so they are listed here instead of on the wall.</p>
        {groups.map(([label,items])=><section><h3>{label} ({items.length})</h3><ul>{items.map(item=><li><a href={item.href}>{item.title}</a></li>)}</ul></section>)}
      </details>}
      <script type="application/json" data-wall-data set:html={data}></script>
      <noscript><style>.wall-viewport{display:none!important}.wall-index{display:block}.wall-unsized{display:block}</style><p>Open “Browse the paintings” for links to every artwork.</p></noscript>
    </main>
    <SiteFooter />
  </div>
  <script>import '../scripts/paintings-wall.js';</script>
</body>
</html>
