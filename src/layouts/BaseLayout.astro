---
// Optional document head for installable pages.
// manifestHref defaults to the site-wide manifest (display: browser).
// Neural Dance passes its own manifest so a page never emits two manifest links.
const {
  manifestHref = '/site.webmanifest',
  standalone = false,
  appleTitle = 'Neural Dance',
  themeColor = standalone ? '#070a12' : undefined,
} = Astro.props;
---
<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
<link rel="manifest" href={manifestHref} />
{standalone && (
  <>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={appleTitle} />
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <script is:inline>
      if (window.navigator.standalone === true || (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches)) {
        document.documentElement.classList.add('nd-standalone');
      }
    </script>
    <link rel="stylesheet" href="/neural-dance/standalone.css" />
    <script is:inline type="module" src="/neural-dance/standalone.js"></script>
  </>
)}
