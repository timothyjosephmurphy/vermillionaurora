---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const {title,description,noindex=false}=Astro.props;
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} | TJ Murphy</title><meta name="description" content={description}/>
<meta name="referrer" content="same-origin"/>
{noindex?<meta name="robots" content="noindex,nofollow"/>:<link rel="canonical" href={`https://vermillionaurora.com${Astro.url.pathname}`}/>}
<link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/site-header.css"/>
<style is:global>
.policy-page{max-width:850px;padding-top:48px;padding-bottom:72px;line-height:1.75}.policy-page h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.15}.policy-page h2{margin-top:2rem;line-height:1.3}.policy-page a{text-decoration:underline;text-underline-offset:3px}.policy-page table{width:100%;border-collapse:collapse;margin:20px 0}.policy-page th,.policy-page td{text-align:left;padding:12px;border-bottom:1px solid #bcb4a8;vertical-align:top}.policy-page nav{display:flex;flex-wrap:wrap;gap:20px}.policy-page input{max-width:100%;padding:10px}.policy-page button{margin:6px 10px 6px 0}.policy-page article{border-top:1px solid #bcb4a8;padding:20px 0}.policy-page code{overflow-wrap:anywhere}
</style></head><body><div class="page-shell"><SiteHeader/><main id="main-content" class="container policy-page"><h1>{title}</h1><slot/></main><SiteFooter/></div></body></html>
