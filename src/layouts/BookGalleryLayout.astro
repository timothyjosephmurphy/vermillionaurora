---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const {title,description}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Vermillion Aurora</title><meta name="description" content={description}/><link rel="canonical" href={`https://vermillionaurora.com${Astro.url.pathname}`}/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"/><link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/site-header.css"/><link rel="stylesheet" href="/exhibitions/viewer.css"/><link rel="stylesheet" href="/gallery/painting-list.css"/></head><body class="book-gallery-page"><div class="page-shell"><SiteHeader/><main class="container book-gallery-main"><slot/></main><SiteFooter/></div><script is:inline src="/exhibitions/viewer.js" defer></script></body></html>
<style is:global>
.book-gallery-main{padding-top:35px;padding-bottom:70px}.book-gallery-main h1{font-family:'Cormorant Garamond',serif;font-size:clamp(2.6rem,5vw,4rem);margin:12px 0}.book-gallery-intro{max-width:780px;margin-bottom:28px}.book-gallery-intro p{line-height:1.65}.book-gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 24px;padding:0;list-style:none}.book-gallery-card{min-width:0}.book-gallery-card>a{text-decoration:none;color:inherit}.book-gallery-card img{width:100%;height:310px;object-fit:contain;background:#f4efe8;border-radius:4px;display:block}.book-gallery-card h2,.book-gallery-card h3{font-family:'Cormorant Garamond',serif;font-size:1.6rem;margin:14px 0 7px}.book-gallery-card p{font-size:.9rem;line-height:1.5;margin:5px 0;color:#665b52}.book-gallery-card .print-available{color:#a34528;font-weight:600}.book-gallery-links{display:flex;gap:18px;flex-wrap:wrap;margin-top:20px}.book-gallery-card a:focus-visible{outline:3px solid #bc5034;outline-offset:5px}.book-group-heading{margin-top:38px;font-size:2rem}.book-gallery-page .book-gallery-main>.exhibition-viewer{margin:8px 0 30px}.book-gallery-page .ev-three-up .ev-stage{height:clamp(240px,38vw,500px)}.book-gallery-page .ev-three-up .ev-cell{background:#f4efe8}.book-gallery-page .ev-three-up .ev-cell img{padding:12px}.book-gallery-page .gallery-filter{gap:14px 24px;margin:12px 0 18px}.book-gallery-page #gallery-result-count{margin-left:auto}.book-gallery-page .painting-list-row{grid-template-columns:72px minmax(0,1fr) 190px 250px}.book-gallery-page .painting-list-price{font-size:.85rem}.book-gallery-page .gallery-sort select{font-size:.9rem}.book-gallery-page .painting-list a:focus-visible,.book-gallery-page .gallery-filter select:focus-visible,.book-gallery-page .gallery-filter input:focus-visible{outline:3px solid #bc5034;outline-offset:4px}@media(max-width:900px){.book-gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.book-gallery-page .painting-list-row{grid-template-columns:64px minmax(0,1fr) 190px}.book-gallery-page .painting-list-price{grid-column:2/4;text-align:left}}@media(max-width:640px){.book-gallery-grid{grid-template-columns:1fr;gap:30px}.book-gallery-card img{height:330px}.book-gallery-page .gallery-sort{flex-basis:100%}.book-gallery-page .gallery-sort select{flex:1;min-width:0}.book-gallery-page #gallery-result-count{margin-left:0}.book-gallery-page .painting-list-row{grid-template-columns:64px minmax(0,1fr);gap:5px 16px}.book-gallery-page .painting-list-row .gallery-product-image{grid-row:1/4;width:64px;height:76px}.book-gallery-page .painting-list-row h3,.book-gallery-page .painting-list-dimensions,.book-gallery-page .painting-list-price{grid-column:2}.book-gallery-page .painting-list-price{text-align:left}}
</style>
