---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const {title,description}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Vermillion Aurora</title><meta name="description" content={description}/><link rel="canonical" href={`https://vermillionaurora.com${Astro.url.pathname}`}/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"/><link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/site-header.css"/></head><body><div class="page-shell"><SiteHeader/><main class="container book-gallery-main"><slot/></main><SiteFooter/></div><script is:inline src="/exhibitions/exhibitions.js" defer></script></body></html>
<style is:global>
.book-gallery-main{padding-top:35px;padding-bottom:70px}.book-gallery-main h1{font-family:'Cormorant Garamond',serif;font-size:clamp(2.6rem,5vw,4rem);margin:12px 0}.book-gallery-intro{max-width:780px;margin-bottom:35px}.book-gallery-intro p{line-height:1.65}.book-gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 24px;padding:0;list-style:none}.book-gallery-card{min-width:0}.book-gallery-card>a{text-decoration:none;color:inherit}.book-gallery-card img{width:100%;height:310px;object-fit:contain;background:#f4efe8;border-radius:4px;display:block}.book-gallery-card h2,.book-gallery-card h3{font-family:'Cormorant Garamond',serif;font-size:1.6rem;margin:14px 0 7px}.book-gallery-card p{font-size:.9rem;line-height:1.5;margin:5px 0;color:#665b52}.book-gallery-card .print-available{color:#a34528;font-weight:600}.book-gallery-links{display:flex;gap:18px;flex-wrap:wrap;margin-top:20px}.book-gallery-card a:focus-visible{outline:3px solid #bc5034;outline-offset:5px}.book-group-heading{margin-top:45px;font-size:2.3rem}@media(max-width:900px){.book-gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:540px){.book-gallery-grid{grid-template-columns:1fr;gap:30px}.book-gallery-card img{height:330px}}
.book-art-carousel .ex-slide{flex:0 0 min(560px,76vw)}.book-art-carousel .ex-slide>a{display:flex;flex-direction:column}.book-art-carousel .book-art-image{width:100%;height:clamp(300px,58vh,620px);aspect-ratio:auto;object-fit:contain;padding:12px;background:#f4efe8}.book-art-carousel .product-info{min-height:142px}.book-art-carousel .ex-slide-caption h3{font-size:1.7rem}.book-art-carousel .book-art-measurements{font-size:.9rem;font-weight:400;color:#665b52}.book-art-carousel .print-available{color:#a34528}.book-gallery-intro .book-gallery-print-total{font-weight:600;color:#a34528}
</style>
