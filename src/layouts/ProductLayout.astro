---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { catalogVersion, urlFor } from '../../catalog/catalog.mjs';
import { socialImage, withoutPrices } from '../data/social-image.mjs';
import { studio } from '../data/structured-data.mjs';
import bookProductsData from '../../catalog/book-products.json';
const bookProductList = Array.isArray(bookProductsData) ? bookProductsData : bookProductsData.products || [];
const { product, metaDescription } = Astro.props;
const canonical = new URL(urlFor(product), Astro.site || 'https://tjm.art').href;
const shareTitle = `${product.title} — ${product.artist || product.author || 'TJ Murphy'}`;
const featuredArtist = product.artist && product.artist !== 'TJ Murphy' ? product.artist : null;
const bookPage = product.bookGallery && !/\bpage \d/i.test(product.title) && product.bookSources?.[0]?.pages?.[0];
// several works can share a title and a page: number them so every page title is unique
const samePage = bookPage ? bookProductList.filter(b => b.title === product.title && b.bookSources?.[0]?.pages?.[0] === bookPage) : [];
const bookLabel = bookPage ? `, page ${bookPage}${samePage.length > 1 ? ` (${samePage.findIndex(b => b.slug === product.slug) + 1} of ${samePage.length})` : ''}` : '';
const pageTitle = featuredArtist
  ? `${product.title} by ${featuredArtist} | TJM.art`
  : `${product.title}${bookLabel}${product.bookGallery ? ' — Book gallery artwork' : ''} | TJ Murphy`;
const shareDescription = metaDescription || product.description || product.story?.join(' ').slice(0, 180) || shareTitle;
const socialDescription = withoutPrices(shareDescription) || shareTitle;
const shareImage = socialImage(product);
const shareImageAlt = product.image?.alt || shareTitle;
const structuredData = product.type === 'painting'
  ? { '@context':'https://schema.org', '@type':'VisualArtwork', name:product.title,
      creator:(product.artist||'TJ Murphy')==='TJ Murphy'?{'@type':'Person','@id':'https://tjm.art/#tj-murphy',name:'TJ Murphy'}:{'@type':'Person',name:product.artist},
      ...(product.medium?{artMedium:product.medium}:{}), ...(product.surface?{artworkSurface:product.surface}:{}), image:new URL(product.image.src, Astro.site).href, description:metaDescription||product.description, url:canonical,
      ...(product.year?{dateCreated:String(product.year)}:{}),
      copyrightHolder: product.artist && product.artist !== 'TJ Murphy' ? { '@type':'Person', name:product.artist } : studio,
      ...(product.dimensions?.width&&product.dimensions?.height?{width:{'@type':'Distance',name:`${product.dimensions.width} ${product.dimensions.unit||'in'}`},height:{'@type':'Distance',name:`${product.dimensions.height} ${product.dimensions.unit||'in'}`}}:{}),
      ...(product.listing?.price?.amount&&product.listing.status!=='not-for-sale'?{offers:{'@type':'Offer',price:product.listing.price.amount,priceCurrency:product.listing.price.currency||'USD',url:canonical,
        availability:product.listing.status==='available'?'https://schema.org/InStock':product.listing.status==='sold'?'https://schema.org/SoldOut':'https://schema.org/LimitedAvailability',
        seller:studio}}:{}) }
  : product.type === 'book'
    ? { '@context':'https://schema.org', '@type':'Book', name:product.title, author:{'@type':'Person',name:product.author||'TJ Murphy'}, image:new URL(product.image.src, Astro.site).href, description:product.description||product.story?.join(' ') } : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={shareDescription} />
  <meta name="catalog-version" content={catalogVersion} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={socialDescription} />
  <meta property="og:url" content={canonical} />
  {shareImage && <><meta property="og:image" content={shareImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={shareImageAlt} /></>}
  <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={shareTitle} />
  <meta name="twitter:description" content={socialDescription} />
  {shareImage && <><meta name="twitter:image" content={shareImage} /><meta name="twitter:image:alt" content={shareImageAlt} /></>}
  {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')} />}
  <link href="/fonts/fonts.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" /><link rel="stylesheet" href="/site-header.css" />
  <link rel="stylesheet" href="/gallery/painting-details.css" />
  {product.type==='painting' && <link rel="stylesheet" href="/payments/cart.css" />}
  {product.type==='painting' && <script is:inline>
    // Rapid onward navigation may cancel a pending native image transition.
    const finishPaintingTransition=()=>{
      const style=document.createElement('style');style.textContent='@view-transition{navigation:none}';document.head.append(style);
    };
    for(const name of ['pageswap','pagereveal'])addEventListener(name,event=>{
      const transition=event.viewTransition;
      if(name==='pagereveal'){
        if(transition)transition.finished.then(finishPaintingTransition,finishPaintingTransition);
        else finishPaintingTransition();
      }
      if(!transition)return;
      for(const promise of [transition.ready,transition.finished,transition.updateCallbackDone])promise.catch(error=>{if(error.name!=='AbortError')throw error;});
    });
    document.addEventListener('click',event=>{if(event.target.closest('a[href],button'))finishPaintingTransition();},{capture:true});
  </script>}
  {product.type==='painting' && <style is:global>
    @view-transition{navigation:auto}
    .painting-image-trigger>img{view-transition-name:wall-painting}
    ::view-transition-group(wall-painting){animation-duration:.48s;animation-timing-function:cubic-bezier(.22,1,.36,1)}
    ::view-transition-old(root),::view-transition-new(root){animation-duration:.3s}
    @media(prefers-reduced-motion:reduce){::view-transition-group(*){animation-duration:.01ms!important}}
  </style>}
  {product.type==='book' && <><link rel="stylesheet" href="/book-viewer/product.css" /><link rel="stylesheet" href="/book-viewer/viewer.css" /></>}
  {product.examples?.length>0 && <link rel="stylesheet" href="/exhibitions/viewer.css" />}
  <style is:global>.commission-gallery{margin-top:28px}.commission-gallery .section-heading{margin-bottom:12px}.commission-gallery h2{font-size:2rem;margin:0 0 6px}.commission-gallery .section-heading p{font-size:.9rem;margin:0}</style>
</head>
<body><div class="page-shell"><SiteHeader /><a class="back-to-dungeon" href="/play/?resume=1" hidden>← Back to the Dungeon</a><script is:inline>(()=>{let p=0;try{p=new URLSearchParams(location.search).get('from')==='play'||!!sessionStorage.getItem('tjmPlayState')}catch(e){}if(p)document.querySelector('.back-to-dungeon').hidden=false})()</script><style>.back-to-dungeon{position:fixed;left:12px;bottom:max(12px,env(safe-area-inset-bottom));z-index:50;padding:8px 12px;border-radius:4px;background:#2b1d12;color:#ffcf6a;font:600 13px/1 Arial,sans-serif;text-decoration:none;box-shadow:0 2px 8px #0005}.back-to-dungeon[hidden]{display:none}</style><div id="main-content" tabindex="-1"><slot /></div><SiteFooter /></div>
{product.type==='painting' && <><script is:inline src="/payments/cart.js" defer></script><script is:inline src="/catalog/availability.js" defer></script></>}
{product.type==='book' && <script is:inline src="/book-viewer/viewer.js" defer></script>}
{product.examples?.length>0 && <script is:inline src="/exhibitions/viewer.js" defer></script>}
</body></html>
