{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vermillion-commissions",
  "main": "commission-worker.js",
  "compatibility_date": "2026-09-25",
  "keep_vars": true,
  "vars": {
    "PAYPAL_IPN_ENABLED": "true",
    "PAYPAL_CHECKOUT_ENABLED": "false",
    "PAYPAL_MODE": "live",
    "PAYPAL_CHECKOUT_SLUGS": "painting-portrait-in-green",
    "SHIPPO_AUTO_LABEL_ENABLED": "true",
    "SHIPPO_CARRIER_ALLOWLIST": "UPS",
    "CHECKOUT_RELEASE": "insured-pilot-v1"
  },
  "durable_objects": {
    "bindings": [{ "name": "PAINTING_STOCK", "class_name": "PaintingStock" }]
  },
  "migrations": [{ "tag": "painting-stock-v1", "new_sqlite_classes": ["PaintingStock"] }],
  "r2_buckets": [
    {
      "binding": "COMMISSION_UPLOADS",
      "bucket_name": "vermillion-commission-uploads"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
