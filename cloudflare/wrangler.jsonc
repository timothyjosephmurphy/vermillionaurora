{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vermillion-commissions",
  "main": "commission-worker.js",
  "compatibility_date": "2026-09-25",
  "keep_vars": true,
  "vars": {
    "PAYPAL_IPN_ENABLED": "true",
    "PAYPAL_CHECKOUT_ENABLED": "true",
    "PAYPAL_MODE": "live",
    "SQUARE_CHECKOUT_ENABLED": "true",
    "SQUARE_CHECKOUT_ALL": "true",
    "SQUARE_MODE": "live",
    "SQUARE_WEBHOOK_URL": "https://vermillion-commissions.timothyjosephmurphy.workers.dev/checkout/square/webhook",
    "PAYPAL_CHECKOUT_SLUGS": "el-zonte-at-sunrise,honeybadger-and-cub-with-genesis-block,painting-chef-in-white,painting-clouds-over-water,painting-emergence,painting-insect-garden,painting-moonlit-water,painting-portrait-in-gold,painting-portrait-in-green,painting-portrait-with-cheese,painting-red-horizon,painting-shoreline-at-dusk,painting-studio-figure,painting-twin-dragons,paul-murphy-painting-1,paul-murphy-painting-11,paul-murphy-painting-14,paul-murphy-painting-15,paul-murphy-painting-2,paul-murphy-painting-23,paul-murphy-painting-24,paul-murphy-painting-25,paul-murphy-painting-27,paul-murphy-painting-28,paul-murphy-painting-3,paul-murphy-painting-34,paul-murphy-painting-35,paul-murphy-painting-38,paul-murphy-painting-39,paul-murphy-painting-40,paul-murphy-painting-41,paul-murphy-painting-43,paul-murphy-painting-44,paul-murphy-painting-45,paul-murphy-painting-51,paul-murphy-painting-56,paul-murphy-painting-57,paul-murphy-painting-6,paul-murphy-painting-62,paul-murphy-painting-63,paul-murphy-painting-64,paul-murphy-painting-65,paul-murphy-painting-7,paul-murphy-painting-72,paul-murphy-painting-73,paul-murphy-painting-74,paul-murphy-painting-8,paul-murphy-painting-82,paul-murphy-painting-83,paul-murphy-painting-84,paul-murphy-painting-85,warszawska-syrenka",
    "SHIPPO_AUTO_LABEL_ENABLED": "true",
    "SHIPPO_CARRIER_ALLOWLIST": "UPS",
    "CHECKOUT_PILOT_ENABLED": "false",
    "BTCPAY_URL": "https://btcpay884215.lndyn.com",
    "BTCPAY_CHECKOUT_SLUGS": "painting-portrait-in-green,painting-portrait-in-gold",
    "CART_CHECKOUT_ENABLED": "true",
    "COMMISSION_DEPOSITS_ENABLED": "false",
    "PRINT_CHECKOUT_ENABLED": "true",
    "PRINT_CHECKOUT_IDS": "print-painting-portrait-in-gold-full,print-painting-portrait-in-gold-full-frame-black,print-painting-portrait-in-gold-full-frame-white,print-painting-portrait-in-gold-full-frame-natural,print-painting-portrait-in-gold-medium,print-painting-portrait-in-gold-medium-frame-black,print-painting-portrait-in-gold-medium-frame-white,print-painting-portrait-in-gold-medium-frame-natural,print-painting-portrait-in-gold-small,print-painting-portrait-in-gold-small-frame-black,print-painting-portrait-in-gold-small-frame-white,print-painting-portrait-in-gold-small-frame-natural,print-painting-portrait-in-green-full,print-painting-portrait-in-green-full-frame-black,print-painting-portrait-in-green-full-frame-white,print-painting-portrait-in-green-full-frame-natural,print-painting-portrait-in-green-medium,print-painting-portrait-in-green-medium-frame-black,print-painting-portrait-in-green-medium-frame-white,print-painting-portrait-in-green-medium-frame-natural,print-painting-portrait-in-green-small,print-painting-portrait-in-green-small-frame-black,print-painting-portrait-in-green-small-frame-white,print-painting-portrait-in-green-small-frame-natural",
    "PRINT_PROVIDER": "finerworks",
    "FINERWORKS_ORDER_ENABLED": "true",
    "LIVE_PRINT_SAMPLE_ENABLED": "true",
    "PRINT_CHECKOUT_ALL": "true",
    "BTCPAY_CHECKOUT_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAINTING_STOCK",
        "class_name": "PaintingStock"
      },
      {
        "name": "SALES_LEDGER",
        "class_name": "SalesLedger"
      },
      {
        "name": "BITCOIN_ORDERS",
        "class_name": "BitcoinOrder"
      },
      {
        "name": "CART_ORDERS",
        "class_name": "CartOrder"
      }
    ]
  },
  "migrations": [
    {
      "tag": "painting-stock-v1",
      "new_sqlite_classes": [
        "PaintingStock"
      ]
    },
    {
      "tag": "sales-ledger-v1",
      "new_sqlite_classes": [
        "SalesLedger"
      ]
    },
    {
      "tag": "bitcoin-orders-v1",
      "new_sqlite_classes": [
        "BitcoinOrder"
      ]
    },
    {
      "tag": "cart-orders-v1",
      "new_sqlite_classes": [
        "CartOrder"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "COMMISSION_UPLOADS",
      "bucket_name": "vermillion-commission-uploads"
    },
    {
      "binding": "SALES_ARCHIVE",
      "bucket_name": "vermillion-sales-records"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
