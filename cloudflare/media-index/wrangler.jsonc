{
  "name": "vermillionaurora-media-index",
  "main": "worker.mjs",
  "account_id": "3c1fddf0f4f4fc9c84594757d2e1bda0",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "images" }],
  "vars": { "PUBLIC_BASE_URL": "https://media.vermillionaurora.com" }
}
