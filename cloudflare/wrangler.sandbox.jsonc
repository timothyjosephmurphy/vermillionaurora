{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vermillion-checkout-sandbox",
  "main": "checkout-sandbox.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "CHECKOUT_MODE": "sandbox",
    "PRINTFUL_STICKERS_MODE": "draft",
    "SQUARE_CHECKOUT_ENABLED": "true",
    "SQUARE_MODE": "sandbox",
    "SQUARE_SANDBOX_NO_FULFILLMENT": "true",
    "SQUARE_CHECKOUT_SLUGS": "painting-portrait-in-green",
    "SQUARE_CHECKOUT_ALL": "true",
    "SQUARE_WEBHOOK_URL": "https://vermillion-checkout-sandbox.timothyjosephmurphy.workers.dev/checkout/square/webhook",
    "SHIPPO_AUTO_LABEL_ENABLED": "true",
    "SHIPPO_CARRIER_ALLOWLIST": "UPS",
    "CART_CHECKOUT_ENABLED": "true",
    "COMMISSION_DEPOSITS_ENABLED": "true",
    "PRINT_CHECKOUT_ENABLED": "true",
    "FINERWORKS_ORDER_ENABLED": "true",
    "PRINT_PROVIDER": "finerworks",
    "PRODIGI_ENV": "sandbox",
    "PRINT_CHECKOUT_IDS": "",
    "SANDBOX_RETURN_ORIGIN": "https://vermillion-checkout-sandbox.timothyjosephmurphy.workers.dev",
    "PRINT_CHECKOUT_ALL": "true",
    "QBO_ENVIRONMENT": "sandbox",
    "QBO_SYNC_ENABLED": "false",
    "QBO_COST_SYNC_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAINTING_STOCK",
        "class_name": "PaintingStock"
      },
      {
        "name": "SHIPPING_CHECK",
        "class_name": "ShippingCheck"
      },
      {
        "name": "SALES_LEDGER",
        "class_name": "SalesLedger"
      },
      {
        "name": "BITCOIN_ORDERS",
        "class_name": "BitcoinOrder"
      },
      {
        "name": "CART_ORDERS",
        "class_name": "CartOrder"
      },
      {
        "name": "QUICKBOOKS",
        "class_name": "QuickbooksSync"
      }
    ]
  },
  "migrations": [
    {
      "tag": "painting-stock-sandbox-v1",
      "new_sqlite_classes": [
        "PaintingStock"
      ]
    },
    {
      "tag": "shipping-check-v1",
      "new_sqlite_classes": [
        "ShippingCheck"
      ]
    },
    {
      "tag": "sales-ledger-v1",
      "new_sqlite_classes": [
        "SalesLedger"
      ]
    },
    {
      "tag": "bitcoin-orders-v1",
      "new_sqlite_classes": [
        "BitcoinOrder"
      ]
    },
    {
      "tag": "cart-orders-v1",
      "new_sqlite_classes": [
        "CartOrder"
      ]
    },
    {
      "tag": "quickbooks-sync-v1",
      "new_sqlite_classes": [
        "QuickbooksSync"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "SALES_ARCHIVE",
      "bucket_name": "test-sales-records"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
