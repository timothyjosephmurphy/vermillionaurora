    "SANDBOX_RETURN_ORIGIN": "https://vermillion-checkout-sandbox.timothyjosephmurphy.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAINTING_STOCK",
        "class_name": "PaintingStock"
      },
      {
        "name": "SHIPPING_CHECK",
        "class_name": "ShippingCheck"
      },
      {
        "name": "SALES_LEDGER",
        "class_name": "SalesLedger"
      },
      {
        "name": "BITCOIN_ORDERS",
        "class_name": "BitcoinOrder"
      },
      {
        "name": "CART_ORDERS",
        "class_name": "CartOrder"
      }
    ]
  },
  "migrations": [
    {
      "tag": "painting-stock-sandbox-v1",
      "new_sqlite_classes": [
        "PaintingStock"
      ]
    },
    {
      "tag": "shipping-check-v1",
      "new_sqlite_classes": [
        "ShippingCheck"
      ]
    },
    {
      "tag": "sales-ledger-v1",
      "new_sqlite_classes": [
        "SalesLedger"
      ]
    },
    {
      "tag": "bitcoin-orders-v1",
      "new_sqlite_classes": [
        "BitcoinOrder"
      ]
    },
    {
      "tag": "cart-orders-v1",
      "new_sqlite_classes": [
        "CartOrder"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "SALES_ARCHIVE",
      "bucket_name": "test-sales-records"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
