{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vermillionaurora",
  "compatibility_date": "2026-09-29",
  "main": "worker/site.mjs",
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/quickbooks/connect", "/quickbooks/callback", "/quickbooks/start", "/quickbooks/status", "/quickbooks/preflight", "/quickbooks/disconnect", "/quickbooks/sync", "/quickbooks/logs", "/quickbooks/retry", "/quickbooks/costs/preview", "/quickbooks/costs/backfill", "/testimonials/api/*", "/inventory/originals", "/checkout/cart/*", "/shop", "/shop/", "/store", "/store/", "/checkout", "/checkout/", "/.well-known/apple-developer-merchantid-domain-association", "/", "/products/*", "/gallery", "/gallery/*", "/catalog/products.json", "/catalog-admin", "/catalog-admin/*"], "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "d1_databases": [{ "binding": "CATALOG_DB", "database_name": "tjm-catalog", "database_id": "e7514ceb-a633-4613-9cf1-cda817d8ca94" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "tjm-images" }],
  "services": [{ "binding": "CHECKOUT", "service": "vermillion-commissions" }],
  "vars": { "PRIMARY_HOST": "tjm.art", "LEGACY_REDIRECT": "true" }
}
