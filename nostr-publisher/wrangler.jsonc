{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vermillion-nostr-publisher",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-03",
  "vars": {
    "NOSTR_PUBLISH_ENABLED": "false",
    "NOSTR_RELAYS": "wss://relay.damus.io,wss://nos.lol,wss://nostr.bitcoiner.social"
  },
  "durable_objects": {
    "bindings": [
      { "name": "NOSTR_SCHEDULE", "class_name": "NostrSchedule" }
    ]
  },
  "migrations": [
    { "tag": "nostr-schedule-v1", "new_sqlite_classes": ["NostrSchedule"] }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
