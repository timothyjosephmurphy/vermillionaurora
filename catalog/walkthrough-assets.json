  "murals": [
    {
      "id": "friends-club-mural",
      "title": "Friends Club",
      "place": "Lillooet, British Columbia · 2026",
      "size": {
        "width": 480,
        "height": 108,
        "unit": "in"
      },
      "sizeLabel": "40 × 9 ft shipping-container mural",
      "href": "/murals/#friends-story",
      "image": {
        "src": "/walkthrough/friends-club-mural-8e471cb081.webp",
        "width": 882,
        "height": 196
      },
      "story": [
        {
          "title": "An invitation, and a little trust",
          "text": "An exercise in trusting in the process and serendipity."
        },
        {
          "title": "The design concept",
          "text": "I set up an ideation board, and Kara, Paul, and I brainstormed. I took their Higher Education branding kit and extracted a color palette and a set of themes. We discussed the principles of their organization, seeking to incorporate some of the messaging symbolically into the design, and we iterated."
        },
        {
          "title": "Day one · Preparing the sea-can",
          "text": "On the May long weekend, I ventured to Lillooet with an intrepid crew of builders: stopping at the Ark in Vancouver to load cylinders and triangles, stopping in Whistler to jam and sleep, and wending over the passes and between charging stations toward the remote mountain valley."
        }
      ]
    }
  ],
  "gardenStory": [
    {
      "title": "A favorite view",
      "text": "Brian and Marcos sent me reference photographs of sunset over Puget Sound, with the Olympic Mountains behind it. This is one of their favorite views—a scene that captures the essence of Seattle for them. They wanted to bring it into their garden as a mural painted on a board and hung from their fence."
    },
    {
      "title": "The watercolor prototype",
      "text": "Before starting the acrylic mural, I painted a watercolor prototype to explore the composition. A cormorant spreads its wings on a pier pile in the foreground, as if presiding over the sunset. Two distant sailboats meet the waterline, beneath the layered mountains of the Olympics."
    },
    {
      "title": "The garden becomes part of the painting",
      "text": "The plants in the garden are part of the composition. As the grasses beneath the board fill in, they will suggest dunes leading into the painted shore."
    }
  ]
}
